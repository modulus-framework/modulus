<Project>

  <!-- ════════════════════════════════════════════════════════════════
       Modulus Framework — root Directory.Build.props

       This file is deliberately thin: all real configuration lives in
       the build/ directory so it can be reused and composed.
           build/Modulus.Common.props    — compilation, usings, analyzers
           build/Modulus.Packaging.props  — NuGet metadata, Source Link
           build/Modulus.Test.props       — test-project overrides
       ════════════════════════════════════════════════════════════════ -->

  <Import Project="$(MSBuildThisFileDirectory)build\Modulus.Common.props"   />
  <Import Project="$(MSBuildThisFileDirectory)build\Modulus.Packaging.props" />

</Project>
