{
  "title": "Modulus.Messaging",
  "uid": "modulus-messaging",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "modulus",
    "messaging"
  ],
  "timezone": "browser",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Metrics"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Consumed per second",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (messaging_destination_name) (rate(messaging_client_consumed_messages_total[5m]))",
          "legendFormat": "{{messaging_destination_name}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Sent per second",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (messaging_destination_name) (rate(messaging_client_sent_messages_total[5m]))",
          "legendFormat": "{{messaging_destination_name}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Parked per 5 minutes",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (messaging_destination_name) (increase(messaging_parked_messages_total[5m]))",
          "legendFormat": "{{messaging_destination_name}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Consume time p95",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, messaging_destination_name) (rate(messaging_process_duration_seconds_bucket[5m])))",
          "legendFormat": "{{messaging_destination_name}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Inbox duplicates per second",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(messaging_inbox_duplicates_total[5m]))",
          "legendFormat": "duplicates"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Queue depth (PostgreSQL transport)",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (queue) (modulus_messaging_queue_depth)",
          "legendFormat": "{{queue}}"
        }
      ]
    }
  ]
}
