<Project>

  <!-- ════════════════════════════════════════════════════════════════
       cli/Directory.Build.props

       Chains to the root Directory.Build.props, then wires in
       build/Modulus.PublicApi.props (PublicAPI.Shipped/Unshipped
       tracking) — the CLI is packed as a dotnet tool (PackAsTool, set
       in Modulus.Cli.csproj) and ships a public API contract of its
       own, same as every src/ framework library.
       ════════════════════════════════════════════════════════════════ -->

  <Import Project="$(MSBuildThisFileDirectory)..\Directory.Build.props" />
  <Import Project="$(MSBuildThisFileDirectory)..\build\Modulus.PublicApi.props" />

</Project>
