<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>modulus</ToolCommandName>
    <PackageId>Modulus.Cli</PackageId>
    <Description>
      Command-line interface for the Modulus framework.
      Scaffold modular-monolith applications, add modules, and generate CRUD code.
    </Description>
    <PackageTags>modulus;cli;scaffolding;code-generation</PackageTags>
    <!-- CLI is a dev-only tool; Scriban vulnerabilities don't affect generated apps -->
    <NoWarn>$(NoWarn);NU1903;NU1902;NU1904;NU1603</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console.Cli" />
    <PackageReference Include="Scriban" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Templates\**\*.sbn" />
  </ItemGroup>

</Project>
