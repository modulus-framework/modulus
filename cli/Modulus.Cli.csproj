<!-- TreatAsLocalProperty: the framework release builds the solution with a global -p:Version=<tag>; these lines win over it. -->
<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="VersionPrefix;VersionSuffix;Version;PackageVersion;AssemblyVersion;FileVersion">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PackAsTool>true</PackAsTool>
    <!-- The CLI ships on its own version: its changes do not republish the framework packages. This is the one place to change it;
         it is released with a cli-v<version> tag (.github/workflows/release-cli.yml). -->
    <VersionPrefix>4.0.0</VersionPrefix>
    <VersionSuffix></VersionSuffix>
    <Version>$(VersionPrefix)</Version>
    <PackageVersion>$(Version)</PackageVersion>
    <AssemblyVersion>$(VersionPrefix).0</AssemblyVersion>
    <FileVersion>$(VersionPrefix).0</FileVersion>
    <ToolCommandName>modulus</ToolCommandName>
    <PackageId>Synvro.Modulus.Cli</PackageId>
    <Description>Command-line tool to scaffold Modulus apps, modules and CRUD code.</Description>
    <PackageTags>synvro;modulus;cli;scaffolding;code-generation</PackageTags>
    <NoWarn>$(NoWarn);NU1603;VSTHRD002;VSTHRD103</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console.Cli" />
    <PackageReference Include="Scriban" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Templates\**\*.sbn" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Modulus.Cli.Tests" />
  </ItemGroup>

</Project>
