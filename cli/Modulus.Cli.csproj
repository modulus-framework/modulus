<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PackAsTool>true</PackAsTool>
    <!-- The CLI ships on its own version: its changes do not republish the framework packages. -->
    <VersionPrefix>1.5.4</VersionPrefix>
    <Version>1.5.4</Version>
    <PackageVersion>1.5.4</PackageVersion>
    <ToolCommandName>modulus</ToolCommandName>
    <PackageId>Synvro.Modulus.Cli</PackageId>
    <Description>
      Command-line interface for the Modulus framework.
      Scaffold modular-monolith applications, add modules, and generate CRUD code.
    </Description>
    <PackageTags>synvro;modulus;cli;scaffolding;code-generation</PackageTags>
    <NoWarn>$(NoWarn);NU1603;VSTHRD002;VSTHRD103</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console.Cli" />
    <PackageReference Include="Scriban" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Templates\**\*.sbn" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Modulus.Cli.Tests" />
  </ItemGroup>

</Project>
