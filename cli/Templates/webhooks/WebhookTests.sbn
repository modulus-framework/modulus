using System.Net;
using System.Net.Http.Json;
using System.Text.Json;
using FluentAssertions;
using Modulus.Testing;
using Xunit;
using ApiEntryPoint = {{ root_namespace }}.Api.ApiEntryPoint;

namespace {{ root_namespace }}.Tests;

/// <summary>
/// The webhook management API (modulus add-webhooks) on the in-memory test host. Deliveries are
/// not sent here: appsettings.Testing.json turns the delivery worker off.
/// </summary>
public sealed class WebhookTests(ModulusWebAppFactory<ApiEntryPoint> factory)
    : IClassFixture<ModulusWebAppFactory<ApiEntryPoint>>
{
    private static readonly Uri Subscriptions = new("/api/webhooks/subscriptions", UriKind.Relative);

    [Fact]
    public async Task Anonymous_callers_are_rejected()
    {
        var response = await factory.CreateClient().GetAsync(Subscriptions);

        response.StatusCode.Should().Be(HttpStatusCode.Unauthorized);
    }

    [Fact]
    public async Task Callers_without_the_permission_are_forbidden()
    {
        var response = await factory.CreateAuthenticatedClient().GetAsync(Subscriptions);

        response.StatusCode.Should().Be(HttpStatusCode.Forbidden);
    }

    [Fact]
    public async Task The_exposed_events_are_listed()
    {
        var types = await Manager().GetFromJsonAsync<JsonElement>(new Uri("/api/webhooks/event-types", UriKind.Relative));

        types.EnumerateArray().Select(t => t.GetProperty("name").GetString()).Should().BeEquivalentTo(new string[]
        {
{{ for e in events }}            "{{ e.name }}",
{{ end }}        });
    }

    [Fact]
    public async Task A_subscription_round_trips()
    {
        var client = Manager();

        var created = await client.PostAsJsonAsync(Subscriptions, new { url = "https://hooks.example.com/in", eventTypes = new[] { "*" } });
        created.StatusCode.Should().Be(HttpStatusCode.Created);
        var subscription = await created.Content.ReadFromJsonAsync<JsonElement>();
        subscription.GetProperty("secret").GetString().Should().StartWith("whsec_");
        var location = created.Headers.Location!;

        var test = await client.PostAsync(new Uri(location + "/test", UriKind.Relative), null);
        test.StatusCode.Should().Be(HttpStatusCode.Accepted);
        var deliveries = await client.GetFromJsonAsync<JsonElement>(new Uri(location + "/deliveries", UriKind.Relative));
        deliveries.GetProperty("items").EnumerateArray().Should().ContainSingle(d => d.GetProperty("status").GetString() == "Pending");

        (await client.DeleteAsync(location)).StatusCode.Should().Be(HttpStatusCode.NoContent);
        (await client.GetAsync(location)).StatusCode.Should().Be(HttpStatusCode.NotFound);
    }

    [Fact]
    public async Task An_internal_address_is_refused()
    {
        var response = await Manager().PostAsJsonAsync(Subscriptions, new { url = "https://169.254.169.254/latest", eventTypes = new[] { "*" } });

        response.StatusCode.Should().Be(HttpStatusCode.BadRequest);
    }

    private HttpClient Manager() => factory.CreateAuthenticatedClient({{ if has_admin_role }}roles: ["{{ admin_role }}"]{{ else }}permissions: ["webhooks:manage"]{{ end }});
}
