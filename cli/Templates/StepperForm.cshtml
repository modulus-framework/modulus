    <div class="stepper-progress">
        <div class="stepper-progress-bar" id="progressBar" style="width: 0%;"></div>
    </div>

    <!-- Stepper Component -->
    <div class="stepper stepper-horizontal" id="formStepper">
        <!-- Step indicators will be generated by JavaScript -->
    </div>

    <!-- Step Content -->
    <div class="stepper-content" id="stepContent">
        <!-- Step forms will be displayed here -->
    </div>

    <!-- Navigation Buttons -->
    <div class="stepper-navigation d-flex justify-content-between">
        <button type="button" class="btn btn-secondary" id="previousBtn" disabled>
            <i class="fas fa-chevron-left"></i> Previous
        </button>

        <div class="step-indicator">
            <span id="currentStep">1</span> of <span id="totalSteps">4</span>
        </div>

        <button type="button" class="btn btn-primary" id="nextBtn">
            Next <i class="fas fa-chevron-right"></i>
        </button>

        <button type="submit" class="btn btn-success" id="submitBtn" style="display: none;">
            <i class="fas fa-check"></i> Submit
        </button>
    </div>
</div>

