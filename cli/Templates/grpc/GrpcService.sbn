[Authorize(Policy = "{{ required_permission }}")]
{{ else }}[Authorize]
{{ end }}public sealed class {{ entity_name }}GrpcService(IMediator mediator) : {{ entity_name }}Service.{{ entity_name }}ServiceBase
{
    public override async Task<List{{ entity_plural }}Response> List{{ entity_plural }}(List{{ entity_plural }}Request request, ServerCallContext context)
    {
        var items = await mediator.QueryAsync(request.Page > 0 && request.PageSize > 0
            ? new Get{{ entity_plural }}Query(request.Page, request.PageSize)
            : new Get{{ entity_plural }}Query(Math.Max(1, request.Page)), context.CancellationToken);
        var response = new List{{ entity_plural }}Response();
        response.Items.AddRange(items.Select(i => new {{ entity_name }}Message { Id = i.Id.ToString(), Name = i.Name }));
        return response;
    }

    public override async Task<{{ entity_name }}Message> Get{{ entity_name }}(Get{{ entity_name }}Request request, ServerCallContext context)
    {
        var item = await mediator.QueryAsync(new Get{{ entity_name }}ByIdQuery(ParseId(request.Id)), context.CancellationToken);
        return new {{ entity_name }}Message { Id = item.Id.ToString(), Name = item.Name };
    }

    public override async Task<Create{{ entity_name }}Response> Create{{ entity_name }}(Create{{ entity_name }}Request request, ServerCallContext context)
    {
        var id = await mediator.SendAsync(new Create{{ entity_name }}Command(request.Name), context.CancellationToken);
        return new Create{{ entity_name }}Response { Id = id.ToString() };
