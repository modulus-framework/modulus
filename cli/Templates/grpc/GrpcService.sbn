        return new Empty();
    }

    public override async Task<Empty> Delete{{ entity_name }}(Delete{{ entity_name }}Request request, ServerCallContext context)
    {
        await mediator.SendAsync(new Delete{{ entity_name }}Command(ParseId(request.Id)), context.CancellationToken);
        return new Empty();
    }

