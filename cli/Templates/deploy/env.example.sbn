# Copy to .env and fill in. Never commit .env: it holds secrets (the .gitignore excludes it).

# --- Environment ---------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production

# --- Trusted proxy ------------------------------------------------------------
# The proxy terminates TLS and forwards X-Forwarded-Proto. The token server refuses plain HTTP, so the app must trust the proxy's
# network: the compose network, whose subnet docker-compose.yml pins. Only the proxy is on it (the API port is not published).
ForwardedHeaders__KnownNetworks__0=172.28.0.0/24

# --- Token server (OpenIddict) --------------------------------------------------
# The public address of the API, as clients reach it. It is the token issuer.
Identity__Issuer=https://{{ public_host }}
# Signing and encryption keys: PFX files in deploy/certs (mounted at /app/certs), with their passwords.
Identity__Certificates__Signing__Path=/app/certs/signing.pfx
Identity__Certificates__Signing__Password=
Identity__Certificates__Encryption__Path=/app/certs/encryption.pfx
Identity__Certificates__Encryption__Password=

# --- Passkeys (required in Production for privileged permissions) -------------
Identity__Passkeys__Enabled=true
Identity__Passkeys__RelyingPartyId={{ public_host }}
Identity__Passkeys__Origins__0=https://{{ public_host }}

# --- First administrator -----------------------------------------------------
# An existing account named here receives the platform operator role on every start (added only, never removed).
Identity__Seed__AdminEmail=
Identity__Seed__AdminPassword=
Identity__Seed__PlatformOperatorEmail=

{{ if monitoring }}# --- Monitoring (OpenTelemetry over OTLP) ----------------------------------------
# Metrics go to Prometheus (OTLP over HTTP), traces to Jaeger. Logs stay in the container log.
OpenTelemetry__ServiceName={{ root_namespace }}
OpenTelemetry__Otlp__Metrics__Endpoint=http://prometheus:9090/api/v1/otlp/v1/metrics
OpenTelemetry__Otlp__Metrics__Protocol=http/protobuf
OpenTelemetry__Otlp__Traces__Endpoint=http://jaeger:4318/v1/traces
OpenTelemetry__Otlp__Traces__Protocol=http/protobuf
# The password of the Grafana admin account (compose reads it for the grafana service).
GRAFANA_ADMIN_PASSWORD=

{{ end }}# --- Database ---------------------------------------------------------------
# The SQLite files live in /app/data (the working directory of the container). Leave as is unless you use another database.

# --- Backups (restic, see deploy/README.md) -----------------------------------------
# An S3-compatible repository (s3:https://host/bucket/path) or a local path. RESTIC_PASSWORD encrypts every snapshot; keep a copy
# outside this server. For S3, set the access keys as well.
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6
