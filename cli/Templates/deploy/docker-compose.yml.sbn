# Production stack for {{ root_namespace }}: the API behind a {{ proxy }} reverse proxy with TLS.
# Before the first start: copy .env.example to .env and fill it in, and put the token-server certificates (PFX) in deploy/certs.
# Database: this stack keeps the SQLite files that a generated app uses by default, on the app-data volume. Run one replica.
# For PostgreSQL, set the connection strings in .env and add a database service.
{{ if proxy == "nginx" }}#
# Certificates (Nginx): the proxy needs them before it starts, so issue them once, before the first `up`:
#   docker compose run --rm -p 80:80 certbot certonly --standalone -d {{ public_host }} -m {{ acme_email }} --agree-tos --no-eff-email
# Renewal runs in the certbot service. Nginx picks up renewed certificates after a restart (docker compose restart proxy).
{{ end }}
services:
{{ if proxy == "nginx" }}  proxy:
    image: nginx:stable-alpine
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./deploy/nginx/nginx.conf:/etc/nginx/conf.d/default.conf:ro
      - certbot-www:/var/www/certbot:ro
      - letsencrypt:/etc/letsencrypt:ro
    depends_on:
      - api

  certbot:
    image: certbot/certbot
    restart: unless-stopped
    entrypoint: /bin/sh -c 'trap exit TERM; while :; do certbot renew --webroot -w /var/www/certbot --quiet; sleep 12h & wait $${!}; done'
    volumes:
      - certbot-www:/var/www/certbot
      - letsencrypt:/etc/letsencrypt
{{ else }}  proxy:
    image: traefik:v3
    restart: unless-stopped
    command:
      - --configFile=/etc/traefik/traefik.yml
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./deploy/traefik/traefik.yml:/etc/traefik/traefik.yml:ro
      - ./deploy/traefik/dynamic.yml:/etc/traefik/dynamic.yml:ro
      - letsencrypt:/letsencrypt
    depends_on:
      - api
{{ end }}
  api:
    build: .
    restart: unless-stopped
    env_file: .env
    volumes:
      - app-data:/app/data
      - ./deploy/certs:/app/certs:ro
    expose:
      - "8080"
    stop_grace_period: 30s
{{ if monitoring }}
  # Monitoring. The app pushes its metrics to Prometheus and its traces to Jaeger over OTLP (see OpenTelemetry__ in .env).
  # Only Grafana is published, and only on localhost: reach it through an SSH tunnel (ssh -L 3000:localhost:3000 host).
  prometheus:
    image: prom/prometheus:v3
    restart: unless-stopped
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --web.enable-otlp-receiver
      - --storage.tsdb.retention.time=15d
    volumes:
      - ./deploy/monitoring/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - prometheus-data:/prometheus
    expose:
      - "9090"

  jaeger:
    image: jaegertracing/all-in-one:1
    restart: unless-stopped
    environment:
      - COLLECTOR_OTLP_ENABLED=true
    expose:
      - "4318"
      - "16686"

  grafana:
    image: grafana/grafana-oss:11.6.0
    restart: unless-stopped
    environment:
      - GF_SECURITY_ADMIN_PASSWORD=${GRAFANA_ADMIN_PASSWORD:?set GRAFANA_ADMIN_PASSWORD in .env}
      - GF_USERS_ALLOW_SIGN_UP=false
    ports:
      - "127.0.0.1:3000:3000"
    volumes:
      - ./deploy/monitoring/grafana/datasources.yml:/etc/grafana/provisioning/datasources/datasources.yml:ro
      - grafana-data:/var/lib/grafana
    depends_on:
      - prometheus
      - jaeger
{{ end }}
  # Backups: every BACKUP_INTERVAL_SECONDS (default daily) a consistent copy of the SQLite databases and the other app files is
  # written to RESTIC_REPOSITORY (S3-compatible or a local path), encrypted with RESTIC_PASSWORD. See deploy/README.md.
  backup:
    image: alpine:3.20
    restart: unless-stopped
    env_file: .env
    command: ["sh", "-c", "apk add --no-cache restic sqlite >/dev/null && sh /backup/backup.sh"]
    volumes:
      # Read-write on purpose: SQLite needs to write its WAL index (-shm) to read a database in WAL mode. The script only reads the data.
      - app-data:/data
      - ./deploy/backup:/backup:ro

  # Restore, on demand only (the profile keeps it out of `up`). Stop the API first; see deploy/README.md.
  restore:
    image: alpine:3.20
    profiles: ["restore"]
    env_file: .env
    command: ["sh", "-c", "apk add --no-cache restic >/dev/null && sh /backup/restore.sh"]
    volumes:
      - app-data:/data
      - ./deploy/backup:/backup:ro

# A fixed subnet: the app trusts the proxy's forwarded headers from this network only (ForwardedHeaders__KnownNetworks in .env).
networks:
  default:
    ipam:
      config:
        - subnet: 172.28.0.0/24

volumes:
  app-data:
  letsencrypt:
{{ if proxy == "nginx" }}  certbot-www:
{{ end }}{{ if monitoring }}  prometheus-data:
  grafana-data:
{{ end }}