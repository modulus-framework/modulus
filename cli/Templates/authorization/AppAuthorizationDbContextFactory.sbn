using Microsoft.EntityFrameworkCore;
using Microsoft.EntityFrameworkCore.Design;
using Modulus.Authorization.EntityFrameworkCore;
using Modulus.Core.Null;

namespace {{ authorization_namespace }}.Infrastructure;

/// <summary>
/// Design-time factory used by the EF Core tools (<c>dotnet ef</c> / <c>modulus migrate</c>) to construct the authorization
/// store's <see cref="AppAuthorizationDbContext"/> without the application's DI container, with its migrations in this project.
/// </summary>
/// <remarks>
/// The connection string is read from the <c>AUTHORIZATION_CONNECTION</c> environment variable when set (so CI/CD can point
/// migrations at the real database), otherwise it falls back to the default development connection string.
/// </remarks>
public sealed class AppAuthorizationDbContextFactory : IDesignTimeDbContextFactory<AppAuthorizationDbContext>
{
    public AppAuthorizationDbContext CreateDbContext(string[] args)
    {
        var connectionString =
            Environment.GetEnvironmentVariable("AUTHORIZATION_CONNECTION")
            ?? "{{ authorization_connection_string }}";

        var options = new DbContextOptionsBuilder<AppAuthorizationDbContext>()
            .{{ use_db_method }}(connectionString, db => db.MigrationsAssembly(typeof(AppAuthorizationDbContextFactory).Assembly.GetName().Name))
            .Options;

        return new AppAuthorizationDbContext(options, new NullCurrentTenant());
    }
}
