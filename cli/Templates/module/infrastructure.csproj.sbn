<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>{{ target_framework }}</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Synvro.Modulus.Core" Version="{{ framework_version }}" />
    <PackageReference Include="Synvro.Modulus.EntityFrameworkCore" Version="{{ framework_version }}" />
    <PackageReference Include="Synvro.Modulus.Events" Version="{{ framework_version }}" />
    <PackageReference Include="Synvro.Modulus.Data.Abstractions" Version="{{ framework_version }}" />
    <PackageReference Include="{{ ef_provider_package }}" Version="{{ ef_provider_version }}" />
{{ if ai_journal }}    <PackageReference Include="Synvro.Modulus.AI.Connector.EntityFrameworkCore" Version="{{ framework_version }}" />
{{ end }}{{ if db_provider == "SQLite" }}    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
{{ end }}    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="{{ ef_core_version }}" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../{{ module_namespace }}.Application/{{ module_namespace }}.Application.csproj" />
    <ProjectReference Include="../{{ module_namespace }}.Domain/{{ module_namespace }}.Domain.csproj" />
    <ProjectReference Include="../../../Shared/{{ root_namespace }}.Shared.Infrastructure/{{ root_namespace }}.Shared.Infrastructure.csproj" />
  </ItemGroup>

</Project>
