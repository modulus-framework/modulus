using {{ module_namespace }}.Application.Dtos;

namespace {{ module_namespace }}.Presentation;
{{ if required_permission }}
// Every endpoint below needs the "{{ required_permission }}" permission. The Admin role holds it (grant it to other roles in Program.cs or
// through the Permissions UI); a web app's admin page for this entity is guarded by the same one. Change it with Permissions("...")
// or AllowAnonymous() in an endpoint's Configure().
{{ end }}{{ if has_api_extra_fields }}
/// <summary>
/// Extension fields other modules contribute to a {{ entity_name_lower }} (<c>ConfigureEntityUi("{{ module_name }}.{{ entity_name }}", ...)</c>) travel in
/// <c>extraProperties</c>: a name-to-text map (invariant culture, e.g. <c>"25.5"</c>, <c>"true"</c>, <c>"2026-09-20"</c>). The
/// endpoints below never expose the stored bag directly: it goes through <see cref="EntityApiFields"/>, the same registry and
/// per-field permissions as the admin page, so a caller only reads and writes the fields they may see.
/// </summary>
internal static class {{ entity_name }}ExtraProperties
{
    public const string Entity = "{{ module_name }}.{{ entity_name }}";
}
{{ end }}
public sealed class Get{{ entity_plural }}Endpoint(IMediator mediator{{ if has_api_extra_fields }}, IEntityUiRegistry registry, ICurrentUser user{{ end }}) : EndpointWithoutRequest<IReadOnlyList<{{ entity_name }}Dto>>
{
    public override void Configure()
    {
        Get("/api/{{ module_name_lower }}/{{ route_name }}");
        Summary("Get all {{ entity_name_lower }}s");
{{ if required_permission }}        Permissions("{{ required_permission }}");
{{ end }}    }

    protected override async Task HandleAsync(CancellationToken ct)
    {
        var items = await mediator.QueryAsync(new Get{{ entity_plural }}Query(), ct);
{{ if has_api_extra_fields }}        await SendOkAsync(items
            .Select(i => i with { ExtraProperties = registry.VisibleExtraProperties({{ entity_name }}ExtraProperties.Entity, user, i.ExtraProperties) })
            .ToList(), ct);
{{ else }}        await SendOkAsync(items, ct);
{{ end }}    }
}

public sealed class Get{{ entity_name }}ByIdRequest
{
    public Guid Id { get; set; }
}

public sealed class Get{{ entity_name }}ByIdEndpoint(IMediator mediator{{ if has_api_extra_fields }}, IEntityUiRegistry registry, ICurrentUser user{{ end }}) : Endpoint<Get{{ entity_name }}ByIdRequest, {{ entity_name }}Dto>
{
    public override void Configure()
    {
        Get("/api/{{ module_name_lower }}/{{ route_name }}/{id}");
        Summary("Get {{ entity_name_lower }} by ID");
{{ if required_permission }}        Permissions("{{ required_permission }}");
{{ end }}    }

    public override async Task HandleAsync(Get{{ entity_name }}ByIdRequest req, CancellationToken ct)
    {
        var item = await mediator.QueryAsync(new Get{{ entity_name }}ByIdQuery(req.Id), ct);
{{ if has_api_extra_fields }}        await SendOkAsync(
            item with { ExtraProperties = registry.VisibleExtraProperties({{ entity_name }}ExtraProperties.Entity, user, item.ExtraProperties) }, ct);
{{ else }}        await SendOkAsync(item, ct);
{{ end }}    }
}

public sealed class Create{{ entity_name }}Request
{
    public string Name { get; set; } = default!;
{{ if has_api_extra_fields }}
    /// <summary>Values of the extension fields you may set (field name to invariant text). Omit when there are none.</summary>
    public Dictionary<string, string?>? ExtraProperties { get; set; }
{{ end }}}

public sealed class Create{{ entity_name }}Endpoint(IMediator mediator{{ if has_api_extra_fields }}, IEntityUiRegistry registry, ICurrentUser user{{ end }}) : Endpoint<Create{{ entity_name }}Request, Guid>
{
    public override void Configure()
    {
        Post("/api/{{ module_name_lower }}/{{ route_name }}");
        Summary("Create a new {{ entity_name_lower }}");
{{ if required_permission }}        Permissions("{{ required_permission }}");
{{ end }}    }

    public override async Task HandleAsync(Create{{ entity_name }}Request req, CancellationToken ct)
    {
{{ if has_api_extra_fields }}        var errors = registry.ValidateEntityFieldsForApi({{ entity_name }}ExtraProperties.Entity, user, req.ExtraProperties, partial: false);
        if (errors.Count > 0)
            throw new ValidationException(errors);

        var extra = registry.ReadSubmittedEntityFieldText({{ entity_name }}ExtraProperties.Entity, user, req.ExtraProperties);
        var id = await mediator.SendAsync(new Create{{ entity_name }}Command(req.Name, extra), ct);
{{ else }}        var id = await mediator.SendAsync(new Create{{ entity_name }}Command(req.Name), ct);
{{ end }}        await SendCreatedAsync(id, $"/api/{{ module_name_lower }}/{{ route_name }}/{id}", ct);
    }
}

public sealed class Update{{ entity_name }}Request
{
    public Guid Id { get; set; }
    public string Name { get; set; } = default!;
{{ if has_api_extra_fields }}
    /// <summary>
    /// Extension fields to change (field name to invariant text). Fields not listed are left as they are; an empty or null
    /// value clears the field.
