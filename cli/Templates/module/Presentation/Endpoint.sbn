    public Dictionary<string, string?>? ExtraProperties { get; set; }
{{ end }}}

public sealed class Update{{ entity_name }}Endpoint(IMediator mediator{{ if has_api_extra_fields }}, IEntityUiRegistry registry, ICurrentUser user{{ end }}) : Endpoint<Update{{ entity_name }}Request, Update{{ entity_name }}Result>
{
    public override void Configure()
    {
        Put("/api/{{ module_name_lower }}/{{ route_name }}/{id}");
        Summary("Update an existing {{ entity_name_lower }}");
{{ if required_permission }}        Permissions("{{ required_permission }}");
{{ end }}    }

    public override async Task HandleAsync(Update{{ entity_name }}Request req, CancellationToken ct)
    {
{{ if has_api_extra_fields }}        var errors = registry.ValidateEntityFieldsForApi({{ entity_name }}ExtraProperties.Entity, user, req.ExtraProperties, partial: true);
        if (errors.Count > 0)
            throw new ValidationException(errors);

        var extra = registry.ReadSubmittedEntityFieldText({{ entity_name }}ExtraProperties.Entity, user, req.ExtraProperties);
        var result = await mediator.SendAsync(new Update{{ entity_name }}Command(req.Id, req.Name, extra), ct);
{{ else }}        var result = await mediator.SendAsync(new Update{{ entity_name }}Command(req.Id, req.Name), ct);
{{ end }}        await SendOkAsync(result, ct);
    }
}

