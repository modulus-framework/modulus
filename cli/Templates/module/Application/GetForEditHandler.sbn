using Modulus.Mediator.Abstractions;
using Modulus.Core.Abstractions.Exceptions;
using {{ module_namespace }}.Domain;

namespace {{ module_namespace }}.Application;

public sealed class Get{{ entity_name }}ForEditHandler(I{{ entity_name }}Repository repo)
    : IQueryHandler<Get{{ entity_name }}ForEditQuery, {{ entity_name }}EditDto>
{
    public async Task<{{ entity_name }}EditDto> HandleAsync(
        Get{{ entity_name }}ForEditQuery query,
        CancellationToken ct)
    {
        var entity = await repo.GetByIdAsync(query.Id, ct)
            ?? throw new NotFoundException(
                "{{ entity_name }} not found: " + query.Id);

        // A copy, so nothing downstream can mutate the tracked entity's bag.
        return new {{ entity_name }}EditDto(
            entity.Id,
            entity.Name,
            new Dictionary<string, string?>(entity.ExtraProperties));
    }
}
