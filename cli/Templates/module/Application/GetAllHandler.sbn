using Modulus.Authorization.Fields;
using Modulus.Mediator.Abstractions;
using {{ module_namespace }}.Domain;
using {{ module_namespace }}.Application.Dtos;

namespace {{ module_namespace }}.Application;

public sealed class Get{{ entity_plural }}Handler(
    I{{ entity_name }}Repository repo,
    IFieldAuthorizer? fieldAuthorizer = null)
    : IQueryHandler<Get{{ entity_plural }}Query, IReadOnlyList<{{ entity_name }}Dto>>
{
    public async Task<IReadOnlyList<{{ entity_name }}Dto>> HandleAsync(
        Get{{ entity_plural }}Query query,
        CancellationToken ct)
    {
        var size = Math.Clamp(query.PageSize, 1, Get{{ entity_plural }}Query.MaxPageSize);
        var page = Math.Max(1, query.Page);
        var entities = await repo.GetPageAsync((page - 1) * size, size, ct);
        return entities
            .Select(e => Mask(new {{ entity_name }}Dto
            {
                Id = e.Id,
                Name = e.Name,
            }))
            .ToList();
    }

    // Restricted fields are masked for a caller without their read permission (no-op without field security).
    private {{ entity_name }}Dto Mask({{ entity_name }}Dto dto) => fieldAuthorizer?.Redact(dto) ?? dto;
}
