using Modulus.Authorization.Fields;
using Modulus.Core.Abstractions.Common;
using Modulus.Mediator.Abstractions;
using {{ module_namespace }}.Domain;
using {{ module_namespace }}.Application.Dtos;

namespace {{ module_namespace }}.Application;

public sealed class Get{{ entity_plural }}CursorHandler(
    I{{ entity_name }}Repository repo,
    IFieldAuthorizer? fieldAuthorizer = null)
    : IQueryHandler<Get{{ entity_plural }}CursorQuery, KeysetPage<{{ entity_name }}Dto>>
{
    public async Task<KeysetPage<{{ entity_name }}Dto>> HandleAsync(
        Get{{ entity_plural }}CursorQuery query,
        CancellationToken ct)
    {
        var size = Math.Clamp(query.PageSize, 1, Get{{ entity_plural }}CursorQuery.MaxPageSize);

        // A cursor is client input: a malformed one is the caller's error (400), not a server fault.
        KeysetPage<{{ entity_name }}> page;
        try
        {
            page = await repo.GetKeysetPageAsync(query.Cursor, size, ct);
        }
        catch (ArgumentException)
        {
            throw new Modulus.Core.Abstractions.Exceptions.ValidationException(["The cursor is not valid."]);
        }

        // Restricted fields are masked for a caller without their read permission (no-op without field security).
        return page.Map(e => Mask(new {{ entity_name }}Dto
        {
            Id = e.Id,
            Name = e.Name,
        }));
    }

    private {{ entity_name }}Dto Mask({{ entity_name }}Dto dto) => fieldAuthorizer?.Redact(dto) ?? dto;
}
