<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Cobytelabs.Modulus.Core" Version="{{ framework_version }}" />
    <PackageReference Include="Cobytelabs.Modulus.Mediator" Version="{{ framework_version }}" />
    <PackageReference Include="Cobytelabs.Modulus.EntityFrameworkCore" Version="{{ framework_version }}" />
    <PackageReference Include="Cobytelabs.Modulus.Events" Version="{{ framework_version }}" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../{{ module_namespace }}.Domain/{{ module_namespace }}.Domain.csproj" />
    <ProjectReference Include="../../../Shared/{{ root_namespace }}.Shared.Application/{{ root_namespace }}.Shared.Application.csproj" />
  </ItemGroup>

</Project>
