<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Modulus.Core" Version="1.0.0" />
    <PackageReference Include="Modulus.Mediator" Version="1.0.0" />
    <PackageReference Include="Modulus.EntityFrameworkCore" Version="1.0.0" />
    <PackageReference Include="Modulus.Events" Version="1.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../{{ module_namespace }}.Domain/{{ module_namespace }}.Domain.csproj" />
    <ProjectReference Include="../../../Shared/{{ root_namespace }}.Shared.Application/{{ root_namespace }}.Shared.Application.csproj" />
  </ItemGroup>

</Project>
