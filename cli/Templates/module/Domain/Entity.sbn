using Modulus.Core.Abstractions.Domain;
using Modulus.Core.Abstractions.Entities;

namespace {{ module_namespace }}.Domain;

/// <summary>
/// Sample aggregate root. Replace with your domain entity.
/// <para>
/// <see cref="IHasExtraProperties"/> lets other modules add their own fields to this entity's form
/// (<c>services.ConfigureEntityUi("{{ module_name }}.{{ entity_name }}", e => e.Fields.Add(...))</c>); their values are kept
/// in one JSON column, so no schema change is needed per field. Remove the marker (and the column) if this entity
/// should not be extensible.
/// </para>{{ if multi_tenant }}
/// <para>
/// <see cref="IHasTenantId"/> keeps each company's rows apart: the module context stamps the current company on insert,
/// filters every query by it and refuses writes to another company's rows.
/// </para>{{ end }}
/// </summary>
public sealed class {{ entity_name }} : AggregateRoot<Guid>, IHasExtraProperties{{ if multi_tenant }}, IHasTenantId{{ end }}
{
    public string Name { get; set; } = string.Empty;

    /// <inheritdoc />
    public Dictionary<string, string?> ExtraProperties { get; set; } = [];{{ if multi_tenant }}

    /// <inheritdoc />
    public Guid TenantId { get; set; }{{ end }}
}
