using Modulus.Data.Abstractions;
{{ if cursor_paging }}using Modulus.Core.Abstractions.Common;
{{ end }}
namespace {{ module_namespace }}.Domain;

public interface I{{ entity_name }}Repository : IRepository<{{ entity_name }}>
{
    Task<IReadOnlyList<{{ entity_name }}>> GetAllAsync(CancellationToken ct);

    /// <summary>One page of {{ entity_name_lower }}s in a stable (Id) order; <paramref name="skip"/> and <paramref name="take"/> are applied in the database.</summary>
    Task<IReadOnlyList<{{ entity_name }}>> GetPageAsync(int skip, int take, CancellationToken ct);

    /// <summary>The {{ entity_name_lower }}s with these ids, in one query (the query filters apply, so another company's or a deleted record is absent).</summary>
    Task<IReadOnlyList<{{ entity_name }}>> GetByIdsAsync(IReadOnlyCollection<Guid> ids, CancellationToken ct);
{{ if cursor_paging }}
    /// <summary>
    /// One keyset page of {{ entity_name_lower }}s in key order, after the position in <paramref name="cursor"/> (null = the first page).
    /// A malformed cursor is an <see cref="ArgumentException"/>.
    /// </summary>
    Task<KeysetPage<{{ entity_name }}>> GetKeysetPageAsync(string? cursor, int size, CancellationToken ct);
{{ end }}}
