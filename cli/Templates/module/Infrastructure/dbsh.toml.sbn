# dbsh configuration for the {{ module_name }} module.
# Install dbsh: dotnet tool install --global dbsh
# Apply: dbsh migrate --module {{ dbsh_module_name }} --yes
# Status: dbsh status --module {{ dbsh_module_name }}
# Rollback: dbsh rollback --module {{ dbsh_module_name }} --count 1

[migrations]
provider = "{{ db_provider | string.downcase }}"
modules = ["{{ dbsh_module_name }}"]
type = "timestamp"

[migrations.table_prefix]
# Matches ModuleDbContext.TablePrefix so EF queries and dbsh SQL target the same tables.
module = "{{ module_name_lower }}_"

[environments.development]
# Override at runtime via environment variables:
#   DBSH_<MODULE>_CONNECTION
connection_string = "{{ connection_string }}"
