using Microsoft.EntityFrameworkCore;
using Modulus.Data.Abstractions;
using {{ module_namespace }}.Domain;

namespace {{ module_namespace }}.Infrastructure;

public sealed class {{ entity_name }}Repository({{ module_name }}DbContext context)
    : I{{ entity_name }}Repository
{
    private readonly DbSet<{{ entity_name }}> _dbSet = context.Set<{{ entity_name }}>();

    public async Task<{{ entity_name }}?> GetByIdAsync(object id, CancellationToken ct)
        => await _dbSet.FindAsync([id], ct);

    public async Task<IReadOnlyList<{{ entity_name }}>> GetAllAsync(CancellationToken ct)
        => await _dbSet.AsNoTracking().ToListAsync(ct);

    public async Task<IReadOnlyList<{{ entity_name }}>> ListAsync(
        ISpecification<{{ entity_name }}> spec,
        CancellationToken ct)
        => await ApplySpec(spec).ToListAsync(ct);

    public async Task<{{ entity_name }}?> FirstOrDefaultAsync(
        ISpecification<{{ entity_name }}> spec,
        CancellationToken ct)
        => await ApplySpec(spec).FirstOrDefaultAsync(ct);

    public async Task<{{ entity_name }}> SingleAsync(
        ISpecification<{{ entity_name }}> spec,
        CancellationToken ct)
        => await ApplySpec(spec).SingleAsync(ct);

    public async Task<{{ entity_name }}?> SingleOrDefaultAsync(
        ISpecification<{{ entity_name }}> spec,
        CancellationToken ct)
        => await ApplySpec(spec).SingleOrDefaultAsync(ct);

    public IAsyncEnumerable<{{ entity_name }}> AsAsyncEnumerable(
        ISpecification<{{ entity_name }}> spec)
        => ApplySpec(spec).AsAsyncEnumerable();

    public async Task<int> CountAsync(
        ISpecification<{{ entity_name }}> spec,
        CancellationToken ct)
        => await ApplySpec(spec, includePaging: false).CountAsync(ct);

    public async Task AddAsync({{ entity_name }} entity, CancellationToken ct)
        => await _dbSet.AddAsync(entity, ct);

    public Task AddRangeAsync(IEnumerable<{{ entity_name }}> entities, CancellationToken ct)
        => _dbSet.AddRangeAsync(entities, ct);

    public Task UpdateAsync({{ entity_name }} entity, CancellationToken ct)
    {
        _dbSet.Update(entity);
        return Task.CompletedTask;
    }

    public Task DeleteAsync({{ entity_name }} entity, CancellationToken ct)
    {
        _dbSet.Remove(entity);
        return Task.CompletedTask;
    }

    public async Task DeleteRangeAsync(
        ISpecification<{{ entity_name }}> spec,
        CancellationToken ct)
    {
        var matched = await ApplySpec(spec).ToListAsync(ct);
        _dbSet.RemoveRange(matched);
    }

    private IQueryable<{{ entity_name }}> ApplySpec(
        ISpecification<{{ entity_name }}> spec, bool includePaging = true)
    {
        var query = _dbSet.AsQueryable();

        if (spec.IgnoreQueryFilters)
            query = query.IgnoreQueryFilters();

        if (spec.AsSplitQuery)
            query = query.AsSplitQuery();

        if (spec.IncludeChains is { Count: > 0 })
            foreach (var include in spec.IncludeChains)
                query = query.Include(include.IncludeExpression);

        // Apply ordering: OrderBy, then ThenBy for each subsequent clause.
        var isFirstOrderBy = true;
        if (spec.OrderByClauses is { Count: > 0 })
        {
            foreach (var orderBy in spec.OrderByClauses)
            {
                query = isFirstOrderBy
                    ? (orderBy.Descending
                        ? query.OrderByDescending(orderBy.Selector)
                        : query.OrderBy(orderBy.Selector))
                    : (orderBy.Descending
                        ? ((IOrderedQueryable<{{ entity_name }}>)query).ThenByDescending(orderBy.Selector)
                        : ((IOrderedQueryable<{{ entity_name }}>)query).ThenBy(orderBy.Selector));
                isFirstOrderBy = false;
            }
        }

        if (includePaging)
        {
            // Paging requires ordering (stable offsets).
            if ((spec.Skip != null || spec.Take != null) && isFirstOrderBy)
                throw new InvalidOperationException(
                    "Specifications with Skip/Take must define at least one OrderBy clause.");
            if (spec.Skip != null)
                query = query.Skip(spec.Skip.Value);
            if (spec.Take != null)
                query = query.Take(spec.Take.Value);
        }

        if (spec.Tag is not null)
            query = query.TagWith(spec.Tag);

        if (spec.AsNoTracking)
            query = query.AsNoTracking();

        return query;
    }
}
