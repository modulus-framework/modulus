using Microsoft.EntityFrameworkCore;
using Microsoft.Extensions.Configuration;
using Microsoft.Extensions.DependencyInjection;
using Modulus.Core.Abstractions;
using Modulus.EntityFrameworkCore.Extensions;
using Modulus.Mediator.Extensions;
using {{ module_namespace }}.Application;
{{ if entity_name }}using {{ module_namespace }}.Domain;
{{ end }}namespace {{ module_namespace }}.Infrastructure;

/// <summary>
/// Composition root for the {{ module_name }} module. Registers the module's own
/// DbContext (via <see cref="EFCoreServiceCollectionExtensions.AddModuleDatabase{TContext}"/>),
/// binds the module's <see cref="IUnitOfWork"/> to it, and contributes the
/// module's mediator handlers. Add [DependsOn] for any framework modules.
/// </summary>
public sealed class {{ module_name }}Module : ModulusModule
{
    public override void ConfigureServices(
        IServiceCollection services,
        IConfiguration configuration)
    {
        services.AddModuleDatabase<{{ module_name }}DbContext>(options =>
            options.{{ use_db_method }}(configuration.GetConnectionString("{{ module_name }}")
                ?? "{{ connection_string }}"));

        services.AddScoped<IUnitOfWork>(sp => sp.GetRequiredService<{{ module_name }}DbContext>());
{{ if entity_name }}
        services.AddScoped<I{{ entity_name }}Repository, {{ entity_name }}Repository>();
        services.AddMediatorHandlers(typeof(Create{{ entity_name }}Handler).Assembly);
{{ end }}    }
}
