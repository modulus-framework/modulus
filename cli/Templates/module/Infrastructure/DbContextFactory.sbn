using Microsoft.EntityFrameworkCore;
using Microsoft.EntityFrameworkCore.Design;
using Modulus.EntityFrameworkCore.Design;

namespace {{ module_namespace }}.Infrastructure;

/// <summary>
/// Design-time factory used by the EF Core tools (<c>dotnet ef</c> /
/// <c>modulus migrate</c>) to construct <see cref="{{ module_name }}DbContext"/>
/// without the application's DI container or an HTTP request. At runtime the app
/// still builds the context through DI (see <see cref="{{ module_name }}Module"/>);
/// this type is only used when scaffolding or applying migrations.
/// </summary>
/// <remarks>
/// The connection string is read from the <c>{{ module_name | string.upcase }}_CONNECTION</c>
/// environment variable when set — so CI/CD can point migrations at the real
/// database — otherwise it falls back to the module's default design-time
/// connection string. The tenant/user/dispatcher arguments are design-time stubs
/// from <see cref="DesignTimeContext"/>: migrations only build the model, never
/// live request state.
/// </remarks>
public sealed class {{ module_name }}DbContextFactory
    : IDesignTimeDbContextFactory<{{ module_name }}DbContext>
{
    public {{ module_name }}DbContext CreateDbContext(string[] args)
    {
        var connectionString =
            Environment.GetEnvironmentVariable("{{ module_name | string.upcase }}_CONNECTION")
            ?? "{{ connection_string }}";

        var options = new DbContextOptionsBuilder<{{ module_name }}DbContext>()
            .{{ use_db_method }}(connectionString)
            .Options;

        return new {{ module_name }}DbContext(
            options,
            DesignTimeContext.Tenant,
            DesignTimeContext.User,
            DesignTimeContext.Dispatcher,
            DesignTimeContext.Services);
    }
}
