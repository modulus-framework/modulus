    private const string Permission = "{{ required_permission }}";

{{ end }}    public void ConfigureQuery(ObjectGraphType query)
    {
        query.Field<NonNullGraphType<ListGraphType<NonNullGraphType<{{ entity_name }}GraphType>>>>("{{ entity_plural_camel }}")
            .Description("A page of {{ entity_name_lower }}s (default 100, at most 500).")
            .Argument<IntGraphType>("page")
            .Argument<IntGraphType>("pageSize")
            {{ authorize }}
            .ResolveAsync(async context => await context.QueryAsync(new Get{{ entity_plural }}Query(
