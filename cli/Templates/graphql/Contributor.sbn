                context.GetArgument<int?>("pageSize") ?? Get{{ entity_plural }}Query.DefaultPageSize)));

        query.Field<{{ entity_name }}GraphType>("{{ entity_name_camel }}")
            .Description("One {{ entity_name_lower }}, by id.")
            .Argument<NonNullGraphType<IdGraphType>>("id")
            {{ authorize }}
