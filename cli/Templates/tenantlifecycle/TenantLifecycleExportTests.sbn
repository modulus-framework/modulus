using System.Net;
using System.Net.Http.Json;
using System.Security.Cryptography;
using System.Text.Json;
using FluentAssertions;
using Microsoft.AspNetCore.Hosting;
using Modulus.Testing;
using Xunit;
using ApiEntryPoint = {{ root_namespace }}.Api.ApiEntryPoint;

namespace {{ root_namespace }}.Tests;

/// <summary>
/// A company administrator exports the company's data over HTTP: the request is accepted, the lifecycle worker builds the encrypted
/// archive, and the download returns it. The Admin role holds <c>tenant-data:export</c> through the company's starting grants
/// (<c>CompanyProvisioning:Grants</c>). The archive keys are random per run and given to the host at start, so no secret is committed.
/// </summary>
public sealed class TenantLifecycleExportTests(TenantLifecycleExportTests.ExportFactory factory)
    : IClassFixture<TenantLifecycleExportTests.ExportFactory>
{
    private const string Exports = "/tenant-data/exports";

    public sealed class ExportFactory : ModulusWebAppFactory<ApiEntryPoint>
    {
        protected override void ConfigureWebHost(IWebHostBuilder builder)
        {
            base.ConfigureWebHost(builder);
            builder.UseSetting("TenantLifecycle:ExportEncryptionKey", Convert.ToBase64String(RandomNumberGenerator.GetBytes(32)));
            builder.UseSetting("TenantLifecycle:CertificateSigningKey", Convert.ToBase64String(RandomNumberGenerator.GetBytes(32)));
            builder.UseSetting("TenantLifecycle:WorkerInterval", "00:00:00.200");
        }
    }

    [Fact]
    public async Task A_company_administrator_can_export_the_company_data_and_download_the_archive()
    {
        var company = await Companies.CreateAsync(factory.Services, "export");
        var client = factory.CreateAuthenticatedClient(roles: ["Admin"], tenantId: company, pinTenant: true);

        var accepted = await client.PostAsync(Exports, null);
        accepted.StatusCode.Should().Be(HttpStatusCode.Accepted);
        var id = (await accepted.Content.ReadFromJsonAsync<JsonElement>()).GetProperty("id").GetGuid();

        var state = string.Empty;
        for (var i = 0; i < 100 && state != "Completed"; i++)
        {
            await Task.Delay(100);
            var view = await (await client.GetAsync($"{Exports}/{id}")).Content.ReadFromJsonAsync<JsonElement>();
            state = view.GetProperty("state").ToString();
            state.Should().NotBe("Failed", "the export must not fail");
        }

        state.Should().Be("Completed");
        var download = await client.GetAsync($"{Exports}/{id}/download");
        download.StatusCode.Should().Be(HttpStatusCode.OK);
        download.Content.Headers.ContentType?.MediaType.Should().Be("application/zip");
        (await download.Content.ReadAsByteArrayAsync()).Length.Should().BeGreaterThan(0);
    }

    [Fact]
    public async Task Another_company_cannot_see_or_download_the_export()
    {
        var company = await Companies.CreateAsync(factory.Services, "export-owner");
        var other = await Companies.CreateAsync(factory.Services, "export-other");
        var owner = factory.CreateAuthenticatedClient(roles: ["Admin"], tenantId: company, pinTenant: true);
        var stranger = factory.CreateAuthenticatedClient(roles: ["Admin"], tenantId: other, pinTenant: true);

        var accepted = await owner.PostAsync(Exports, null);
        accepted.StatusCode.Should().Be(HttpStatusCode.Accepted);
        var id = (await accepted.Content.ReadFromJsonAsync<JsonElement>()).GetProperty("id").GetGuid();

        (await stranger.GetAsync($"{Exports}/{id}")).StatusCode.Should().Be(HttpStatusCode.NotFound);
        (await stranger.GetAsync($"{Exports}/{id}/download")).StatusCode.Should().Be(HttpStatusCode.NotFound);
    }
}
