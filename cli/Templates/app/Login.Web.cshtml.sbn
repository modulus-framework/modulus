@page
@model {{ root_namespace }}.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Sign in";
}

<div class="page page-center">
    <div class="container container-tight py-4">
        <div class="text-center mb-4">
            <h1 class="text-primary">Sign in</h1>
            <p class="text-secondary">Use your application account to continue.</p>
        </div>
        <div class="card card-md">
            <div class="card-body">
                @if (!string.IsNullOrEmpty(Model.Error))
                {
                    <div class="alert alert-danger" role="alert">@Model.Error</div>
                }
                <form method="post" novalidate>
                    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                    <div class="mb-3">
                        <label class="form-label" for="UserName">User name</label>
                        <input id="UserName" name="UserName" class="form-control"
                               value="@Model.UserName" autocomplete="username" autofocus />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="Password">Password</label>
                        <input id="Password" name="Password" type="password" class="form-control"
                               autocomplete="current-password" />
                    </div>
                    <div class="form-footer">
                        <button type="submit" class="btn btn-primary w-100">Sign in</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
