@page
@model {{ root_namespace }}.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Sign in";
}

{{ if use_ui_framework }}<div class="m-auth-card">
    <div class="m-auth-card-body">
        <h1 class="m-auth-title">Sign in</h1>
        <p class="m-auth-hint">Use your application account to continue.</p>
        @if (!string.IsNullOrEmpty(Model.Error))
        {
            <app-alert type="error" show-icon message="@Model.Error" class="m-mb-16" />
        }
        <form method="post" class="ant-form ant-form-vertical ant-form-hide-required-mark" novalidate>
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
            <app-form-item asp-for="UserName" label="User name">
                <app-input asp-for="UserName" prefix-icon="user" autocomplete="username" />
            </app-form-item>
            <app-form-item asp-for="Password" label="Password">
                <app-input asp-for="Password" type="password" prefix-icon="lock" autocomplete="current-password" />
            </app-form-item>
            <div class="m-auth-actions">
                <app-button type="primary" html-type="submit" block>Sign in</app-button>
            </div>
        </form>
    </div>
</div>
{{ else }}<div class="page page-center">
    <div class="container container-tight py-4">
        <div class="text-center mb-4">
            <h1 class="text-primary">Sign in</h1>
            <p class="text-secondary">Use your application account to continue.</p>
        </div>
        <div class="card card-md">
            <div class="card-body">
                @if (!string.IsNullOrEmpty(Model.Error))
                {
                    <div class="alert alert-danger" role="alert">@Model.Error</div>
                }
                <form method="post" novalidate>
                    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                    <div class="mb-3">
                        <label class="form-label" for="UserName">User name</label>
                        <input id="UserName" name="UserName" class="form-control"
                               value="@Model.UserName" autocomplete="username" autofocus />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="Password">Password</label>
                        <input id="Password" name="Password" type="password" class="form-control"
                               autocomplete="current-password" />
                    </div>
                    <div class="form-footer">
                        <button type="submit" class="btn btn-primary w-100">Sign in</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
{{ end }}
