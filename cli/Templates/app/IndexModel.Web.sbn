using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;
using Microsoft.AspNetCore.Mvc.RazorPages;

namespace {{ root_namespace }}.Web.Pages;

/// <summary>Landing page.{{ if use_auth }} Requires a signed-in user (the whole app except
/// /Account does) — it is where the login page redirects after sign-in.{{ end }}</summary>
{{ if use_auth }}[Authorize]
{{ end }}public class IndexModel : PageModel
{
    public void OnGet()
    {
    }

    /// <summary>htmx demo: returns a fragment that replaces #greeting (GET ?handler=Greeting).</summary>
    public ContentResult OnGetGreeting() =>
        Content($"<p>Loaded by htmx at {DateTime.UtcNow:HH:mm:ss} UTC.</p>", "text/html");
}
