{{ if use_ui_framework }}@{
    // The Modulus UI framework's application shell (header, menu, footer, theme settings).
    Layout = "_ModulusLayout";
}
{{ else }}@{
    // The active theme's application layout (falls back to the UI framework's
    // shell when no theme is installed; null for htmx fragment requests).
    Layout = Context.GetThemeLayout(StandardLayouts.Application);
}
{{ end }}
