<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
{{ if local_package_source }}
    <!-- Local feed supplied via modulus app (package-source option) -->
    <add key="modulus-local" value="{{ local_package_source }}" />
{{ else }}
    <!--
      To use a local feed of the Cobytelabs.Modulus.* packages (e.g. the
      framework repo's nupkg folder after dotnet pack), pass the feed path
      via the package source option to the new app command
      (see: modulus app help).

      or uncomment the entry below:

      <add key="modulus-local" value="../../nupkg" />
    -->
{{ end }}
{{ if ui_feed_source }}
    <!-- Local feed of the Modulus UI framework packages; remove it once they are on nuget.org -->
    <add key="modulus-ui-local" value="{{ ui_feed_source }}" />
{{ end }}
  </packageSources>
{{ if ui_feed_source && !local_package_source }}
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="modulus-ui-local">
      <package pattern="Modulus.Ui.*" />
      <package pattern="Modulus.AspNetCore.*" />
      <package pattern="Modulus.Blazor" />
      <package pattern="Modulus.Documents" />
    </packageSource>
  </packageSourceMapping>
{{ end }}
{{ if local_package_source }}
  <!-- Source mapping makes the local feed authoritative for framework
       packages: published nuget.org versions with the same number can be
       older than the local build, and identical versions otherwise resolve
       non-deterministically. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" exclude="Cobytelabs.*" />
    </packageSource>
    <packageSource key="modulus-local">
      <package pattern="Cobytelabs.*" />
    </packageSource>
{{ if ui_feed_source }}
    <packageSource key="modulus-ui-local">
      <package pattern="Modulus.Ui.*" />
      <package pattern="Modulus.AspNetCore.*" />
      <package pattern="Modulus.Blazor" />
      <package pattern="Modulus.Documents" />
    </packageSource>
{{ end }}
  </packageSourceMapping>
{{ end }}
</configuration>
