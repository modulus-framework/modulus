{{ if use_ui_framework }}@{
    // The sign-in and status pages render in the auth frame (no shell), see Pages/Shared/_AuthLayout.cshtml.
    Layout = "_AuthLayout";
}
{{ else }}@{
    // The Account pages (login/logout) render in the theme's account layout —
    // the same one the framework's own sign-in UI uses.
    Layout = Context.GetThemeLayout(StandardLayouts.Account);
}
{{ end }}
