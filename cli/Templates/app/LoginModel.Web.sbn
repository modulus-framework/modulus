{{ if web_login_mode != "Password" }}using Microsoft.AspNetCore.Authentication;
{{ end }}using Microsoft.AspNetCore.Mvc;
using Microsoft.AspNetCore.Mvc.RazorPages;
{{ if web_login_mode == "Password" }}using Modulus.Bff.Tokens;
{{ else }}using Modulus.Bff;
{{ end }}
namespace {{ root_namespace }}.Web.Pages.Account;

/// <summary>
{{~ if web_login_mode == "Password" ~}}
/// Signs the user in through the BFF web session (Modulus.Bff): the credentials go to the API host's token
/// endpoint (the OpenIddict password grant, enabled in development; see Identity:AllowPasswordFlow), the tokens
/// stay on the server (the cookie only names the session) and every typed API client carries the session's access
/// token, refreshed before it expires. The client is "Bff:Clients:web" in appsettings.json.
{{~ else ~}}
/// Sends the user to the auth server's login page (OIDC code + PKCE through the BFF web session, Modulus.Bff). The
/// tokens stay on the server (the cookie only names the session) and every typed API client carries the session's
/// access token, refreshed before it expires. The client is "Bff:Clients:web" in appsettings.json.
{{~ end ~}}
/// </summary>
public class LoginModel{{ if web_login_mode == "Password" }}(IBffSessionService session){{ end }} : PageModel
{
    /// <summary>The BFF client this host is (Program.cs: SetDefaultClient).</summary>
    public const string Client = "web";

    [BindProperty]
    public string UserName { get; set; } = "";

    [BindProperty]
    public string Password { get; set; } = "";

    public string? Error { get; private set; }

    public string? ReturnUrl { get; private set; }

{{~ if web_login_mode == "Password" ~}}
    public void OnGet(string? returnUrl = null)
    {
        ReturnUrl = SafeReturnUrl(returnUrl);
    }

    public async Task<IActionResult> OnPostAsync(string? returnUrl = null)
    {
        ReturnUrl = SafeReturnUrl(returnUrl);

        var result = await session.SignInWithPasswordAsync(HttpContext, Client, UserName, Password, rememberMe: true, HttpContext.RequestAborted);
        if (!result.Succeeded)
        {
            Error = "Invalid user name or password.";
            return Page();
        }

        return LocalRedirect(ReturnUrl ?? "/");
    }
{{~ else ~}}
    public IActionResult OnGet(string? returnUrl = null)
    {
        ReturnUrl = SafeReturnUrl(returnUrl);
        return Challenge(new AuthenticationProperties { RedirectUri = ReturnUrl ?? "/" }, BffDefaults.OidcScheme(Client));
    }
{{~ end ~}}

    private string? SafeReturnUrl(string? returnUrl) =>
        Url.IsLocalUrl(returnUrl) ? returnUrl : null;
}
