using Microsoft.AspNetCore.Mvc.RazorPages;
using Modulus.AspNetCore.Mvc;
using Modulus.AspNetCore.Security;
using Modulus.Core.Abstractions.Security;
{{ if use_auth }}using Modulus.AspNetCore.Security.Policy;
{{ end }}
namespace {{ root_namespace }}.Web.Configuration;

/// <summary>
/// The Razor Pages{{ if ui_engine == "mvc" }} and MVC{{ end }} UI: the Modulus UI shell (header, sidebar, theme settings), the app-* tag helpers and the default
/// access rule. {{ if use_auth }}Pages require a signed-in user; only /Account (sign-in, sign-out, access denied) is open.{{ else }}Pages are public until auth is added.{{ end }}
/// </summary>
internal static class UiSetup
{
    public static IServiceCollection AddWebUi(this IServiceCollection services, IConfiguration configuration)
    {
        services.AddRazorPages();
{{ if ui_engine == "mvc" }}
        // MVC controllers and views for the landing page; the sign-in pages stay Razor Pages.
        services.AddControllersWithViews();
{{ end }}
        // Brand and layout settings come from "Modulus:Theme" in appsettings.json; add menu entries with an IMenuContributor.
        services.AddModulusMvc(theme => configuration.GetSection("Modulus:Theme").Bind(theme));

{{ if use_auth }}        // Pages require a signed-in user; the sign-in pages under /Account are the only open folder.
{{ else }}        // No sign-in configured: the no-sign-in scheme (Security/NoSignInAuthentication.cs) answers 401 to every page that
        // requires a user. Add a sign-in flow (AddAuthentication().AddCookie(...)) when you need one.
{{ end }}        services.PostConfigure<RazorPagesOptions>(options =>
        {
{{ if use_auth }}            options.Conventions.AuthorizeFolder("/");
{{ end }}            options.Conventions.AllowAnonymousToFolder("/Account");
            options.Conventions.AddFolderApplicationModelConvention("/Account", page =>
                page.EndpointMetadata.Add(new LoosenedAttribute("Sign-in pages under /Account are open") { Framework = true }));
            // The error page shows a 404 or 500 to anyone, signed in or not.
            options.Conventions.AllowAnonymousToFolder("/Error");
            options.Conventions.AddFolderApplicationModelConvention("/Error", page =>
                page.EndpointMetadata.Add(new LoosenedAttribute("The error page is shown to every visitor") { Framework = true }));
        });

        return services;
    }
}
