@page
@model {{ root_namespace }}.Web.Pages.Admin.AuditModel
@{
    ViewData["Title"] = "Security audit";
}

<app-page-header pretitle="Administration" title="Security audit" />

@if (Model.Message is not null)
{
    <app-alert type="info" show-icon message="@Model.Message" class="m-mb-16" />
}

@if (Model.Verification is { } check)
{
    <app-alert type="@(check.IsValid ? "success" : "error")" show-icon
               message="@($"Chain {(check.IsValid ? "verified" : "NOT VERIFIED")}, {check.Count} event(s)")@(check.Problem is not null ? " · " + check.Problem : "")"
               class="m-mb-16" />
}

<div class="m-card m-mb-16">
    <div class="m-card-body">
        <form method="get" class="m-flex m-flex-wrap m-gap-12" style="align-items: flex-end;">
            <div style="flex: 1 1 200px;">
                <label class="m-muted" for="audit-category">Category</label>
                <input id="audit-category" class="ant-input" name="Category" value="@Model.Category" placeholder="for example authentication" />
            </div>
            <div style="flex: 1 1 200px;">
                <label class="m-muted" for="audit-action">Action (prefix)</label>
                <input id="audit-action" class="ant-input" name="Action" value="@Model.Action" placeholder="for example role." />
            </div>
            <div style="flex: 0 1 160px;">
                <label class="m-muted" for="audit-outcome">Outcome</label>
                <input id="audit-outcome" class="ant-input" name="Outcome" value="@Model.Outcome" />
            </div>
            <div class="m-flex m-gap-8">
                <button class="ant-btn ant-btn-primary" type="submit">Search</button>
                <a class="ant-btn ant-btn-default" asp-page-handler="Export" asp-route-Category="@Model.Category" asp-route-Action="@Model.Action" asp-route-Outcome="@Model.Outcome">Export CSV</a>
            </div>
        </form>
    </div>
</div>

<div class="m-card m-table-card">
    <div class="m-card-body m-card-body-flush">
        @if (Model.Rows.Count == 0 && Model.Message is not null)
        {
            <div class="m-empty">
                <h3 class="m-empty-title">The events could not be loaded</h3>
                <p class="m-empty-subtitle">The message above says why.</p>
            </div>
        }
        else if (Model.Rows.Count == 0)
        {
            <div class="m-empty">
                <h3 class="m-empty-title">No events match this search</h3>
                <p class="m-empty-subtitle">Widen the filters, or clear them to see the latest events.</p>
            </div>
        }
        else
        {
            <div class="ant-table-wrapper m-table-flush"><div class="ant-table"><div class="ant-table-container"><div class="ant-table-content">
                <table style="table-layout: auto;">
                    <thead class="ant-table-thead">
                        <tr>
                            <th class="ant-table-cell">#</th>
                            <th class="ant-table-cell">When</th>
                            <th class="ant-table-cell">Category</th>
                            <th class="ant-table-cell">Action</th>
                            <th class="ant-table-cell">Outcome</th>
                            <th class="ant-table-cell">Actor</th>
                            <th class="ant-table-cell">Target</th>
                        </tr>
                    </thead>
                    <tbody class="ant-table-tbody">
                    @foreach (var row in Model.Rows)
                    {
                        <tr class="ant-table-row">
                            <td class="ant-table-cell m-muted">@row.Sequence</td>
                            <td class="ant-table-cell">@row.OccurredAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td class="ant-table-cell">@row.Category</td>
                            <td class="ant-table-cell">@row.Action</td>
                            <td class="ant-table-cell"><span class="ant-tag">@row.Outcome</span></td>
                            <td class="ant-table-cell">@row.Actor</td>
                            <td class="ant-table-cell">@row.Target</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div></div></div></div>
        }
    </div>
</div>
