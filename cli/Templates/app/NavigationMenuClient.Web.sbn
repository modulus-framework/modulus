using System.Net;
using System.Net.Http.Json;
using Microsoft.Extensions.Configuration;
using Microsoft.Extensions.Logging;
using Modulus.Ui.Abstractions.Navigation;

namespace {{ root_namespace }}.Web.Services.ApiClients;

/// <summary>
/// The API's application menu (<c>/api/navigation/menu</c>), reached through the BFF gateway so the browser's session carries the
/// signed-in person's token. The API answers each person with the items they may see and no others. A browser with no session has no
/// menu (the API answers 401), so the sign-in pages still render.
/// </summary>
public sealed class NavigationMenuClient(HttpClient http, IConfiguration configuration, ILogger<NavigationMenuClient> logger)
{
    private const string Route = "/api/navigation/menu";

    // With a sign-in the calls go through the BFF (Bff:BaseUrl), which forwards /api with the session's token.
    private readonly HttpClient _http = Configure(http, configuration);

    private static HttpClient Configure(HttpClient http, IConfiguration configuration)
    {
        var baseUrl = configuration["Bff:BaseUrl"] ?? configuration["Api:BaseUrl"] ?? "http://localhost:5180";
        http.BaseAddress = new Uri($"{baseUrl.TrimEnd('/')}/");
        return http;
    }

    /// <summary>
    /// The menu of the signed-in person. Without a session (401) there is no menu. When the API cannot be reached or fails, the pages still
    /// render without the menu, and the log says why: a page should not fail because a menu could not be loaded.
    /// </summary>
    public async Task<IReadOnlyList<ServerMenuNode>> GetMenuAsync(CancellationToken ct)
    {
        try
        {
            using var response = await _http.GetAsync(Route, ct);
            if (response.StatusCode == HttpStatusCode.Unauthorized) return [];
            response.EnsureSuccessStatusCode();
            return await response.Content.ReadFromJsonAsync<List<ServerMenuNode>>(ct) ?? [];
        }
        catch (HttpRequestException ex)
        {
            logger.LogWarning(ex, "The application menu could not be loaded from the API; the page renders without it.");
            return [];
        }
    }
}
