{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Modulus": {
    "Theme": {
      "Title": "{{ app_name }}",
      "SpaNavigation": true
    }
  },
  "Api": {
    "BaseUrl": "http://localhost:5180",
    "ClientId": "{{ app_name_lower }}"
  },
{{ if use_auth }}  "Bff": {
    "BaseUrl": "{{ bff_base_url }}"
  },
  "Caching": {
    "Fusion": {
      "CacheName": "{{ app_name_lower }}-web"
    }
  },
{{ end }}{{ if enable_correlation }}  "Correlation": {
    "HeaderName": "X-Correlation-ID",
    "IncludeInResponse": true,
    "UseTraceIdWhenMissing": true
  },
{{ end }}{{ if enable_security_headers }}  "SecurityHeaders": {
    "ContentTypeOptions": true,
    "FrameOptions": "DENY",
    "ReferrerPolicy": "strict-origin-when-cross-origin",
    "EnableHsts": true
  },
{{ end }}  "FeatureManagement": {
    "SampleFeature": false
  },
{{ if enable_secrets_guard }}  "SecretsGuard": {
    "Enabled": true,
    "FailOnViolation": true
  },
{{ end }}  "Security": {
    "Guard": {
      "AllowListPath": "Security/loosening-allowlist.json"
    },
    "Redaction": {
      "Enabled": true
    }
  },
  "AllowedHosts": "*"
}
