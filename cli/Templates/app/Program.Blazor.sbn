using {{ root_namespace }}.Web.Composition;
using {{ root_namespace }}.Web.Configuration;
using {{ root_namespace }}.Web.Endpoints;
using {{ root_namespace }}.Web.Middleware;
using {{ root_namespace }}.Web.Services;
{{ if use_auth }}using {{ root_namespace }}.Web.Security;
{{ end }}
var builder = WebApplication.CreateBuilder(args);

// The presentation host: Blazor components over the API host. No DbContext and no modules here. Each concern has its own
// setup file (Configuration, Security, Composition, Middleware, Endpoints); this file only composes them, in the order the
// pipeline depends on.

// The Modulus UI framework for Blazor (Ant Design Blazor, the ProLayout, the theme tokens and the menu pipeline), and the hardening.
builder.Services.AddWebUi(builder.Configuration);
{{ if use_auth }}builder.Services.AddWebAuthentication(builder.Configuration);
{{ end }}
// The typed API clients (Services/ApiClients/) read the API address from "Api:BaseUrl".
builder.Services.AddModuleApiClients();

// Menu contributors under Components/Navigation/Menu are registered by scan: a new entity's menu entry is its file there.
builder.Services.AddMenuContributors();

var app = builder.Build();

app.UseWebPipeline();
{{ if use_auth }}app.MapAccountEndpoints();
{{ end }}app.MapWebEndpoints();

app.Run();

// The entry point stays in the global namespace (top-level statements); this
// namespaced marker gives the integration tests an unambiguous generic
// argument for booting this host: ModulusWebAppFactory<{{ root_namespace }}.Web.WebEntryPoint>.
namespace {{ root_namespace }}.Web
{
    public sealed class WebEntryPoint;
}
