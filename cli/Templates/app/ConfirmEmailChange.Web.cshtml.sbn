@page
@model {{ root_namespace }}.Web.Pages.ConfirmEmailChangeModel
@{
    ViewData["Title"] = "Confirm new email address";
}

<app-page-header pretitle="Account" title="Confirm new email address" />

@if (Model.Message is not null)
{
    <app-alert type="info" show-icon message="@Model.Message" class="m-mb-16" />
}

<div class="m-card" style="max-width: 560px;">
    <div class="m-card-body">
        <p class="m-mb-16">Confirm that <strong>@Model.NewEmail</strong> is the address to use for this account.</p>
        <form method="post" class="m-flex m-gap-8">
            <input type="hidden" asp-for="NewEmail" />
            <input type="hidden" asp-for="Token" />
            <button class="ant-btn ant-btn-primary" type="submit">Confirm the change</button>
            <a class="ant-btn ant-btn-default" href="/Profile">Cancel</a>
        </form>
    </div>
</div>
