@page
@model {{ root_namespace }}.Web.Pages.ConfirmEmailChangeModel
@{
    ViewData["Title"] = "Confirm new email address";
}

<h1>Confirm new email address</h1>

@if (Model.Message is not null)
{
    <p role="status">@Model.Message</p>
}

<p>Confirm that <strong>@Model.NewEmail</strong> is the address to use for this account.</p>
<form method="post">
    <input type="hidden" asp-for="NewEmail" />
    <input type="hidden" asp-for="Token" />
    <button type="submit">Confirm the change</button>
</form>
