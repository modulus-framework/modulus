using System.Security.Cryptography;
using System.Text.Json;
using Microsoft.AspNetCore.Antiforgery;
using Microsoft.AspNetCore.DataProtection;
using Modulus.AspNetCore.Fluid;
using Modulus.AspNetCore.Security.Policy;
using {{ root_namespace }}.Web.Configuration;
using {{ root_namespace }}.Web.Security;

namespace {{ root_namespace }}.Web.Endpoints;

/// <summary>
/// The Liquid sign-in page and its POST, plus sign-out. The credentials go to the BFF (see <see cref="BffSessionClient"/>), which runs
/// the sign-in; the browser keeps only the BFF session cookie. The same messages as the Razor Pages sign-in page.
/// </summary>
internal static class AuthEndpoints
{
    public static WebApplication MapFluidAuthEndpoints(this WebApplication app, string templates)
    {
        app.MapGet("/auth/login", (HttpContext context, IAntiforgery antiforgery, ModulusLiquid liquid) =>
            AuthPage(liquid, templates, "auth/login", "Sign in", context, antiforgery, new Dictionary<string, object?>
            {
                ["reset"] = context.Request.Query["reset"].ToString() == "1",
                ["return_url"] = SafeReturnUrl(context.Request.Query["returnUrl"].ToString()),
            }))
            .Loosen("Sign-in page: anonymous by design");

        app.MapPost("/auth/login", async (HttpContext context, IAntiforgery antiforgery, BffSessionClient session, IDataProtectionProvider protection, ModulusLiquid liquid) =>
        {
            if (!await ValidAntiforgery(context, antiforgery)) return Results.BadRequest();
            var form = await context.Request.ReadFormAsync();
            var email = form["email"].ToString().Trim();
            var password = form["password"].ToString();
            var returnUrl = SafeReturnUrl(form["return_url"].ToString());
            var rememberMe = form["remember"] == "true";
            var result = await session.SignInAsync(email, password, rememberMe, context.RequestAborted);
            if (result.Succeeded) return Results.LocalRedirect(returnUrl);

            // The account has an authenticator app: the code is the second step. The password waits in a protected, short-lived token.
            if (result.Error == BffSignInResult.MfaRequiredError)
                return TwoFactorPage(liquid, templates, PendingSignIn.Protect(protection, new PendingSignIn(email, password, returnUrl, rememberMe)),
                    null, antiforgery, context);

            var error = result.Error == "temporarily_unavailable"
                ? "The sign-in service is not available right now. Try again in a moment."
                : "Wrong email or password.";
            return AuthPage(liquid, templates, "auth/login", "Sign in", context, antiforgery, new Dictionary<string, object?>
            {
                ["error"] = error,
                ["email"] = email,
                ["return_url"] = returnUrl,
            });
        }).RequireRateLimiting(RateLimitingSetup.SignInPolicy)
          .Loosen("Sign-in: the BFF checks the credentials");

        app.MapGet("/auth/two-factor", () => Results.LocalRedirect("/auth/login"))
            .Loosen("Redirects to the sign-in page; it checks nothing");

        app.MapPost("/auth/two-factor", async (HttpContext context, IAntiforgery antiforgery, BffSessionClient session, IDataProtectionProvider protection, ModulusLiquid liquid) =>
        {
            if (!await ValidAntiforgery(context, antiforgery)) return Results.BadRequest();
            var form = await context.Request.ReadFormAsync();
            var pendingToken = form["pending"].ToString();
            var pending = PendingSignIn.Open(protection, pendingToken);
            if (pending is null)
                return Results.LocalRedirect("/auth/login");

            // An authenticator code is six digits; a recovery code is a short word. Anything else is not sent.
            var code = new string(form["code"].ToString().Trim().Where(c => char.IsLetterOrDigit(c) || c == '-').ToArray());
            var result = code.Length == 0
                ? new BffSignInResult(false, BffSignInResult.MfaRequiredError)
                : await session.SignInAsync(pending.Email, pending.Password, pending.RememberMe, context.RequestAborted, mfaCode: code);
            if (result.Succeeded) return Results.LocalRedirect(pending.ReturnUrl);

            var error = result.Error == "temporarily_unavailable"
                ? "The sign-in service is not available right now. Try again in a moment."
                : "That code is not right. Try again, or sign in again to start over.";
            return TwoFactorPage(liquid, templates, pendingToken, error, antiforgery, context);
        }).RequireRateLimiting(RateLimitingSetup.SignInPolicy)
          .Loosen("Sign-in: the BFF checks the code");

        app.MapPost("/auth/logout", async (HttpContext context, IAntiforgery antiforgery, BffSessionClient session) =>
        {
            if (!await ValidAntiforgery(context, antiforgery)) return Results.BadRequest();
            await session.SignOutAsync(null, context.RequestAborted);
            return Results.LocalRedirect("/auth/login");
        }).Loosen("Ends the BFF session; it only removes the caller's own session cookie");

        return app;
    }

    // Only a path on this site: a return URL to another host, or a protocol-relative one, goes to the home page.
    private static string SafeReturnUrl(string? url) =>
        url is { Length: > 0 } u && u[0] == '/' && (u.Length == 1 || (u[1] != '/' && u[1] != '\\')) && !u.Contains("://", StringComparison.Ordinal)
            ? u
            : "/";

    private static IResult TwoFactorPage(ModulusLiquid liquid, string templates, string pending, string? error, IAntiforgery antiforgery, HttpContext context)
    {
        var values = new Dictionary<string, object?> { ["pending"] = pending };
        if (error is not null) values["error"] = error;
        return AuthPage(liquid, templates, "auth/two-factor", "Two-factor authentication", context, antiforgery, values);
    }

    private static IResult AuthPage(ModulusLiquid liquid, string templates, string page, string title, HttpContext context, IAntiforgery antiforgery, Dictionary<string, object?> values)
    {
        values["title"] = title;
        values["app_name"] = "{{ root_namespace }}";
        values["antiforgery_token"] = antiforgery.GetAndStoreTokens(context).RequestToken;
        var html = liquid.RenderPage(
            liquid.Load(Path.Combine(templates, page + ".liquid")),
            liquid.Load(Path.Combine(templates, "_layout.liquid")),
            values);
        return Results.Content(html, "text/html; charset=utf-8");
    }

    /// <summary>
    /// The sign-in waiting for its second factor. It is protected with Data Protection and lives five minutes, so the password is
    /// never in the page's hidden field in clear and cannot be reused after the window.
    /// </summary>
    internal sealed record PendingSignIn(string Email, string Password, string ReturnUrl, bool RememberMe)
    {
        private const string Purpose = "Modulus.Fluid.TwoFactor";

        public static string Protect(IDataProtectionProvider protection, PendingSignIn pending) =>
            protection.CreateProtector(Purpose).ToTimeLimitedDataProtector().Protect(JsonSerializer.Serialize(pending), TimeSpan.FromMinutes(5));

        public static PendingSignIn? Open(IDataProtectionProvider protection, string token)
        {
            if (token.Length == 0) return null;
            try
            {
                return JsonSerializer.Deserialize<PendingSignIn>(protection.CreateProtector(Purpose).ToTimeLimitedDataProtector().Unprotect(token));
            }
            catch (CryptographicException)
            {
                return null;
            }
        }
    }

    private static async Task<bool> ValidAntiforgery(HttpContext context, IAntiforgery antiforgery)
    {
        try
        {
            await antiforgery.ValidateRequestAsync(context);
            return true;
        }
        catch (AntiforgeryValidationException)
        {
            return false;
        }
    }
}
