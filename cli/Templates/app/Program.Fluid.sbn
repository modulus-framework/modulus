using Modulus.AspNetCore.Fluid;
using Modulus.AspNetCore.Hosting;

// The Web host of {{ root_namespace }}: Liquid pages on the Modulus UI, rendered by Fluid. The pages are the Liquid files in
// Templates/ (a layout and two pages), copied next to the app. Every value is escaped; {% modulus_head %} draws the Modulus styles.
// This host has no sign-in. A page is a Liquid file in Templates/, and its path is its route: Templates/orders/list.liquid (or
// Templates/orders/index.liquid) is served at /orders/list. Outside Development an unhandled error gets the error page with a 500
// status and no exception text.
const string AppName = "{{ root_namespace }}";

var builder = WebApplication.CreateBuilder(args);

builder.Services.AddModulusHardening();
builder.Services.AddModulusObservability();
builder.Services.AddSingleton(new ModulusLiquid(new ModulusLiquidOptions()));

var app = builder.Build();
var templates = Path.Combine(app.Environment.ContentRootPath, "Templates");

if (!app.Environment.IsDevelopment())
    app.UseExceptionHandler(errors => errors.Run(async context =>
    {
        var liquid = context.RequestServices.GetRequiredService<ModulusLiquid>();
        context.Response.StatusCode = StatusCodes.Status500InternalServerError;
        await Page(liquid, templates, "error", "Server error", new Dictionary<string, object?>()).ExecuteAsync(context);
    }));

app.UseModulusHardening();
app.MapModulusHealth();
app.MapStaticAssets();

app.MapGet("/", (ModulusLiquid liquid) => Page(liquid, templates, "index", "Home", new Dictionary<string, object?>()));

// Every other path is a page in Templates/ (see the header). A path that is not a page is a 404.
app.MapFallback((HttpContext context, ModulusLiquid liquid) =>
{
    var relative = (context.Request.Path.Value ?? "").Trim('/');
    var page = PagePath(templates, relative);
    return page is null
        ? Results.NotFound()
        : Page(liquid, templates, page, relative, new Dictionary<string, object?>());
});

app.Run();

static IResult Page(ModulusLiquid liquid, string templates, string page, string title, Dictionary<string, object?> values)
{
    values["title"] = title;
    values["app_name"] = AppName;
    var html = liquid.RenderPage(
        liquid.Load(Path.Combine(templates, page + ".liquid")),
        liquid.Load(Path.Combine(templates, "_layout.liquid")),
        values);
    return Results.Content(html, "text/html; charset=utf-8");
}

// The page name for a request path, or null: the layout, the error page and names starting with "_" are not pages, and a path
// must stay inside Templates/.
static string? PagePath(string templates, string relative)
{
    if (relative.Length == 0) return null;
    var segments = relative.Split('/');
    if (segments.Any(s => s.Length == 0 || s.StartsWith('_') || s is "." or "..") || segments[0] == "error") return null;

    var root = Path.GetFullPath(templates) + Path.DirectorySeparatorChar;
    foreach (var candidate in new[] { relative, relative + "/index" })
    {
        var file = Path.GetFullPath(Path.Combine(templates, candidate + ".liquid"));
        if (file.StartsWith(root, StringComparison.Ordinal) && File.Exists(file)) return candidate;
    }
    return null;
}
