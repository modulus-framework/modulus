using Modulus.AspNetCore.Fluid;
using Modulus.AspNetCore.Hosting;

// The Web host of {{ root_namespace }}: Liquid pages on the Modulus UI, rendered by Fluid. The pages are the Liquid files in
// Templates/ (a layout and two pages), copied next to the app. Every value is escaped; {% modulus_head %} draws the Modulus styles.
// This host has no sign-in. A page is a Liquid file in Templates/, and its path is its route: Templates/orders/list.liquid (or
// Templates/orders/index.liquid) is served at /orders/list. Outside Development an unhandled error gets the error page with a 500
// status and no exception text.
const string AppName = "{{ root_namespace }}";

var builder = WebApplication.CreateBuilder(args);

builder.Services.AddModulusHardening();
builder.Services.AddModulusObservability();
// The components in Templates/Shared/Components are read by {% render %}; they are not pages.
builder.Services.AddSingleton(new ModulusLiquid(new ModulusLiquidOptions { TemplatesRoot = Path.Combine(builder.Environment.ContentRootPath, "Templates") }));

var app = builder.Build();
var templates = Path.Combine(app.Environment.ContentRootPath, "Templates");

if (!app.Environment.IsDevelopment())
    app.UseExceptionHandler(errors => errors.Run(async context =>
    {
        var liquid = context.RequestServices.GetRequiredService<ModulusLiquid>();
        context.Response.StatusCode = StatusCodes.Status500InternalServerError;
        await Page(liquid, templates, "error", "Server error", new Dictionary<string, object?>()).ExecuteAsync(context);
    }));

app.UseModulusHardening();
app.MapModulusHealth();
app.MapStaticAssets();

app.MapGet("/", (ModulusLiquid liquid) => Page(liquid, templates, "index", "Home", new Dictionary<string, object?>()));

// Every other path is a page in Templates/ (see the header). A path that is not a page is a 404.
app.MapFallback((HttpContext context, ModulusLiquid liquid) =>
{
    var relative = (context.Request.Path.Value ?? "").Trim('/');
    var found = PagePath(templates, relative);
    if (found is null) return Results.NotFound();
    var (page, values) = found.Value;
    return Page(liquid, templates, page, relative, values);
});

app.Run();

static IResult Page(ModulusLiquid liquid, string templates, string page, string title, Dictionary<string, object?> values)
{
    values["title"] = title;
    values["app_name"] = AppName;
    var html = liquid.RenderPage(
        liquid.Load(Path.Combine(templates, page + ".liquid")),
        liquid.Load(Path.Combine(templates, "_layout.liquid")),
        values);
    return Results.Content(html, "text/html; charset=utf-8");
}

// The page for a request path and the values its [name] folders matched, or null. The layout, the error page, the Shared folder
// (components) and names starting with "_" are not pages, and a path must stay inside Templates/. A static name wins over a [name]
// folder: Templates/admin/tenants/[id]/settings.liquid serves /admin/tenants/7/settings, with id = "7".
static (string Page, Dictionary<string, object?> Values)? PagePath(string templates, string relative)
{
    if (relative.Length == 0) return null;
    var segments = relative.Split('/');
    if (segments.Any(s => s.Length == 0 || s.StartsWith('_') || s is "." or "..") || segments[0] == "error" || string.Equals(segments[0], "Shared", StringComparison.OrdinalIgnoreCase)) return null;

    var values = new Dictionary<string, object?>();
    var page = MatchPage(Path.GetFullPath(templates), "", segments, 0, values);
    return page is null ? null : (page, values);
}

// Walks the folders for the segments from index i, below the folder rel (empty for Templates/). Returns the page name, or null.
static string? MatchPage(string templates, string rel, string[] segments, int i, Dictionary<string, object?> values)
{
    if (i == segments.Length)
    {
        foreach (var candidate in new[] { rel, Join(rel, "index") })
        {
            var file = Path.GetFullPath(Path.Combine(templates, candidate + ".liquid"));
            if (file.StartsWith(templates + Path.DirectorySeparatorChar, StringComparison.Ordinal) && File.Exists(file)) return candidate;
        }
        return null;
    }

    var segment = segments[i];
    var found = MatchPage(templates, Join(rel, segment), segments, i + 1, values);
    if (found is not null) return found;

    var dir = Path.Combine(templates, rel);
    if (!Directory.Exists(dir)) return null;
    foreach (var folder in Directory.GetDirectories(dir))
    {
        var name = Path.GetFileName(folder);
        if (name.Length < 3 || !name.StartsWith('[') || !name.EndsWith(']')) continue;
        var key = name[1..^1];
        values[key] = segment;
        found = MatchPage(templates, Join(rel, name), segments, i + 1, values);
        if (found is not null) return found;
        values.Remove(key);
    }
    return null;
}

static string Join(string rel, string name) => rel.Length == 0 ? name : rel + "/" + name;
