using System.Net;
using System.Net.Http.Json;
using System.Text.Json;
using Microsoft.Extensions.Configuration;

namespace {{ root_namespace }}.Web.Services.ApiClients;

/// <summary>
/// The account-recovery calls the signed-out pages make: asking for a reset link and setting a new password. Anonymous and direct to the
/// API, like the passkey sign-in options, because nobody is signed in yet.
/// </summary>
public sealed class AccountApiClient(HttpClient http, IConfiguration configuration)
{
    private readonly HttpClient _http = Configure(http, configuration);

    private static HttpClient Configure(HttpClient http, IConfiguration configuration)
    {
        var baseUrl = configuration["Api:BaseUrl"] ?? "http://localhost:5180";
        http.BaseAddress = new Uri($"{baseUrl.TrimEnd('/')}/");
        return http;
    }

    /// <summary>
    /// Asks for a reset link. The API answers the same whether or not the address has an account, so the page can too. Returns the message
    /// to show when the request could not be made; null when it was accepted.
    /// </summary>
    public async Task<string?> RequestResetAsync(string email, CancellationToken ct)
    {
        using var response = await _http.PostAsync($"account/forgot-password?email={Uri.EscapeDataString(email)}", null, ct);
        return response.StatusCode switch
        {
            HttpStatusCode.OK => null,
            HttpStatusCode.TooManyRequests => "Too many requests. Wait a few minutes and try again.",
            _ => "The sign-in service is not available right now. Try again in a moment.",
        };
    }

    /// <summary>
    /// Sets the new password with the token from the reset link. Returns the message to show when it was refused; null when it was set.
    /// </summary>
    public async Task<string?> ResetPasswordAsync(string email, string token, string newPassword, CancellationToken ct)
    {
        using var response = await _http.PostAsJsonAsync("account/reset-password", new { email, token, newPassword }, ct);
        if (response.IsSuccessStatusCode)
            return null;
        if (response.StatusCode == HttpStatusCode.TooManyRequests)
            return "Too many attempts. Wait a few minutes and try again.";
        return ErrorOf(await response.Content.ReadAsStringAsync(ct)) ?? "The link is invalid or has expired. Request a new one.";
    }

    private static string? ErrorOf(string body)
    {
        try
        {
            using var document = JsonDocument.Parse(body);
            return document.RootElement.TryGetProperty("error", out var error) && error.ValueKind == JsonValueKind.String
                ? error.GetString()
                : null;
        }
        catch (JsonException)
        {
            return null;
        }
    }
}
