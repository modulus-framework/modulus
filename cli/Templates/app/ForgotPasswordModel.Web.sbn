using System.ComponentModel.DataAnnotations;
using Microsoft.AspNetCore.Mvc;
using Microsoft.AspNetCore.Mvc.RazorPages;
using Microsoft.AspNetCore.RateLimiting;
using {{ root_namespace }}.Web.Configuration;
using {{ root_namespace }}.Web.Services.ApiClients;

namespace {{ root_namespace }}.Web.Pages.Account;

/// <summary>
/// Asks for a password reset link. The same confirmation is shown whether or not the address has an account, so the page cannot be used to
/// find out who has one.
/// </summary>
[EnableRateLimiting(RateLimitingSetup.SignInPolicy)]
public sealed class ForgotPasswordModel(AccountApiClient accounts) : PageModel
{
    [BindProperty]
    [Required(ErrorMessage = "Enter the email address of your account.")]
    [EmailAddress(ErrorMessage = "Enter a valid email address.")]
    public string Email { get; set; } = "";

    /// <summary>The message when the request could not be made (the rate limit, or the sign-in service is down).</summary>
    public string? Error { get; private set; }

    /// <summary>True once the request was accepted: the page then confirms, without saying whether an account exists.</summary>
    public bool Sent { get; private set; }

    public void OnGet()
    {
    }

    public async Task<IActionResult> OnPostAsync(CancellationToken ct)
    {
        if (!ModelState.IsValid)
            return Page();

        Error = await accounts.RequestResetAsync(Email.Trim(), ct);
        Sent = Error is null;
        return Page();
    }
}
