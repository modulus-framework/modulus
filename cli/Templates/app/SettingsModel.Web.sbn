using System.Net;
using System.Text.Json;
using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;
using Microsoft.AspNetCore.Mvc.RazorPages;
using Modulus.Settings;
{{ if multi_tenancy }}using {{ root_namespace }}.Web.Security;{{ end }}
using {{ root_namespace }}.Web.Services.ApiClients;

namespace {{ root_namespace }}.Web.Pages.Admin;

/// <summary>
/// Settings administration (premodule 5): lists the registered settings with their effective value and source, and writes a value at a scope.
/// A pinned setting is shown read-only. Every change is a call to the API, which checks the permission and the value; the page shows the
/// API's answer, including a refused value's message, and decides nothing itself.
/// </summary>
[Authorize]
public sealed class SettingsModel(SettingsApiClient settings) : PageModel
{
    private static readonly JsonSerializerOptions s_json = new(JsonSerializerDefaults.Web);

    public IReadOnlyList<SettingView> Rows { get; private set; } = [];

    /// <summary>The rows under their definition group (ungrouped settings are under General, last).</summary>
    public IReadOnlyList<SettingGroup> Groups { get; private set; } = [];

    public sealed record SettingGroup(string Name, IReadOnlyList<SettingView> Rows);

    public string? Message { get; private set; }

{{ if multi_tenancy }}    /// <summary>Whether the person has chosen a branch (the branch cookie), so a branch-scoped value can be written.</summary>
    public bool HasBranch { get; private set; }

{{ end }}    public async Task OnGetAsync(CancellationToken ct)
    {
        Message = TempData["Message"] as string;
{{ if multi_tenancy }}        HasBranch = HasChosenBranch();
{{ end }}
        using var response = await settings.ListAsync(ct);
        if (response.IsSuccessStatusCode)
        {
            Rows = await response.Content.ReadFromJsonAsync<List<SettingView>>(s_json, ct) ?? [];
            Groups = GroupRows(Rows);
        }
        else
            Message = response.StatusCode == HttpStatusCode.Forbidden
                ? "You do not have permission to see the settings of this company."
                : Explain(response.StatusCode);
    }

    private static IReadOnlyList<SettingGroup> GroupRows(IReadOnlyList<SettingView> rows)
        => [.. rows
            .GroupBy(r => string.IsNullOrWhiteSpace(r.Group) ? "General" : r.Group!, StringComparer.Ordinal)
            .OrderBy(g => g.Key == "General" ? 1 : 0)
            .ThenBy(g => g.Key, StringComparer.Ordinal)
            .Select(g => new SettingGroup(g.Key, [.. g]))];

    public async Task<IActionResult> OnPostSaveAsync(string? name, string? scope, string? value, CancellationToken ct)
    {
        using var response = await settings.SetAsync(scope ?? "", name ?? "", value, ct);
        return await Answered(response, "Setting saved.", ct);
    }

    public async Task<IActionResult> OnPostRemoveAsync(string? name, string? scope, CancellationToken ct)
    {
        using var response = await settings.RemoveAsync(scope ?? "", name ?? "", ct);
        return await Answered(response, "Setting removed.", ct);
    }

    private async Task<IActionResult> Answered(HttpResponseMessage response, string success, CancellationToken ct)
    {
        TempData["Message"] = response.IsSuccessStatusCode ? success : await Refusal(response, ct);
        return RedirectToPage();
    }

{{ if multi_tenancy }}    /// <summary>The branch cookie names a branch the person picked. The API still checks it against their organizational scope.</summary>
    private bool HasChosenBranch()
        => Request.Cookies.TryGetValue(BffGatewayHandler.BranchCookie, out var branch) && Guid.TryParse(branch, out _);

{{ end }}    /// <summary>The API's reason for a refusal: a value's own message when it names one, else the status.</summary>
    private static async Task<string> Refusal(HttpResponseMessage response, CancellationToken ct)
    {
        if (response.StatusCode == HttpStatusCode.BadRequest)
        {
            using var problem = JsonDocument.Parse(await response.Content.ReadAsStringAsync(ct));
            if (problem.RootElement.TryGetProperty("errors", out var errors) && errors.TryGetProperty("value", out var messages))
                return string.Join(' ', messages.EnumerateArray().Select(m => m.GetString()));
            if (problem.RootElement.TryGetProperty("detail", out var detail) && detail.GetString() is { Length: > 0 } text)
                return text;
        }
        return Explain(response.StatusCode);
    }

    private static string Explain(HttpStatusCode status) => status switch
    {
        HttpStatusCode.Unauthorized => "Your session has ended. Sign in again.",
        HttpStatusCode.Forbidden => "You do not have permission to change this setting. A global value needs settings:global:manage.",
        HttpStatusCode.Conflict => "This setting is pinned by the host and cannot be changed.",
        HttpStatusCode.NotFound => "No setting has that name.",
        HttpStatusCode.BadRequest => "The value or scope was refused.",
        _ => $"The API answered {(int)status}.",
    };
}
