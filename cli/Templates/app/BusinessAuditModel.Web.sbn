using System.Net;
using System.Text.Json;
using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;
using Microsoft.AspNetCore.Mvc.RazorPages;
using {{ root_namespace }}.Web.Services.ApiClients;

namespace {{ root_namespace }}.Web.Pages.Admin;

/// <summary>
/// The business audit page (<c>audit:view</c>): searches the company's business audit entries by entity, actor, action and time. Every search is
/// a call to the API, which checks the permission and the company. The page shows the API's answer and decides nothing itself.
/// </summary>
[Authorize]
public sealed class BusinessAuditModel(BusinessAuditApiClient audit) : PageModel
{
    private static readonly JsonSerializerOptions s_json = new(JsonSerializerDefaults.Web);

    [BindProperty(SupportsGet = true)]
    public string? Entity { get; set; }

    [BindProperty(SupportsGet = true)]
    public string? Actor { get; set; }

    [BindProperty(SupportsGet = true)]
    public string? Action { get; set; }

    [BindProperty(SupportsGet = true)]
    public string? Since { get; set; }

    [BindProperty(SupportsGet = true)]
    public string? Until { get; set; }

    [BindProperty(SupportsGet = true)]
    public int PageNumber { get; set; } = 1;

    public IReadOnlyList<BusinessAuditRow> Rows { get; private set; } = [];

    public int TotalCount { get; private set; }

    public int PageSize { get; private set; } = 50;

    public string? Message { get; private set; }

    public async Task OnGetAsync(CancellationToken ct)
    {
        Message = TempData["Message"] as string;
        using var response = await audit.SearchAsync(Entity, Actor, Action, Since, Until, Math.Max(PageNumber, 1), ct);
        if (response.IsSuccessStatusCode)
        {
            var page = await response.Content.ReadFromJsonAsync<BusinessAuditPage>(s_json, ct);
            Rows = page?.Items ?? [];
            TotalCount = page?.TotalCount ?? 0;
            PageSize = page?.PageSize ?? PageSize;
        }
        else
        {
            Message = Explain(response.StatusCode);
        }
    }

    public bool HasPrevious => PageNumber > 1;

    public bool HasNext => PageNumber * PageSize < TotalCount;

    private static string Explain(HttpStatusCode status) => status switch
    {
        HttpStatusCode.Unauthorized => "Your session has ended. Sign in again.",
        HttpStatusCode.Forbidden => "You do not have permission to read the business audit log (audit:view).",
        HttpStatusCode.BadRequest => "A filter is not valid. Check the dates (for example 2026-10-01 or 2026-10-01T09:00:00Z) and the actor id.",
        _ => $"The API answered {(int)status}.",
    };
}
