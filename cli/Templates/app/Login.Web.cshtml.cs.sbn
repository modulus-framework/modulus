namespace {{ root_namespace }}.Web.Pages.Account;

using System.ComponentModel.DataAnnotations;
using System.Text.Json;
using Microsoft.AspNetCore.Authentication;
using Microsoft.AspNetCore.Authentication.Cookies;
using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;
using Microsoft.AspNetCore.Mvc.RazorPages;

/// <summary>
/// HTTP-based login for webapp+api split: POSTs credentials to the API's /connect/token endpoint,
/// stores the returned tokens in an auth cookie, and redirects. No local database access.
/// </summary>
[AllowAnonymous]
public sealed class LoginModel(IHttpClientFactory httpClientFactory) : PageModel
{
    private readonly IHttpClientFactory _httpClientFactory = httpClientFactory;

    private const string ApiTokenEndpoint = "/connect/token";  // Relative to the API base URL

    [BindProperty]
    public InputModel Input { get; set; } = new();

    public string? ReturnUrl { get; set; }
    public string? ErrorMessage { get; set; }

    public void OnGet(string? returnUrl = null)
    {
        ReturnUrl = returnUrl;
    }

    public async Task<IActionResult> OnPostAsync(string? returnUrl = null)
    {
        ReturnUrl = returnUrl;
        if (!ModelState.IsValid)
            return Page();

        // Call the API's token endpoint using the password grant.
        var apiBaseUrl = GetApiBaseUrl();
        var tokenUrl = new Uri(new Uri(apiBaseUrl), ApiTokenEndpoint).ToString();

        var client = _httpClientFactory.CreateClient();
        var request = new HttpRequestMessage(HttpMethod.Post, tokenUrl)
        {
            Content = new FormUrlEncodedContent(new Dictionary<string, string>
            {
                { "grant_type", "password" },
                { "client_id", "{{ app_name_lower }}" },
                { "username", Input.Email },
                { "password", Input.Password },
                { "scope", "openid profile email offline_access" },
            })
        };

        try
        {
            var response = await client.SendAsync(request);
            if (!response.IsSuccessStatusCode)
            {
                ErrorMessage = "Invalid email or password.";
                return Page();
            }

            var content = await response.Content.ReadAsStringAsync();
            using var doc = JsonDocument.Parse(content);
            var root = doc.RootElement;

            if (!root.TryGetProperty("access_token", out var accessTokenElem))
            {
                ErrorMessage = "Sign-in failed (no token in response).";
                return Page();
            }

            var accessToken = accessTokenElem.GetString();
            var refreshToken = root.TryGetProperty("refresh_token", out var refreshTokenElem)
                ? refreshTokenElem.GetString()
                : null;
            var expiresIn = root.TryGetProperty("expires_in", out var expiresInElem)
                ? expiresInElem.GetInt32()
                : 3600;

            // Store tokens in an auth cookie (ASP.NET's cookie auth middleware + token refresh handler).
            // The TokenRelayHandler will read the access token from here on each API call.
            var authProps = new AuthenticationProperties
            {
                IsPersistent = Input.RememberMe,
                ExpiresUtc = DateTimeOffset.UtcNow.AddSeconds(expiresIn),
            };

            if (!string.IsNullOrEmpty(accessToken))
                authProps.StoreTokens(new[]
                {
                    new AuthenticationToken { Name = "access_token", Value = accessToken },
                });

            if (!string.IsNullOrEmpty(refreshToken))
                authProps.StoreTokens(new[]
                {
                    new AuthenticationToken { Name = "refresh_token", Value = refreshToken },
                });

            // Sign in the user (no claims here; the token itself is the proof).
            // A future step could call the API's /connect/userinfo to fetch claims.
            var principal = new System.Security.Claims.ClaimsPrincipal(
                new System.Security.Claims.ClaimsIdentity(
                    new[] { new System.Security.Claims.Claim("sub", Input.Email) },
                    CookieAuthenticationDefaults.AuthenticationScheme));

            await HttpContext.SignInAsync(
                CookieAuthenticationDefaults.AuthenticationScheme,
                principal,
                authProps);

            return LocalRedirectOrHome(returnUrl);
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Sign-in failed: {ex.Message}";
            return Page();
        }
    }

    private string GetApiBaseUrl()
    {
        // In Development, the API typically runs on port 5000 and the Web app on 5001.
        // In Production, they may be on different hosts (from configuration).
        // For now, use a hardcoded development default; a production app should
        // read this from appsettings or an environment variable.
        var scheme = HttpContext.Request.IsHttps ? "https" : "http";
        return $"{scheme}://localhost:5000";
    }

    private IActionResult LocalRedirectOrHome(string? returnUrl)
        => !string.IsNullOrEmpty(returnUrl) && Url.IsLocalUrl(returnUrl)
            ? LocalRedirect(returnUrl)
            : Redirect("~/");

    public sealed class InputModel
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = string.Empty;

        [Required]
        [DataType(DataType.Password)]
        public string Password { get; set; } = string.Empty;

        [Display(Name = "Remember me?")]
        public bool RememberMe { get; set; }
    }
}
