@page "/ResetPassword"
@model {{ root_namespace }}.Web.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Set a new password";
}
<div class="m-auth-card">
    <div class="m-auth-card-body">
        <h1 class="m-auth-title">Set a new password</h1>
        @if (!Model.HasToken)
        {
            <app-alert type="error" show-icon message="This link is incomplete. Request a new one." class="m-mb-16" />
            <p class="m-auth-hint" style="text-align: center;"><a href="/Account/ForgotPassword">Request a new link</a></p>
        }
        else
        {
            <p class="m-auth-hint">Choose a new password for your account. The link works once.</p>
            @if (!string.IsNullOrEmpty(Model.Error))
            {
                <app-alert type="error" show-icon message="@Model.Error" class="m-mb-16" />
            }
            <form method="post" class="ant-form ant-form-vertical ant-form-hide-required-mark" novalidate>
                <input type="hidden" asp-for="Token" />
                <app-form-item asp-for="Email" label="Email">
                    <app-input asp-for="Email" type="email" autocomplete="username" prefix-icon="user" />
                </app-form-item>
                <app-form-item asp-for="NewPassword" label="New password">
                    <app-input asp-for="NewPassword" type="password" autocomplete="new-password" prefix-icon="lock" />
                </app-form-item>
                <app-form-item asp-for="ConfirmPassword" label="Confirm the new password">
                    <app-input asp-for="ConfirmPassword" type="password" autocomplete="new-password" prefix-icon="lock" />
                </app-form-item>
                <div class="m-auth-actions">
                    <app-button type="primary" html-type="submit" block>Set the new password</app-button>
                </div>
            </form>
        }
    </div>
</div>
