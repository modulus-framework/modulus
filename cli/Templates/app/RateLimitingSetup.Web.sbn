using System.Threading.RateLimiting;
using Microsoft.AspNetCore.RateLimiting;

namespace {{ root_namespace }}.Web.Configuration;

/// <summary>
/// Rate limits for the web host's sign-in. Password attempts have a tighter limit of their own, so credential guessing is braked
/// at the host that takes the password, not only by the API's limits. Pages carry no limit.
/// </summary>
internal static class RateLimitingSetup
{
    /// <summary>Named policy for the sign-in page: 10 attempts per minute per client IP address.</summary>
    public const string SignInPolicy = "sign-in";

    public static IServiceCollection AddWebRateLimiting(this IServiceCollection services)
    {
        services.AddRateLimiter(options =>
        {
            options.RejectionStatusCode = StatusCodes.Status429TooManyRequests;
            options.AddPolicy(SignInPolicy, context => RateLimitPartition.GetFixedWindowLimiter(
                context.Connection.RemoteIpAddress?.ToString() ?? "unknown",
                _ => new FixedWindowRateLimiterOptions
                {
                    PermitLimit = 10,
                    Window = TimeSpan.FromMinutes(1),
                    QueueLimit = 0,
                }));
        });

        return services;
    }
}
