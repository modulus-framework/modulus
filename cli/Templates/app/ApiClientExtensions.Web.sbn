using Microsoft.Extensions.DependencyInjection;
{{ if use_auth }}using Modulus.Bff;
{{ end }}using Modulus.Platform.Http;
using {{ root_namespace }}.Web.ApiClients;

namespace {{ root_namespace }}.Web;

/// <summary>
/// Typed clients for the API project's module endpoints, one per module.
/// Each gets the standard resilience pipeline (retry, circuit breaker,
/// timeouts) and the correlation handler from <see cref="HttpClientExtensions.AddModulusHttpClient"/>{{ if use_auth }},
/// plus the signed-in user's access token from the BFF web session
/// (<c>AddBffUserAccessToken</c>: refreshed before it expires, one refresh per
/// session at a time, refreshed and replayed once on a 401){{ else }}.
/// No authentication is configured, so the clients call the API anonymously{{ end }}.
/// </summary>
public static class ApiClientExtensions
{
    public static IServiceCollection AddModuleApiClients(this IServiceCollection services)
    {
{{~ if !no_example ~}}
        services.AddModulusHttpClient<{{ example_entity }}ApiClient>(){{ if use_auth }}
            .AddBffUserAccessToken(){{ end }};
{{~ end ~}}

        return services;
    }
}
