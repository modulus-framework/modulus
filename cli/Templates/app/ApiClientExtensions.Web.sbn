using Microsoft.Extensions.DependencyInjection;
{{ if use_auth }}using {{ root_namespace }}.Web.Security;
{{ end }}using Modulus.Platform.Http;
{{ if !no_example }}using {{ root_namespace }}.Web.Services.ApiClients;
{{ end }}
namespace {{ root_namespace }}.Web.Services;

/// <summary>
/// Typed clients for the API project's module endpoints, one per module.
/// Each gets the standard resilience pipeline (retry, circuit breaker,
/// timeouts) and the correlation handler from <see cref="HttpClientExtensions.AddModulusHttpClient"/>{{ if use_auth }},
/// plus the BFF gateway handler: each call goes through the BFF's <c>/api</c> route and carries the browser's BFF
/// session cookie (the BFF holds the access token and refreshes it){{ else }}.
/// No authentication is configured, so the clients call the API anonymously{{ end }}.
/// </summary>
public static class ApiClientExtensions
{
    public static IServiceCollection AddModuleApiClients(this IServiceCollection services)
    {
{{~ if !no_example ~}}
{{~ if use_auth ~}}
        services.AddBffGatewayClient<{{ example_entity }}ApiClient>();
{{~ else ~}}
        services.AddModulusHttpClient<{{ example_entity }}ApiClient>();
{{~ end ~}}
{{~ end ~}}

        return services;
    }
}
