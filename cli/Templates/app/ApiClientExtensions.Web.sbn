using Microsoft.Extensions.DependencyInjection;
{{ if use_auth }}using {{ root_namespace }}.Web.Security;
{{ end }}using Modulus.Platform.Http;
using {{ root_namespace }}.Web.Services.ApiClients;

namespace {{ root_namespace }}.Web.Services;

/// <summary>
/// Typed clients for the API project's module endpoints, one per module.
/// Each gets the standard resilience pipeline (retry, circuit breaker,
/// timeouts) and the correlation handler from <see cref="HttpClientExtensions.AddModulusHttpClient"/>{{ if use_auth }},
/// plus the BFF gateway handler: each call goes through the BFF's <c>/api</c> route and carries the browser's BFF
/// session cookie (the BFF holds the access token and refreshes it){{ else }}.
/// No authentication is configured, so the clients call the API anonymously{{ end }}.
/// </summary>
public static class ApiClientExtensions
{
    public static IServiceCollection AddModuleApiClients(this IServiceCollection services)
    {
{{~ if !no_example ~}}
{{~ if use_auth ~}}
        services.AddBffGatewayClient<{{ example_entity }}ApiClient>();
{{~ else ~}}
        services.AddModulusHttpClient<{{ example_entity }}ApiClient>();
{{~ end ~}}
{{~ end ~}}
{{~ if use_auth ~}}
        services.AddBffGatewayClient<SettingsApiClient>();
        services.AddBffGatewayClient<AuditApiClient>();
        services.AddBffGatewayClient<BusinessAuditApiClient>();
        services.AddBffGatewayClient<CompanyAuditApiClient>();
        services.AddBffGatewayClient<RoleAdminApiClient>();
{{~ else ~}}
        services.AddModulusHttpClient<SettingsApiClient>();
        services.AddModulusHttpClient<AuditApiClient>();
        services.AddModulusHttpClient<BusinessAuditApiClient>();
        services.AddModulusHttpClient<CompanyAuditApiClient>();
        services.AddModulusHttpClient<RoleAdminApiClient>();
{{~ end ~}}
{{~ if auth == "openiddict" ~}}
        services.AddBffGatewayClient<NavigationMenuClient>();
        services.AddBffGatewayClient<UserAdminApiClient>();
        services.AddBffGatewayClient<PasskeyApiClient>();
        services.AddBffGatewayClient<ProfileApiClient>();
        // The branches the caller may see: the profile names the primary branch, and the branch picker (multi-company apps) lists them.
        services.AddBffGatewayClient<BranchApiClient>();
{{~ if multi_tenancy ~}}
        services.AddBffGatewayClient<CompanyApiClient>();
        services.AddBffGatewayClient<CompanyAdminApiClient>();
{{~ end ~}}
        services.AddModulusHttpClient<PasskeyLoginClient>().ConfigurePrimaryHttpMessageHandler(() => new SocketsHttpHandler { UseCookies = false });
        services.AddModulusHttpClient<AccountApiClient>().ConfigurePrimaryHttpMessageHandler(() => new SocketsHttpHandler { UseCookies = false });
{{~ end ~}}

        return services;
    }
}
