<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>{{ root_namespace }}.Web</RootNamespace>
    <!-- Two hosts, one solution: the API project serves the modules and data; this project is the
         browser-facing presentation host. The kind also lets `modulus ui add` / `modulus add-module`
         wire this project instead of the API one. -->
    <ModulusAppKind>webapp+api</ModulusAppKind>
    <UserSecretsId>{{ user_secrets_id }}-web</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Cobytelabs.Modulus.AspNetCore" Version="{{ framework_version }}" />
    <PackageReference Include="Cobytelabs.Modulus.Core" Version="{{ framework_version }}" />
    <PackageReference Include="Cobytelabs.Modulus.Platform" Version="{{ framework_version }}" />
    <PackageReference Include="Cobytelabs.Modulus.UI.Core" Version="{{ framework_version }}" />
    {{ if use_tabler_theme }}<PackageReference Include="Cobytelabs.Modulus.UI.Theme.Tabler" Version="{{ framework_version }}" />
    {{ end }}{{ if auth != "none" }}<!-- Permission checks behind the page guards and admin menus (ICurrentUser.HasPermission
         / the grant store) — no OpenIddict here: the token server lives in the API host. -->
    <PackageReference Include="Cobytelabs.Modulus.Identity" Version="{{ framework_version }}" />
    {{ end }}</ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../API/{{ root_namespace }}.Api/{{ root_namespace }}.Api.csproj" />
{{ if !no_example }}    <!-- DTOs the admin pages bind (the typed clients live in this project's ApiClients/). -->
    <ProjectReference Include="../../Modules/{{ root_namespace }}.Modules.{{ example_module }}/{{ root_namespace }}.Modules.{{ example_module }}.Application/{{ root_namespace }}.Modules.{{ example_module }}.Application.csproj" />
{{ end }}  </ItemGroup>

</Project>
