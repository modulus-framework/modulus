using Microsoft.AspNetCore.Mvc;
using Microsoft.AspNetCore.Mvc.RazorPages;
using Modulus.Bff.Tokens;

namespace {{ root_namespace }}.Web.Pages.Account;

/// <summary>
/// Ends the BFF web session: revokes the refresh and access tokens at the auth server (when it has a revocation
/// endpoint), removes them from the server-side store and deletes the cookie. With an OIDC login the browser then
/// visits the auth server's end-session page, so the user is signed out there too.
/// </summary>
public class LogoutModel(IBffSessionService session) : PageModel
{
    public async Task<IActionResult> OnGetAsync()
    {
        var endSessionUrl = await session.SignOutAsync(HttpContext, LoginModel.Client, "/Account/Login", HttpContext.RequestAborted);
        return endSessionUrl is null ? LocalRedirect("/Account/Login") : Redirect(endSessionUrl);
    }
}
