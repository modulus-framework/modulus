using Microsoft.AspNetCore.Mvc;
using Microsoft.AspNetCore.Mvc.RazorPages;
using {{ root_namespace }}.Web.Security;

namespace {{ root_namespace }}.Web.Pages.Account;

/// <summary>
/// Ends the BFF session: the BFF revokes the tokens it holds, and the BFF's Set-Cookie that clears the session cookie is
/// relayed to the browser. When the BFF returns an end-session URL (an OIDC provider), the browser visits it too and comes
/// back to the sign-in page.
/// </summary>
public class LogoutModel(BffSessionClient session) : PageModel
{
    public async Task<IActionResult> OnGetAsync()
    {
        var loginPage = $"{Request.Scheme}://{Request.Host}/Account/Login";
        var endSessionUrl = await session.SignOutAsync(loginPage, HttpContext.RequestAborted);
        return endSessionUrl is null ? LocalRedirect("/Account/Login") : Redirect(endSessionUrl);
    }
}
