using {{ root_namespace }}.Api.Modules;
using Modulus.AspNetCore.Extensions;
using Modulus.AspNetCore.Configuration;
using Modulus.AspNetCore.Correlation;
using Modulus.AspNetCore.DataProtection;
using Modulus.AspNetCore.Cors;
using Modulus.AspNetCore.FeatureFlags;
using Modulus.AspNetCore.Idempotency;
using Modulus.AspNetCore.OpenApi;
using Modulus.AspNetCore.HealthChecks;
using Modulus.AspNetCore.RateLimiting;
using Modulus.AspNetCore.Security;
using Modulus.AspNetCore.Versioning;
using Modulus.EntityFrameworkCore.Extensions;
using Modulus.Events.Extensions;
using Modulus.Mediator.Extensions;
{{ if auth == "openiddict" }}using Modulus.Identity.Extensions;
{{ end }}{{ if use_external_provider }}using {{ external_provider_namespace }};
{{ end }}using Microsoft.AspNetCore.HttpOverrides;
using Microsoft.Extensions.DependencyInjection;

var builder = WebApplication.CreateBuilder(args);

// ── Modulus Framework ──────────────────────────────────────────
builder.Services.AddModulus<{{ app_name }}HostModule>(builder.Configuration);
builder.Services.AddModulusExceptionHandling();

// ── API cross-cutting concerns (config-bound; see appsettings.json) ─
builder.Services.AddModulusCorrelation(builder.Configuration);
builder.Services.AddModulusIdempotency(builder.Configuration);
builder.Services.AddModulusApiVersioning(builder.Configuration);
builder.Services.AddModulusRateLimiting(builder.Configuration);
builder.Services.AddModulusCors(builder.Configuration);
builder.Services.AddModulusSecurityHeaders(builder.Configuration);

// Runtime feature flags bound to the "FeatureManagement" section. Gate a minimal-API
// endpoint with .RequireFeature("Flag"); MVC actions can use [FeatureGate("Flag")].
builder.Services.AddModulusFeatureFlags(builder.Configuration);

// Guard rail (Development/Staging only): fails startup if a connection string or
// other secret is committed to appsettings*.json instead of coming from environment
// variables, User Secrets, or a vault. Excludes Production to avoid false positives.
builder.Services.AddModulusSecretsGuard(builder.Configuration);

// ── Forwarded headers ──────────────────────────────────────────
// Required when behind a reverse proxy / load balancer so the app sees real
// client IPs and the correct scheme (https). Trusting all proxies is safe in
// containerised deployments where the network is controlled; tighten the
// KnownNetworks/KnownProxies lists if the app is reachable from untrusted
// networks directly.
builder.Services.Configure<ForwardedHeadersOptions>(options =>
{
    options.ForwardedHeaders = ForwardedHeaders.XForwardedFor | ForwardedHeaders.XForwardedProto;
    options.KnownIPNetworks.Clear();
    options.KnownProxies.Clear();
});

// Transparent at-rest encryption for [ProtectedPersonalData] string properties.
// Registers an IPersonalDataProtector backed by ASP.NET Data Protection (a key ring
// with automatic rotation); each module DbContext applies the value converter itself,
// so marking a property is all that's required. In production, persist the key ring
// outside the app (file share / DB / Key Vault) so restarts keep decrypting old data;
// for equality search on an encrypted field, set PersonalDataProtection:SearchHashKey
// via User Secrets or an environment variable and store an IPersonalDataProtector.Hash.
builder.Services.AddModulusPersonalDataProtection(builder.Configuration);

// ── Domain & integration events ────────────────────────────────
// Registers DomainEventDispatcher (required by each module's DbContext),
// the in-process event bus, and discovers handlers in the host assembly.
// Each module can call AddModulusEvents() with its own assemblies too.
builder.Services.AddModulusEvents(typeof({{ app_name }}HostModule).Assembly);

// ── CQRS pipeline ──────────────────────────────────────────────
// Behaviours are registered once here; each module registers its own
// handlers + its own DbContext + IUnitOfWork in its Module composition root.
builder.Services.AddMediator();

// ── MVC controllers (module Presentation assemblies) ───────────
builder.Services.AddControllers();
{{ if auth != "none" }}
// ── Authentication & Authorization ──────────────────────────────
{{ if auth == "openiddict" }}// Local OAuth2/OIDC token server (OpenIddict).
// Provides /connect/token, /connect/authorize, /connect/userinfo endpoints.
// Uses ephemeral development certificates in Development (see appsettings.Development.json).
// In Production, register real signing/encryption certificates via the configure callback.
// To add local user accounts (ASP.NET Identity + password grant), also call:
//   builder.Services.AddModulusIdentity<TContext, ModulusUser, ModulusRole>(builder.Configuration);
// To persist OpenIddict tokens/applications, also call:
//   builder.Services.AddModulusIdentityStore<TContext>();
builder.Services.AddModulusOpenIddict(builder.Configuration);
{{ else if use_external_provider }}// External identity provider ({{ external_provider_name }}).
// Validates bearer tokens issued by {{ external_provider_name }} via OIDC discovery /
// introspection. Configure the provider details under
// "{{ external_provider_config_key }}" in appsettings.json.
// Set ClientSecret via User Secrets or env var (never committed):
//   dotnet user-secrets set "{{ external_provider_config_key }}:ClientSecret" "your-secret"
builder.Services.AddAuthentication()
    .{{ external_provider_add_method }}(builder.Configuration);
{{ end }}{{ end }}
// ── OpenAPI ────────────────────────────────────────────────────
// Hardened document: metadata from the OpenApi config section + a JWT Bearer
// security scheme, with a padlock on operations that require authorization.
builder.Services.AddModulusOpenApi(builder.Configuration);

var app = builder.Build();

// ── Initialise each module's database on startup ───────────────
// Each module owns its own DbContext (registered via AddModuleDatabase in its
// composition root). In Production, Migrate applies authored migrations and fails
// fast if a module has none — every schema change must go through a migration.
// Outside Production (Development / Testing / Staging) we use MigrateOrCreate so a
// freshly generated app (and the integration-test harness) runs before you author
// the first migration.
// Author the first migration with:  modulus migrate add <Name> --module <Module>
await app.Services.MigrateModulusDatabasesAsync(
    app.Environment.IsProduction()
        ? DatabaseInitializationMode.Migrate
        : DatabaseInitializationMode.MigrateOrCreate);

// ── Middleware ─────────────────────────────────────────────────
// Order matters: forwarded headers first (so everything downstream sees the
// real client IP/scheme), then correlation (so every log line, span, and error
// carries the id), then security headers on every response, then error
// handling, CORS before auth, rate limiting after auth/tenant, then the module
// pipeline. Idempotency runs after UseModulus so the tenant is resolved before
// keys are scoped, and still wraps the controller so responses can be replayed.
app.UseForwardedHeaders();
app.UseModulusCorrelation();
app.UseModulusSecurityHeaders();
app.UseExceptionHandler();
app.UseModulusCors();
{{ if auth != "none" }}app.UseAuthentication();
app.UseAuthorization();
{{ end }}app.UseModulusRateLimiting();
app.UseModulus();
app.UseModulusIdempotency();

app.MapControllers();
app.MapModulusHealthChecks();

if (app.Environment.IsDevelopment())
{
    app.MapOpenApi();
}

app.Run();

// Exposes the implicit Program class so integration tests can boot this exact
// host via Modulus.Testing's ModulusWebAppFactory<Program>.
public partial class Program;
