{{ if !no_example }}using {{ root_namespace }}.Modules.{{ example_module }}.Infrastructure;
{{ end }}using System.Reflection;
{{ if expose_api }}using Modulus.AspNetCore.Endpoints;
{{ end }}using Modulus.AspNetCore.Extensions;
using Modulus.AspNetCore.Configuration;
using Modulus.AspNetCore.Cors;
using Modulus.AspNetCore.Correlation;
using Modulus.AspNetCore.DataProtection;
using Modulus.AspNetCore.FeatureFlags;
using Modulus.AspNetCore.HealthChecks;
{{ if expose_api }}using Modulus.AspNetCore.Http;
{{ end }}using Modulus.AspNetCore.Idempotency;
using Modulus.AspNetCore.Logging;
{{ if expose_api }}using Modulus.AspNetCore.OpenApi;
{{ end }}using Modulus.AspNetCore.RateLimiting;
using Modulus.AspNetCore.Security;
{{ if use_security_guard }}using Modulus.AspNetCore.Security.Policy;
using Modulus.AuditLogging.Security;
{{ end }}{{ if expose_api }}using Modulus.AspNetCore.Versioning;
{{ end }}{{ if example_permission || needs_fallback_authorization }}using Modulus.Authorization.Extensions;
{{ end }}using Modulus.Caching;
using Modulus.EntityFrameworkCore.Extensions;
using Modulus.Events.Extensions;
using Modulus.Mediator.Extensions;
{{ if auth == "openiddict" }}using {{ identity_namespace }}.Infrastructure;
{{ if multi_tenancy }}using {{ tenancy_namespace }}.Infrastructure;
using Modulus.MultiTenancy.EntityFrameworkCore;
using Modulus.MultiTenancy.Extensions;
using Modulus.Security;
{{ end }}using Modulus.Identity.Extensions;
using OpenIddict.Server.AspNetCore;
using OpenIddict.Validation.AspNetCore;
{{ end }}{{ if use_external_provider }}using {{ external_provider_namespace }};
{{ end }}using Microsoft.AspNetCore.HttpOverrides;
using Microsoft.Extensions.DependencyInjection;

var builder = WebApplication.CreateBuilder(args);

{{ if auth == "openiddict" }}// ── Token server (OpenIddict) ──────────────────────────────────
// Local OAuth2/OIDC token server: /connect/token, /connect/userinfo, /connect/revoke.
// The users, roles and token store live in the Identity module (AddModule<IdentityModule>() below),
// which is also what makes the API usable by external clients (mobile, desktop, other systems):
//   curl -d grant_type=password -d client_id={{ app_name_lower }} -d username=<email> -d password=<password> http://localhost:5000/connect/token
// then call the API with "Authorization: Bearer <access_token>".
// Development uses ephemeral certificates and the password grant (see appsettings.Development.json).
// Production: register real signing/encryption certificates in the callback below, serve over https, and
// turn on Identity:AllowPasswordFlow only if a trusted first-party client needs it (it is off by default:
// the password grant hands the user's credentials to the client).
builder.Services.AddModulusOpenIddict(builder.Configuration, options =>
{
    // Development runs over plain http on localhost; OpenIddict insists on https unless told otherwise.
    if (builder.Environment.IsDevelopment())
        options.UseAspNetCore().DisableTransportSecurityRequirement();
});
// Register it BEFORE AddModulus: the Identity module's AddModulusIdentity replaces the deny-everything
// password validator that AddModulusOpenIddict installs, and the later registration wins.
{{ end }}// ── Modulus Framework ──────────────────────────────────────────
// Modules are registered explicitly — this list is the single composition
// root. Registration order is authoritative: each module's PreConfigure →
// Configure → PostConfigure phases run in this order at startup, then
// InitializeAsync in this order, and ShutdownAsync in reverse.
builder.Services.AddModulus(builder.Configuration, modules =>
{
{{ if auth == "openiddict" }}    modules.AddModule<IdentityModule>();
{{ end }}{{ if multi_tenancy }}    modules.AddModule<TenancyModule>();
{{ end }}{{ if !no_example }}    modules.AddModule<{{ example_module }}Module>();
{{ end }}});
builder.Services.AddModulusExceptionHandling();

// ── Cross-cutting concerns (config-bound; see appsettings.json) ──────
{{ if enable_correlation }}builder.Services.AddModulusCorrelation(builder.Configuration);
{{ end }}{{ if expose_api && enable_idempotency }}builder.Services.AddModulusIdempotency(builder.Configuration);
{{ end }}{{ if expose_api && enable_api_versioning }}builder.Services.AddModulusApiVersioning(builder.Configuration);
{{ end }}{{ if expose_api && enable_rate_limiting }}builder.Services.AddModulusRateLimiting(builder.Configuration);
{{ end }}{{ if expose_api && enable_cors }}builder.Services.AddModulusCors(builder.Configuration);
{{ end }}{{ if enable_security_headers }}builder.Services.AddModulusSecurityHeaders(builder.Configuration);
{{ end }}{{ if expose_api }}// Brotli/gzip for API responses ("ResponseCompression" section; off over HTTPS unless EnableForHttps, see BREACH).
builder.Services.AddModulusResponseCompression(builder.Configuration);
{{ end }}
{{ if enable_feature_flags }}// Runtime feature flags bound to the "FeatureManagement" section. Gate a minimal-API
// endpoint with .RequireFeature("Flag"); MVC actions can use [FeatureGate("Flag")].
builder.Services.AddModulusFeatureFlags(builder.Configuration);
{{ end }}{{ if enable_secrets_guard }}// Guard rail (Development/Staging only): fails startup if a connection string or
// other secret is committed to appsettings*.json instead of coming from environment
// variables, User Secrets, or a vault. Excludes Production to avoid false positives.
builder.Services.AddModulusSecretsGuard(builder.Configuration);
{{ end }}
// ── Log redaction ──────────────────────────────────────────────
// Values classified with [PersonalInformation], [ProtectedPersonalData], [ConfidentialData], [RestrictedData] or
// [SecretData] are redacted in source-generated logs ([LoggerMessage]); settings: Security:Redaction (the HMAC key that
// pseudonymizes personal data comes from user secrets or the environment). Analyzer MOD0002 flags a classified value
// passed to an ordinary LogInformation(...) call.
builder.Services.AddModulusRedaction(builder.Configuration);

// ── Forwarded headers ──────────────────────────────────────────
// Required when behind a reverse proxy / load balancer so the app sees real
// client IPs and the correct scheme (https). Only the proxies you name are trusted:
// set ForwardedHeaders:KnownNetworks (e.g. "10.0.0.0/8") or KnownProxies to your load
// balancer. Trusting every sender would let any caller choose the address the
// per-IP rate limiter and the audit trail see.
builder.Services.Configure<ForwardedHeadersOptions>(options =>
{
    options.ForwardedHeaders = ForwardedHeaders.XForwardedFor | ForwardedHeaders.XForwardedProto;
    // Trust only the proxies named in ForwardedHeaders:KnownProxies / KnownNetworks (appsettings or the environment).
    // With none configured only loopback is trusted, so a client cannot choose the address the rate limiter and audit see.
    options.ApplyModulusTrustedProxies(builder.Configuration);
});

{{ if enable_personal_data_protection }}// Transparent at-rest encryption for [ProtectedPersonalData] string properties.
// Registers an IPersonalDataProtector backed by ASP.NET Data Protection (a key ring
// with automatic rotation); each module DbContext applies the value converter itself,
// so marking a property is all that's required. In production, persist the key ring
// outside the app (file share / DB / Key Vault) so restarts keep decrypting old data;
// for equality search on an encrypted field, set PersonalDataProtection:SearchHashKey
// via User Secrets or an environment variable and store an IPersonalDataProtector.Hash.
builder.Services.AddModulusPersonalDataProtection(builder.Configuration);
{{ end }}
// ── Domain & integration events ────────────────────────────────
// Registers DomainEventDispatcher (required by each module's DbContext),
// the in-process event bus, and discovers handlers in the host assembly.
// Each module can call AddModulusEvents() with its own assemblies too.
builder.Services.AddModulusEvents(typeof(Program).Assembly);

// ── Hybrid cache (FusionCache) ─────────────────────────────────
// ICacheService plus the [CacheFor] query cache: in-memory L1 per node,
// stampede protection, fail-safe and tag invalidation ([InvalidatesCache] on
// commands). Settings live under "Caching:Fusion"; give each service its own
// CacheName when several share one Redis.
{{ if use_redis_cache }}// Redis is the shared L2 and the backplane that keeps every replica's L1 in sync.
builder.Services.AddRedisFusionCache(builder.Configuration);
{{ else }}// Single node: L1 only. Re-run with '--caching redis' (or call AddRedisFusionCache
// from Modulus.Caching.Redis) once you run more than one replica.
builder.Services.AddModulusFusionCache(builder.Configuration);
{{ end }}
// ── CQRS pipeline ──────────────────────────────────────────────
// Behaviours are registered once here; each module registers its own
// handlers + its own DbContext + IUnitOfWork in its Module composition root.
builder.Services.AddMediator();

{{ if expose_api }}// ── MVC controllers (module Presentation assemblies) ───────────
builder.Services.AddControllers();
{{ end }}
{{ if auth == "none" }}
// ── Authentication ─────────────────────────────────────────────
// None is registered. Endpoints require an authenticated user by default, so until you
// add a scheme every API call fails (500: no authentication scheme). Either register one
// here (e.g. builder.Services.AddAuthentication().AddJwtBearer(...) and, after
// app.UseExceptionHandler(), app.UseAuthentication()), re-generate with --auth openiddict
// or an external provider, or call AllowAnonymous() in an endpoint's Configure().
{{ end }}{{ if auth != "none" }}
// ── Authentication & Authorization ──────────────────────────────
{{ if auth == "openiddict" }}// API only: callers present a bearer token. AddModulusIdentity would otherwise make the cookie the default.
builder.Services.AddAuthentication(options =>
{
    options.DefaultScheme = OpenIddictValidationAspNetCoreDefaults.AuthenticationScheme;
    options.DefaultAuthenticateScheme = OpenIddictValidationAspNetCoreDefaults.AuthenticationScheme;
    options.DefaultChallengeScheme = OpenIddictValidationAspNetCoreDefaults.AuthenticationScheme;
});
{{ if example_permission }}
// The example API needs a permission, and the Admin role (seeded below) holds it: a signed-in caller without it gets 403.
// AddModulusAuthorization turns a "module:thing:action" name into a permission check, resolved from the grants of the caller's roles.
// The grants below are an in-memory seed: to edit them at run time (Permissions UI or API), keep them in the database with
// AddEfCoreAuthorizationStores (Modulus.Authorization.EntityFrameworkCore) instead.
builder.Services.AddModulusAuthorization();
builder.Services.AddGrantStorePermissionChecker();
builder.Services.AddPermissions("{{ example_module_lower }}", permissions => permissions.Add("{{ example_permission }}", "{{ example_permission_description }}"));
builder.Services.AddPermissionGrants(grants => grants.GrantToRole("{{ admin_role }}", "{{ example_permission }}"));
{{ end }}{{ else if use_external_provider }}// External identity provider ({{ external_provider_name }}).
// Validates bearer tokens issued by {{ external_provider_name }} via OIDC discovery /
// introspection. Configure the provider details under
// "{{ external_provider_config_key }}" in appsettings.json.
// Set ClientSecret via User Secrets or env var (never committed):
//   dotnet user-secrets set "{{ external_provider_config_key }}:ClientSecret" "your-secret"
builder.Services.AddAuthentication()
    .{{ external_provider_add_method }}(builder.Configuration);
{{ end }}{{ end }}{{ if use_security_guard }}
// ── Security guard ─────────────────────────────────────────────
{{ if needs_fallback_authorization }}// Closed by default: AddModulusAuthorization makes "a signed-in user" the fallback policy, so an endpoint that
// declares no policy of its own is not open.
builder.Services.AddModulusAuthorization();
{{ end }}// At startup every endpoint must resolve to a policy. An anonymous endpoint needs a reason (.Loosen(reason) on a
// minimal API, AllowAnonymous(reason) in an endpoint's Configure()) and, outside Development, an entry in
// security/loosening-allowlist.json; otherwise the app refuses to start (settings: Security:Guard).
builder.Services.AddModulusSecurityGuard(builder.Configuration);

// ── Security audit ─────────────────────────────────────────────
// Security decisions (refused sign-ins, issued, refused and revoked tokens, tenant rejections, cross-tenant SQL, the
// startup loosening report) are recorded as one tamper-evident hash chain per company. The chain lives in memory
// until a durable store is added (modulus add-audit-store); settings: Security:Audit.
builder.Services.AddModulusSecurityAudit(builder.Configuration);

{{ end }}{{ if multi_tenancy }}// ── Multi-tenancy (company = tenant) ───────────────────────────
// A token with a "tid" claim stays pinned to its company; a login without one selects a company with the X-Tenant-Id
// header (id or slug) and needs an active membership in it (TenantManager.AddMemberAsync / RemoveMemberAsync; the
// companies and memberships live in TenancyModule's database). No company selected = no tenant data (fail-closed).
builder.Services.AddMultiTenancy(tenancy => tenancy
    .UseJwtClaimResolver()
    .UseHeaderResolver()
    .RequireMembership());
// One view of who is calling, for which company and branch (X-Branch-Id, checked against the caller's org scope).
builder.Services.AddModulusSecurityContext();

{{ end }}{{ if expose_api }}// ── OpenAPI ────────────────────────────────────────────────────
// Hardened document: metadata from the OpenApi config section + a JWT Bearer
// security scheme, with a padlock on operations that require authorization.
builder.Services.AddModulusOpenApi(builder.Configuration);
{{ end }}

var app = builder.Build();

// ── Initialise each module's database on startup ───────────────
// Each module owns its own DbContext (registered via AddModuleDatabase in its
// composition root). In Production, Migrate applies authored migrations and fails
// fast if a module has none — every schema change must go through a migration.
// Outside Production (Development / Testing / Staging) we use MigrateOrCreate so a
// freshly generated app (and the integration-test harness) runs before you author
// the first migration. Modules whose schema is managed externally (dbsh —
// registered via .ExternallyManaged<TContext>()) are skipped here; apply theirs
// with `modulus migrate update`.
// Author the first migration with:  modulus migrate add <Name> --module <Module>
{{ if multi_tenancy }}// The tenant store (companies, memberships) is not a module context: it is migrated on its own, first.
await app.Services.MigrateTenantStoreAsync(ensureCreatedIfNoMigrations: !app.Environment.IsProduction());
{{ end }}await app.Services.MigrateModulusDatabasesAsync(
    app.Environment.IsProduction()
        ? DatabaseInitializationMode.Migrate
        : DatabaseInitializationMode.MigrateOrCreate);
{{ if auth == "openiddict" }}
// Roles, and the first administrator where that is safe (see IdentitySeeding).
await app.Services.SeedIdentityAsync(app.Environment);
{{ end }}{{ if multi_tenancy }}// The default company and the administrators' memberships in it (see TenancySeeding).
await app.Services.SeedTenancyAsync(app.Environment);
{{ end }}
// ── Middleware ─────────────────────────────────────────────────
// Order matters: forwarded headers first (so everything downstream sees the
// real client IP/scheme), then correlation (so every log line, span, and error
// carries the id), then security headers on every response, then error
// handling, CORS before auth, rate limiting after auth/tenant, then the module
// pipeline{{ if expose_api }}. Idempotency runs after UseModulus so the tenant is resolved before
// keys are scoped, and still wraps the controller so responses can be replayed{{ end }}.
app.UseForwardedHeaders();
{{ if expose_api }}app.UseModulusResponseCompression();
{{ end }}{{ if enable_correlation }}app.UseModulusCorrelation();
{{ end }}{{ if enable_security_headers }}app.UseModulusSecurityHeaders();
{{ end }}app.UseExceptionHandler();
{{ if expose_api }}{{ if enable_cors }}app.UseModulusCors();
{{ end }}{{ end }}{{ if auth != "none" }}app.UseAuthentication();
{{ if multi_tenancy }}// The company is resolved (and the membership checked) once the caller is known, before authorization.
app.UseMultiTenancy();
app.UseModulusSecurityContext();
{{ end }}app.UseAuthorization();
{{ end }}{{ if expose_api }}{{ if enable_rate_limiting }}app.UseModulusRateLimiting();
{{ end }}{{ end }}app.UseModulus();
{{ if expose_api }}{{ if enable_idempotency }}app.UseModulusIdempotency();
{{ end }}
app.MapControllers();

// REPR endpoints (EndpointBase subclasses) contributed by module Presentation
// assemblies. `modulus add-module` adds ProjectReferences; the Presentation DLLs
// land in the bin directory and are discovered by naming convention.
// For explicit control, replace with app.MapModulusEndpoints(typeof(SomeEndpoints).Assembly).
app.MapModulusEndpoints(
    Directory.GetFiles(AppContext.BaseDirectory, "{{ root_namespace }}.Modules.*.Presentation.dll")
        .Select(Assembly.LoadFrom)
        .ToArray());
{{ end }}{{ if enable_health_checks }}app.MapModulusHealthChecks();
{{ end }}
if (app.Environment.IsDevelopment())
{
{{ if expose_api }}    app.MapOpenApi(){{ if use_security_guard }}.Loosen("OpenAPI document, mapped in Development only"){{ end }};
{{ end }}
}

app.Run();

// Exposes the implicit Program class so integration tests can boot this exact
// host via Modulus.Testing's ModulusWebAppFactory<Program>.
public partial class Program;

// Namespaced entry-point marker for the integration tests: in a webapp+api app
// both hosts expose a global Program, so the test project's
// ModulusWebAppFactory<TEntryPoint> generic argument is ambiguous — each host
// gets a namespaced marker instead (the Web host's is WebEntryPoint).
namespace {{ root_namespace }}.Api
{
    public sealed class ApiEntryPoint;
}
