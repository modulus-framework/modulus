using {{ root_namespace }}.Api.Composition;
using {{ root_namespace }}.Api.Configuration;
using {{ root_namespace }}.Api.Endpoints;
using {{ root_namespace }}.Api.Hosting;
using {{ root_namespace }}.Api.Middleware;
{{ if expose_api }}using {{ root_namespace }}.Api.OpenApi;
{{ end }}using {{ root_namespace }}.Api.Security;

var builder = WebApplication.CreateBuilder(args);

// The API host composes one setup file per concern (garments-erp's API layout). This file only composes them, in the order
// the pipeline depends on. Optional features (webhooks, realtime, GraphQL, gRPC, AI, audit store, ...) are added by the
// modulus CLI to Configuration/FeatureServicesSetup.cs and Endpoints/FeatureEndpoints.cs.
{{ if auth == "openiddict" }}// The token server first: the Identity module (registered by AddApiModules) replaces the deny-everything password validator it installs.
builder.AddApiTokenServer();
{{ end }}builder.AddApiModules();
builder.AddApiCore();
builder.AddApiAuthentication();
{{ if expose_api }}builder.AddApiOpenApi();
{{ end }}builder.AddApiFeatures();

var app = builder.Build();

// Each module's database is initialised (and seeded) before the first request.
await app.InitializeApiAsync();

app.UseApiPipeline();
app.MapApiEndpoints();

app.Run();

// Exposes the implicit Program class so integration tests can boot this exact
// host via Modulus.Testing's ModulusWebAppFactory<Program>.
public partial class Program;

// Namespaced entry-point marker for the integration tests: in a webapp+api app
// both hosts expose a global Program, so the test project's
// ModulusWebAppFactory<TEntryPoint> generic argument is ambiguous — each host
// gets a namespaced marker instead (the Web host's is WebEntryPoint).
namespace {{ root_namespace }}.Api
{
    public sealed class ApiEntryPoint;
}
