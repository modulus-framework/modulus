/// <summary>
/// Probes every endpoint of the API host: anonymous callers get 401, signed-in callers without the endpoint's
/// permission get 403. A new endpoint that forgets its policy fails this test (loosened endpoints are reviewed by
/// the startup guard and security/loosening-allowlist.json instead).
/// </summary>
public sealed class SecurityProbeTests(ModulusWebAppFactory<ApiEntryPoint> factory)
    : IClassFixture<ModulusWebAppFactory<ApiEntryPoint>>
{
    [Fact]
    public async Task Every_endpoint_rejects_callers_without_access()
    {
{{ if multi_tenancy }}        // A caller that selects a company it is not a member of gets 403 too.
        var foreign = await Companies.CreateAsync(factory.Services, "foreign");
        var report = await SecurityProbeSuite.RunAsync(factory, new SecurityProbeOptions { ForeignTenantId = foreign });
{{ else }}        var report = await SecurityProbeSuite.RunAsync(factory);
{{ end }}
        report.EnsureNoFailures();
    }
}
{{ end }}{{ if multi_tenancy }}
/// <summary>
/// Company = tenant: a row written in one company is invisible to another (not found by key, not listed, and an
/// IgnoreQueryFilters() query is refused). <c>modulus generate-crud</c> adds a test per entity to this project.
/// </summary>
public sealed class TenantIsolationTests(ModulusWebAppFactory<ApiEntryPoint> factory)
    : IClassFixture<ModulusWebAppFactory<ApiEntryPoint>>
{
{{ if !no_example }}    [Fact]
    public async Task {{ example_entity }}_rows_stay_in_their_company()
    {
        var owner = await Companies.CreateAsync(factory.Services, "owner");
        var other = await Companies.CreateAsync(factory.Services, "other");

        await factory.Services.AssertTenantIsolationAsync<{{ example_module }}DbContext, {{ example_entity }}>(
            new {{ example_entity }} { Name = "isolation" }, owner, other);
    }
{{ end }}
    [Fact]
    public async Task A_member_of_one_company_cannot_select_another()
    {
        var company = await Companies.CreateAsync(factory.Services, "members-only");
        var client = factory.CreateAuthenticatedClient(tenantId: company);

        var response = await client.GetAsync("/health/live");

        // The probe is anonymous-friendly; the tenant check applies to every request that selects a company.
        Assert.Equal(HttpStatusCode.Forbidden, response.StatusCode);
    }
}

/// <summary>Creates companies through the app's own tenant store (unique slugs, so tests never collide).</summary>
internal static class Companies
{
    public static async Task<Guid> CreateAsync(IServiceProvider services, string name)
    {
        await using var scope = services.CreateAsyncScope();
        var tenants = scope.ServiceProvider.GetRequiredService<TenantManager>();
        return (await tenants.CreateAsync($"{name}-{Guid.NewGuid():N}", name)).TenantId;
    }
}
{{ end }}
{{ if kind_name == "webapp+api" || kind_name == "web" }}{{ web_entry = kind_name == "webapp+api" }}/// <summary>
/// Boots the{{ if web_entry }} split's Web host — a presentation shell only (no DbContexts, no
/// modules; pages call the API over HTTP){{ else }} web host{{ end }}. The assertions are adjusted for
/// the test harness: <see cref="ModulusWebAppFactory{TEntryPoint}"/> forces its
/// test scheme as the default challenge, so an anonymous hit on a protected
/// page comes back 401 (challenge happened) rather than the cookie scheme's
/// redirect — the redirect itself is exercised by the login flow in a browser.
/// </summary>
public sealed class WebAppSmokeTest(ModulusWebAppFactory<{{ if web_entry }}WebEntryPoint{{ else }}ApiEntryPoint{{ end }}> factory)
    : IClassFixture<ModulusWebAppFactory<{{ if web_entry }}WebEntryPoint{{ else }}ApiEntryPoint{{ end }}>>
{
    [Fact]
    public async Task Root_ChallengesAnonymousCallers()
    {
        var client = factory.CreateClient();

        var response = await client.GetAsync("/");

        Assert.Equal(HttpStatusCode.Unauthorized, response.StatusCode);
    }

    [Fact]
    public async Task LoginPage_IsAnonymous()
    {
        var client = factory.CreateClient();

        var response = await client.GetAsync("/Account/Login");

        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
    }

    [Fact]
    public async Task SignedInUser_ReachesTheLandingPage()
    {
        var client = factory.CreateAuthenticatedClient();

        var response = await client.GetAsync("/");

        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
    }
}
{{ end }}
/// <summary>
/// Architecture tests that enforce module boundaries. These verify that your
/// modular monolith respects the module system: every integration event has a
/// stable transport name, modules do not cross-reference each other's internals,
/// and the dependency graph is clean.
/// </summary>
public sealed class ModuleBoundaryTests
{
    // The rules scan the assemblies loaded in the test process, and the runtime loads one only when something first
    // uses it: load the app's own up front so the result does not depend on which test happened to run first.
    static ModuleBoundaryTests()
    {
        foreach (var path in Directory.GetFiles(AppContext.BaseDirectory, "{{ root_namespace }}.*.dll"))
            System.Reflection.Assembly.LoadFrom(path);
    }

    [Fact]
    public void AllIntegrationEvents_HaveExplicitNames()
    {
        // Enforces that every IIntegrationEvent crossing a module boundary
        // is decorated with [IntegrationEventName] for stable wire format.
        var unnamed = ModuleBoundaryRules.FindUnnamedIntegrationEvents();
        unnamed.Should().BeEmpty(
            because: "integration events must carry [IntegrationEventName] " +
                     "for stable serialization across module boundaries");
    }

    [Fact]
    public void IntegrationEventNames_AreWellFormedAndUnique()
    {
        ModuleBoundaryRules.FindMalformedIntegrationEventNames().Should().BeEmpty(
            because: "event names must read module.event.vN");
        ModuleBoundaryRules.FindDuplicateIntegrationEventNames().Should().BeEmpty(
            because: "two events under one name would shadow each other on the broker and in the outbox");
    }

    // The caller-file attribute lives on a helper: xUnit1001 forbids parameters on a [Fact].
    private static string ContractFile([System.Runtime.CompilerServices.CallerFilePath] string? thisFile = null)
        => Path.Combine(Path.GetDirectoryName(thisFile ?? Directory.GetCurrentDirectory())!, "integration-events.contract");

    [Fact]
    public void IntegrationEventContract_IsNotBroken()
    {
        // The wire name of an event is derived from its type name. Renaming the type (or dropping the event) would orphan
        // stored outbox rows and subscribers, so a name that disappears fails here. New events are recorded automatically;
        // set MODULUS_ACCEPT_EVENT_CONTRACT=1 to accept a deliberate removal.
        var file = ContractFile();
        var changes = ModuleBoundaryRules.FindIntegrationEventContractChanges(file);
        var accept = Environment.GetEnvironmentVariable("MODULUS_ACCEPT_EVENT_CONTRACT") == "1";

        if (!accept)
        {
            changes.Where(c => c.StartsWith("REMOVED", StringComparison.Ordinal)).Should().BeEmpty(
                because: "an event name that disappears breaks stored messages and subscribers");
        }

        if (changes.Count > 0)
            ModuleBoundaryRules.WriteIntegrationEventContract(file);
    }

    [Fact]
    public void AllModules_CanBeInstantiated()
    {
        // Verifies all IModule implementations can be instantiated without
        // circular dependency errors in the dependency graph.
        var modules = ModuleBoundaryRules.FindModuleTypes();
        modules.Should().NotBeEmpty(because: "at least one module should exist");
    }
}
