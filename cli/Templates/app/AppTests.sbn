/// <summary>
/// The Web→BFF→API hop. The Web factory is paired with the BFF factory, and the BFF with the API factory
/// (<c>PairedWith</c>), so the Web host's outbound HTTP (its session calls to the BFF, and the BFF's password grant
/// against the token server) reaches the TestServers instead of the network. A wrong password is refused and the login
/// page re-renders; the right one signs in and redirects.
/// </summary>
public sealed class WebToApiLoginTests
{
    private const string AdminEmail = "web-test-admin@example.test";
    private const string AdminPassword = "Web-Test-Passw0rd!42";

    [Fact]
    public async Task LoginPage_SignsInThroughTheBff()
    {
        await using var api = new ModulusWebAppFactory<ApiEntryPoint>().WithWebHostBuilder(builder =>
        {
            builder.UseSetting("Identity:Seed:AdminEmail", AdminEmail);
            builder.UseSetting("Identity:Seed:AdminPassword", AdminPassword);
        });
        // OpenIddict refuses plain HTTP; the paired handlers ignore the host, so https://localhost reaches each TestServer.
        await using var bff = new ModulusWebAppFactory<BffEntryPoint>().WithWebHostBuilder(builder =>
        {
            builder.UseSetting("Bff:Authority", "https://localhost");
            builder.UseSetting("Bff:Services:api:Address", "https://localhost");
        }).PairedWith(api);
        await using var web = new ModulusWebAppFactory<WebEntryPoint>().WithWebHostBuilder(builder =>
        {
            builder.UseSetting("Bff:BaseUrl", "https://localhost");
        }).PairedWith(bff);
        var client = web.CreateClient(new Microsoft.AspNetCore.Mvc.Testing.WebApplicationFactoryClientOptions { AllowAutoRedirect = false });

        var rejected = await SubmitLoginAsync(client, AdminEmail, "not-the-password");
        Assert.Equal(HttpStatusCode.OK, rejected.StatusCode);
        Assert.Contains("Invalid user name or password", await rejected.Content.ReadAsStringAsync());

        var accepted = await SubmitLoginAsync(client, AdminEmail, AdminPassword);
        Assert.Equal(HttpStatusCode.Redirect, accepted.StatusCode);
    }

{{ if !no_example }}    [Fact]
    public async Task CreatedProduct_IsListedThroughTheBffAndTheApi()
    {
        // The round trip through the whole stack: a {{ example_entity | string.downcase }} created on the Web page is stored by the API and read back by the
        // Web list page, through the BFF's session and proxy. The Web host, the BFF and the API run in-process, each paired to the next.
        await using var api = new ModulusWebAppFactory<ApiEntryPoint>().WithWebHostBuilder(builder =>
        {
            builder.UseSetting("Identity:Seed:AdminEmail", AdminEmail);
            builder.UseSetting("Identity:Seed:AdminPassword", AdminPassword);
            // The API validates the bearer token the BFF forwards: its default scheme is the token validation, not the test one.
            builder.ConfigureTestServices(services => services.PostConfigure<Microsoft.AspNetCore.Authentication.AuthenticationOptions>(options =>
            {
                options.DefaultScheme = "OpenIddict.Validation.AspNetCore";
                options.DefaultAuthenticateScheme = "OpenIddict.Validation.AspNetCore";
                options.DefaultChallengeScheme = "OpenIddict.Validation.AspNetCore";
                options.DefaultForbidScheme = "OpenIddict.Validation.AspNetCore";
            }));
        });
        await using var bff = new ModulusWebAppFactory<BffEntryPoint>().WithWebHostBuilder(builder =>
        {
            builder.UseSetting("Bff:Authority", "https://localhost");
            builder.UseSetting("Bff:Services:api:Address", "https://localhost");
            // The proxy (YARP) sends its own requests, outside IHttpClientFactory, so PairedWith does not reach it:
            // its forwarder goes to the API's TestServer instead.
            builder.ConfigureTestServices(services =>
            {
                services.RemoveAll<Yarp.ReverseProxy.Forwarder.IForwarderHttpClientFactory>();
                services.AddSingleton<Yarp.ReverseProxy.Forwarder.IForwarderHttpClientFactory>(new PairedForwarderFactory(api.Server.CreateHandler()));
            });
        }).PairedWith(api);
        await using var web = new ModulusWebAppFactory<WebEntryPoint>().WithWebHostBuilder(builder =>
        {
            builder.UseSetting("Bff:BaseUrl", "https://localhost");
            // The factory makes its test scheme the default, which would answer the page with 401 before the browser's BFF
            // session is checked. This page is signed in through the real cookie session, so the defaults go back to it.
            builder.ConfigureTestServices(services => services.PostConfigure<Microsoft.AspNetCore.Authentication.AuthenticationOptions>(options =>
            {
                options.DefaultScheme = "bff-session";
                options.DefaultAuthenticateScheme = "bff-session";
                options.DefaultChallengeScheme = "bff-session";
                options.DefaultForbidScheme = "bff-session";
            }));
        }).PairedWith(bff);
        // The session cookie is Secure: the client must address the host over https or it would not send it back.
        var client = web.CreateClient(new Microsoft.AspNetCore.Mvc.Testing.WebApplicationFactoryClientOptions
        {
            AllowAutoRedirect = false,
            BaseAddress = new Uri("https://localhost"),
        });

        var signedIn = await SubmitLoginAsync(client, AdminEmail, AdminPassword);
        Assert.Equal(HttpStatusCode.Redirect, signedIn.StatusCode);
{{ if multi_tenancy }}
        // Writes act in one company: the person picks it on the company page first, as they would in the browser.
        await ChooseFirstCompanyAsync(client);
{{ end }}
        var name = $"Round trip {Guid.NewGuid():N}";
        var created = await PostFormAsync(client, "/{{ example_route }}/new", new Dictionary<string, string> { ["Input.Name"] = name });
        var createdBody = await created.Content.ReadAsStringAsync();
        Assert.True(created.StatusCode == HttpStatusCode.Redirect, $"create answered {created.StatusCode}: {System.Text.RegularExpressions.Regex.Match(createdBody, "validation-summary[\\s\\S]{0,400}")}");

        var list = await client.GetStringAsync("/{{ example_route }}");
        Assert.Contains(name, list);
{{ if multi_tenancy }}
        // The branch picker (decision 14): a branch of the company is listed, chosen, and a branch outside the caller's scope is refused.
        var branchId = await CreateBranchAsync(api);
        Assert.Contains(branchId.ToString("D"), await client.GetStringAsync("/Branch"));

        var chosen = await PostFormAsync(client, "/Branch?handler=Switch", new Dictionary<string, string> { ["branchId"] = branchId.ToString("D") });
        Assert.Equal(HttpStatusCode.Redirect, chosen.StatusCode);
        Assert.Contains(branchId.ToString("D"), string.Join(";", chosen.Headers.GetValues("Set-Cookie")));
        Assert.Contains("Branch selected.", await client.GetStringAsync("/Branch"));

        var outOfScope = await PostFormAsync(client, "/Branch?handler=Switch", new Dictionary<string, string> { ["branchId"] = Guid.NewGuid().ToString("D") });
        Assert.Equal(HttpStatusCode.Redirect, outOfScope.StatusCode);
        Assert.Contains("That branch is not available to you.", await client.GetStringAsync("/Branch"));
{{ end }}

        // The admin pages run their API calls through the same session. A client that is not registered fails only when its page runs, so
        // every page is opened here.
        foreach (var path in new[] { "/Admin/Users", "/Admin/Roles", "/Admin/Audit", "/Admin/BusinessAudit", "/Admin/CompanyAudit", "/Admin/Settings"{{ if multi_tenancy }}, "/Admin/Companies", "/Company", "/Branch"{{ end }} })
        {
            using var page = await client.GetAsync(path);
            Assert.True(page.StatusCode == HttpStatusCode.OK, $"{path} answered {page.StatusCode}");
        }
    }

{{ end }}    [Fact]
    public async Task LoginPage_ExplainsWhenTheBffIsDown()
    {
        // Not paired: the authority points at a port nothing listens on, i.e. the API is down.
        await using var web = new ModulusWebAppFactory<WebEntryPoint>().WithWebHostBuilder(builder =>
        {
            builder.UseSetting("Bff:BaseUrl", "https://127.0.0.1:1");
        });
        var client = web.CreateClient(new Microsoft.AspNetCore.Mvc.Testing.WebApplicationFactoryClientOptions { AllowAutoRedirect = false });

        var response = await SubmitLoginAsync(client, AdminEmail, AdminPassword);

        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
        Assert.Contains("not available", await response.Content.ReadAsStringAsync());
    }

{{ if multi_tenancy }}    // A branch of the default company, made the way the organization admin API makes one: a unit in the hierarchy, with its profile.
    private static async Task<Guid> CreateBranchAsync(Microsoft.AspNetCore.Mvc.Testing.WebApplicationFactory<ApiEntryPoint> api)
    {
        await using var scope = api.Services.CreateAsyncScope();
        var company = await scope.ServiceProvider.GetRequiredService<Modulus.MultiTenancy.ITenantStore>()
            .FindBySlugAsync("default", CancellationToken.None)
            ?? throw new InvalidOperationException("The default company is not seeded.");
        using var inCompany = scope.ServiceProvider.GetRequiredService<Modulus.Core.Abstractions.ICurrentTenant>().Change(company);

        var branchId = Guid.NewGuid();
        await scope.ServiceProvider.GetRequiredService<Modulus.Authorization.EntityFrameworkCore.IOrgUnitAdministration>()
            .AddUnitAsync(branchId, [], CancellationToken.None);
        await scope.ServiceProvider.GetRequiredService<Modulus.Authorization.EntityFrameworkCore.EfOrganizationProfileStore>().SaveUnitAsync(
            new Modulus.Authorization.EntityFrameworkCore.OrgUnitProfile(branchId, "BR-1", "Main branch", "branch", false, null, null),
            DateTimeOffset.UtcNow, CancellationToken.None);
        return branchId;
    }

{{ end }}    private static async Task<HttpResponseMessage> PostFormAsync(HttpClient client, string path, Dictionary<string, string> fields)
    {
        // Razor Pages forms carry an anti-forgery token: read it from the page the form is on, then post it back.
        var page = await client.GetStringAsync(path);
        var token = System.Text.RegularExpressions.Regex
            .Match(page, "name=\"__RequestVerificationToken\"[^>]*value=\"([^\"]+)\"").Groups[1].Value;
        fields["__RequestVerificationToken"] = token;
        return await client.PostAsync(path, new FormUrlEncodedContent(fields));
    }
{{ if multi_tenancy }}
    private static async Task ChooseFirstCompanyAsync(HttpClient client)
    {
        // The company page lists the companies the person belongs to; each row posts its id back to the Switch handler.
        var page = await client.GetStringAsync("/company");
        var companyId = System.Text.RegularExpressions.Regex.Match(page, "name=\"companyId\" value=\"([^\"]+)\"").Groups[1].Value;
        Assert.NotEmpty(companyId);
        var token = System.Text.RegularExpressions.Regex
            .Match(page, "name=\"__RequestVerificationToken\"[^>]*value=\"([^\"]+)\"").Groups[1].Value;
        var switched = await client.PostAsync("/company?handler=Switch", new FormUrlEncodedContent(new Dictionary<string, string>
        {
            ["companyId"] = companyId,
            ["__RequestVerificationToken"] = token,
        }));
        Assert.Equal(HttpStatusCode.Redirect, switched.StatusCode);
    }
{{ end }}

    // Sends the proxy's requests to a TestServer handler (the paired API).
    private sealed class PairedForwarderFactory(HttpMessageHandler handler) : Yarp.ReverseProxy.Forwarder.IForwarderHttpClientFactory
    {
        public HttpMessageInvoker CreateClient(Yarp.ReverseProxy.Forwarder.ForwarderHttpClientContext context) => new(handler, disposeHandler: false);
    }

    private static async Task<HttpResponseMessage> SubmitLoginAsync(HttpClient client, string user, string password)
    {
        var page = await client.GetStringAsync("/Account/Login");
        var token = System.Text.RegularExpressions.Regex
            .Match(page, "name=\"__RequestVerificationToken\"[^>]*value=\"([^\"]+)\"").Groups[1].Value;
        var response = await client.PostAsync("/Account/Login", new FormUrlEncodedContent(new Dictionary<string, string>
        {
            ["UserName"] = user,
            ["Password"] = password,
            ["__RequestVerificationToken"] = token,
        }));
        // A failed sign-in is answered with the sign-in page itself (Razor Pages) or with a redirect back to it that carries the
        // error (Blazor): either way the page that explains it is the one returned.
        return response.Headers.Location?.OriginalString.Contains("error=", StringComparison.Ordinal) == true
            ? await client.GetAsync(response.Headers.Location)
            : response;
    }
}
{{ end }}{{ end }}
/// <summary>
/// Architecture tests that enforce module boundaries. These verify that your
/// modular monolith respects the module system: every integration event has a
/// stable transport name, modules do not cross-reference each other's internals,
/// and the dependency graph is clean.
/// </summary>
public sealed class ModuleBoundaryTests
{
    // The rules scan the assemblies loaded in the test process, and the runtime loads one only when something first
    // uses it: load the app's own up front so the result does not depend on which test happened to run first.
    static ModuleBoundaryTests()
    {
        foreach (var path in Directory.GetFiles(AppContext.BaseDirectory, "{{ root_namespace }}.*.dll"))
            System.Reflection.Assembly.LoadFrom(path);
    }

    [Fact]
    public void AllIntegrationEvents_HaveExplicitNames()
    {
        // Enforces that every IIntegrationEvent crossing a module boundary
        // is decorated with [IntegrationEventName] for stable wire format.
        var unnamed = ModuleBoundaryRules.FindUnnamedIntegrationEvents();
        unnamed.Should().BeEmpty(
            because: "integration events must carry [IntegrationEventName] " +
                     "for stable serialization across module boundaries");
    }

    [Fact]
    public void IntegrationEventNames_AreWellFormedAndUnique()
    {
        ModuleBoundaryRules.FindMalformedIntegrationEventNames().Should().BeEmpty(
            because: "event names must read module.event.vN");
        ModuleBoundaryRules.FindDuplicateIntegrationEventNames().Should().BeEmpty(
            because: "two events under one name would shadow each other on the broker and in the outbox");
    }

    // The caller-file attribute lives on a helper: xUnit1001 forbids parameters on a [Fact].
    private static string ContractFile([System.Runtime.CompilerServices.CallerFilePath] string? thisFile = null)
        => Path.Combine(Path.GetDirectoryName(thisFile ?? Directory.GetCurrentDirectory())!, "integration-events.contract");

    [Fact]
    public void IntegrationEventContract_IsNotBroken()
    {
        // The wire name of an event is derived from its type name. Renaming the type (or dropping the event) would orphan
        // stored outbox rows and subscribers, so a name that disappears fails here. New events are recorded automatically;
        // set MODULUS_ACCEPT_EVENT_CONTRACT=1 to accept a deliberate removal.
        var file = ContractFile();
        var changes = ModuleBoundaryRules.FindIntegrationEventContractChanges(file);
        var accept = Environment.GetEnvironmentVariable("MODULUS_ACCEPT_EVENT_CONTRACT") == "1";

        if (!accept)
        {
            changes.Where(c => c.StartsWith("REMOVED", StringComparison.Ordinal)).Should().BeEmpty(
                because: "an event name that disappears breaks stored messages and subscribers");
        }

        if (changes.Count > 0)
            ModuleBoundaryRules.WriteIntegrationEventContract(file);
    }

    [Fact]
    public void AllModules_CanBeInstantiated()
    {
        // Verifies all IModule implementations can be instantiated without
        // circular dependency errors in the dependency graph.
        var modules = ModuleBoundaryRules.FindModuleTypes();
        modules.Should().NotBeEmpty(because: "at least one module should exist");
    }

    [Fact]
    public void NoModule_UsesAnotherModulesDomainTypes()
    {
        // A module talks to another through its integration events and queries, not through its domain types.
        var violations = ModuleBoundaryRules.FindCrossModuleDomainTypeUsage();
        violations.Should().BeEmpty(because: "a module's domain types stay inside the module");
    }

    [Fact]
    public void NoModule_UsesAnotherModulesDbContext()
    {
        // A DbContext is a module's own storage; another module reaches its data through the module's queries.
        var violations = ModuleBoundaryRules.FindCrossModuleDbContextUsage();
        violations.Should().BeEmpty(because: "a module's DbContext is an implementation detail of that module");
    }
}
