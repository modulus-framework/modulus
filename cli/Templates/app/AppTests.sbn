/// <summary>
/// Smoke test that boots the Modulus module pipeline and resolves every
/// registered module DbContext, verifying the full module composition graph
/// (each module's DbContext options + DI registrations) is wired correctly.
/// </summary>
public sealed class AppSmokeTest
{
    [Fact]
    public void ModulePipeline_BootsAndResolvesModuleDbContexts()
    {
        var builder = Host.CreateApplicationBuilder();

        builder.Services.AddModulus(builder.Configuration, modules =>
        {
{{ if !no_example }}            modules.AddModule<{{ example_module }}Module>();
{{ end }}        });
        builder.Services.AddMediator();
        builder.Services.AddModulusEvents(typeof(ApiEntryPoint).Assembly);

        using var host = builder.Build();
        using var scope = host.Services.CreateScope();

        // Each module registers its own DbContext via AddModuleDatabase.
        // Resolving them all constructs the contexts (exercising options +
        // ctor deps) — any misconfiguration throws and fails the test.
        var contexts = scope.ServiceProvider
            .GetServices<DbContext>()
            .ToList();

{{ if !no_example }}        Assert.NotEmpty(contexts);
{{ end }}    }
}

{{ if expose_api }}/// <summary>
/// HTTP integration tests that drive the real host through
/// <see cref="ModulusWebAppFactory{TEntryPoint}"/>: the full middleware
/// pipeline (correlation, idempotency, …) is active and every module DbContext
/// runs against an isolated in-memory SQLite database — no real database needed.
/// </summary>
public sealed class ApiIntegrationTests(ModulusWebAppFactory<ApiEntryPoint> factory)
    : IClassFixture<ModulusWebAppFactory<ApiEntryPoint>>
{
    [Fact]
    public async Task Health_Live_ReturnsOk()
    {
        var client = factory.CreateClient();

        var response = await client.GetAsync("/health/live");

        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
    }
{{ if !no_example }}
{{ if auth != "none" }}    [Fact]
    public async Task Create{{ example_entity }}_ThenList_RoundTripsThroughTheHost()
    {
        // The endpoints need a signed-in caller{{ if example_permission }} holding "{{ example_permission }}", which the {{ admin_role }} role is granted in Program.cs{{ end }}.{{ if multi_tenancy }}
        // Rows belong to a company: the client acts in one (a token pinned to it with the "tid" claim).
        var company = await Companies.CreateAsync(factory.Services, "round-trip");
        var client = factory.CreateAuthenticatedClient({{ if example_permission }}roles: ["{{ admin_role }}"], {{ end }}tenantId: company, pinTenant: true);{{ else }}
        var client = factory.CreateAuthenticatedClient({{ if example_permission }}roles: ["{{ admin_role }}"]{{ end }});{{ end }}

        // POST creates a row in the (swapped) in-memory database…
        var created = await client.PostAsJsonAsync(
            "/api/{{ example_module_lower }}/{{ example_route }}", new { name = "smoke-test" });
        Assert.Equal(HttpStatusCode.Created, created.StatusCode);

        // …and it is readable back through the module's query pipeline.
        var list = await client.GetAsync("/api/{{ example_module_lower }}/{{ example_route }}");
        Assert.Equal(HttpStatusCode.OK, list.StatusCode);
    }
{{ end }}{{ if example_permission }}
    [Fact]
    public async Task {{ example_entity }}Api_RequiresSignIn_AndThePermission()
    {
        var url = "/api/{{ example_module_lower }}/{{ example_route }}";

        // Anonymous: challenged. Signed in without the permission: forbidden. The {{ admin_role }} role: allowed.
        Assert.Equal(HttpStatusCode.Unauthorized, (await factory.CreateClient().GetAsync(url)).StatusCode);
{{ if auth != "none" }}        Assert.Equal(HttpStatusCode.Forbidden, (await factory.CreateAuthenticatedClient().GetAsync(url)).StatusCode);
{{ if multi_tenancy }}        // A multi-company app answers only inside a company: the caller must select one (fail closed without it).
        var company = await Companies.CreateAsync(factory.Services, "permission");
        Assert.Equal(HttpStatusCode.OK, (await factory.CreateAuthenticatedClient(roles: ["{{ admin_role }}"], tenantId: company, pinTenant: true).GetAsync(url)).StatusCode);
{{ else }}        Assert.Equal(HttpStatusCode.OK, (await factory.CreateAuthenticatedClient(roles: ["{{ admin_role }}"]).GetAsync(url)).StatusCode);
{{ end }}{{ end }}    }
{{ end }}{{ end }}
}
