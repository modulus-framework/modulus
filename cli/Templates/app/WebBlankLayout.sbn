@* Full-page layout without the shell, for sign-in and status pages. *@
@inject Microsoft.Extensions.Options.IOptions<Modulus.Ui.Abstractions.Theming.ModulusThemeOptions> ThemeOptions
@{
    var title = ViewData["Title"] as string;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(title is null ? ThemeOptions.Value.Title : $"{title} · {ThemeOptions.Value.Title}")</title>
    <modulus-head />
</head>
<body modulus-antiforgery>
    @RenderBody()
    <modulus-scripts />
</body>
</html>
