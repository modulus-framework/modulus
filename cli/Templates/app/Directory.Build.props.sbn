<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Generated apps use explicit Versions on each PackageReference, so
         disable Central Package Management.  This also prevents the
         generated app from inheriting CPM settings from a parent repo
         (e.g. when scaffolded inside another solution). -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- The logging source generator that honours data-classification attributes ([PersonalInformation],
         [ProtectedPersonalData], ...) on [LoggerMessage] parameters; the built-in generator ignores them, so a
         classified value would be logged as is. -->
    <PackageReference Include="Microsoft.Extensions.Telemetry.Abstractions" Version="{{ telemetry_abstractions_version }}" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.DependencyInjection.Extensions" />
  </ItemGroup>
</Project>
