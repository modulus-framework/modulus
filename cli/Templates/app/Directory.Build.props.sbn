<Project>

  <PropertyGroup>
    <TargetFramework>{{ target_framework }}</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Generated apps use explicit Versions on each PackageReference, so
         disable Central Package Management.  This also prevents the
         generated app from inheriting CPM settings from a parent repo
         (e.g. when scaffolded inside another solution). -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- The logging source generator that honours data-classification attributes ([PersonalInformation],
         [ProtectedPersonalData], ...) on [LoggerMessage] parameters; the built-in generator ignores them, so a
         classified value would be logged as is. -->
    <PackageReference Include="Microsoft.Extensions.Telemetry.Abstractions" Version="{{ telemetry_abstractions_version }}" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.DependencyInjection.Extensions" />
  </ItemGroup>
{{ if use_auth }}
  <!-- Accepted risk (THIRD-PARTY-NOTICES.md): Modulus.Identity uses ImageSharp 2.1.13 (Apache-2.0) for profile photos. Each advisory below is
       unreachable from that code: the format gate accepts only JPEG, PNG and WebP, the structure walk refuses embedded colour profiles, and
       the TIFF and histogram code is never called. Revisit at every release, and remove these lines once the package is fixed or replaced. -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
  </ItemGroup>
{{ end }}
</Project>
