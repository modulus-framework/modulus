@page
@model {{ root_namespace }}.Web.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot your password";
}
<div class="m-auth-card">
    <div class="m-auth-card-body">
        <h1 class="m-auth-title">Forgot your password?</h1>
        @if (Model.Sent)
        {
            <app-alert type="success" show-icon message="If an account exists for that address, a link to set a new password is on its way. The link works once and expires after 24 hours." class="m-mb-16" />
            <p class="m-auth-hint">Check your inbox, and your spam folder if it does not arrive within a few minutes.</p>
            <div class="m-auth-actions">
                <a class="ant-btn ant-btn-default ant-btn-block" href="/Account/Login">Back to sign in</a>
            </div>
        }
        else
        {
            <p class="m-auth-hint">Enter the email address of your account and we will send you a link to set a new password.</p>
            @if (!string.IsNullOrEmpty(Model.Error))
            {
                <app-alert type="error" show-icon message="@Model.Error" class="m-mb-16" />
            }
            <form method="post" class="ant-form ant-form-vertical ant-form-hide-required-mark" novalidate>
                <app-form-item asp-for="Email" label="Email">
                    <app-input asp-for="Email" type="email" placeholder="you@example.com" prefix-icon="user" autocomplete="username" />
                </app-form-item>
                <div class="m-auth-actions">
                    <app-button type="primary" html-type="submit" block>Send the reset link</app-button>
                </div>
            </form>
            <p class="m-auth-hint" style="text-align: center; margin-top: 12px;"><a href="/Account/Login">Back to sign in</a></p>
        }
    </div>
</div>
