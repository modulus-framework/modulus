<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Home for developer secrets in Development, so credentials stay out of
         appsettings*.json (the SecretsGuard fails startup if they don't). Manage with
         'dotnet user-secrets set <Key> <value>'. -->
    <UserSecretsId>{{ user_secrets_id }}</UserSecretsId>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.AspNetCore.OpenApi.Generated</InterceptorsNamespaces>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Cobytelabs.Modulus.AspNetCore" Version="{{ framework_version }}" />
    <PackageReference Include="Cobytelabs.Modulus.Core" Version="{{ framework_version }}" />
    <PackageReference Include="Cobytelabs.Modulus.Mediator" Version="{{ framework_version }}" />
    <PackageReference Include="Cobytelabs.Modulus.EntityFrameworkCore" Version="{{ framework_version }}" />
{{ if auth != "none" }}    <PackageReference Include="Cobytelabs.Modulus.Identity" Version="{{ framework_version }}" />
{{ end }}    <!-- Transitive pin: AspNetCore.OpenApi floats to Microsoft.OpenApi 2.0.0,
         which has a high-severity advisory (GHSA-v5pm-xwqc-g5wc). Pin to latest 2.x. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.9.0" />
{{ if db_provider == "SQLite" }}    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
{{ end }}    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Shared/{{ root_namespace }}.Shared.Infrastructure/{{ root_namespace }}.Shared.Infrastructure.csproj" />
  </ItemGroup>
{{ if !no_example }}
  <ItemGroup>
    <ProjectReference Include="../../Modules/{{ root_namespace }}.Modules.{{ example_module }}/{{ root_namespace }}.Modules.{{ example_module }}.Infrastructure/{{ root_namespace }}.Modules.{{ example_module }}.Infrastructure.csproj" />
    <ProjectReference Include="../../Modules/{{ root_namespace }}.Modules.{{ example_module }}/{{ root_namespace }}.Modules.{{ example_module }}.Presentation/{{ root_namespace }}.Modules.{{ example_module }}.Presentation.csproj" />
  </ItemGroup>
{{ end }}
</Project>
