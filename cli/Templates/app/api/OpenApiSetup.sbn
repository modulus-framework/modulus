using Modulus.AspNetCore.OpenApi;

namespace {{ root_namespace }}.Api.OpenApi;

/// <summary>The OpenAPI document of the API host. The document is served in Development (see Endpoints/ApiEndpoints.cs).</summary>
internal static class OpenApiSetup
{
    public static WebApplicationBuilder AddApiOpenApi(this WebApplicationBuilder builder)
    {
        // Hardened document: metadata from the OpenApi config section + a JWT Bearer security scheme, with a padlock on
        // operations that require authorization.
        builder.Services.AddModulusOpenApi(builder.Configuration);

        return builder;
    }
}
