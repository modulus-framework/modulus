{{ if auth == "openiddict" }}using System.Security.Cryptography.X509Certificates;
using Modulus.Identity.Abstractions;
using Modulus.Identity.Extensions;
using {{ identity_namespace }}.Infrastructure;
using OpenIddict.Server;
{{ end }}using OpenIddict.Server.AspNetCore;

namespace {{ root_namespace }}.Api.Security;

/// <summary>
/// The local OAuth2/OIDC token server (OpenIddict): /connect/token, /connect/userinfo and /connect/revoke. The users, roles and
/// token store live in the Identity module (registered by ModuleRegistration), which is also what makes the API usable by
/// external clients (mobile, desktop, other systems):
///   curl -d grant_type=password -d client_id={{ app_name_lower }} -d username=&lt;email&gt; -d password=&lt;password&gt; http://localhost:5180/connect/token
/// then call the API with "Authorization: Bearer &lt;access_token&gt;".
/// Development uses ephemeral certificates and the password grant (see appsettings.Development.json). Production: register
/// real signing and encryption certificates here, serve over https, and turn on Identity:AllowPasswordFlow only if a trusted
/// first-party client needs it (it is off by default: the password grant hands the user's credentials to the client).
/// </summary>
internal static class TokenServerSetup
{
    public static WebApplicationBuilder AddApiTokenServer(this WebApplicationBuilder builder)
    {
        builder.Services.AddModulusOpenIddict(builder.Configuration, options =>
        {
            // Development runs over plain http on localhost; OpenIddict insists on https unless told otherwise.
            if (builder.Environment.IsDevelopment())
                options.UseAspNetCore().DisableTransportSecurityRequirement();
        });
{{ if auth == "openiddict" }}
        // Passkey sign-in and enrolment (Identity:Passkeys). The endpoints are mapped only when it is enabled (ApiEndpoints).
        builder.Services.AddModulusPasskeys<AppIdentityDbContext, ModulusUser>(builder.Configuration);

        // Production signs and encrypts tokens with the operator's certificates, never the development ones (the server refuses those in
        // Production). Each is a PFX file: its path and password come from Identity:Certificates:{Signing|Encryption}, set through User
        // Secrets, the environment or a vault, never committed.
        if (builder.Environment.IsProduction())
        {
            builder.Services.AddOpenIddict().AddServer(server =>
            {
                server.AddSigningCertificate(LoadCertificate(builder.Configuration, "Identity:Certificates:Signing"));
                server.AddEncryptionCertificate(LoadCertificate(builder.Configuration, "Identity:Certificates:Encryption"));
            });
        }
{{ end }}
        return builder;
    }
{{ if auth == "openiddict" }}
    private static X509Certificate2 LoadCertificate(IConfiguration configuration, string section)
    {
        var path = configuration[$"{section}:Path"]
            ?? throw new InvalidOperationException($"Production needs {section}:Path (a PFX file) for the token server.");
        var password = configuration[$"{section}:Password"];
        return X509CertificateLoader.LoadPkcs12FromFile(path, password);
    }
{{ end }}}
