{{ if auth == "openiddict" }}using Modulus.Navigation;
{{ end }}namespace {{ root_namespace }}.Api.Configuration;

/// <summary>
/// The optional features of this API host: webhooks, realtime, GraphQL, gRPC, the AI connector, the audit store and the
/// permission wiring a generated CRUD set needs. The modulus CLI adds a feature here (`modulus add-webhooks`,
/// `add-realtime`, `add-ai`, `add-audit-store`, `generate-grpc`, `generate-graphql`), and its endpoints to
/// Endpoints/FeatureEndpoints.cs, so Program.cs and the core setup stay as they are.
/// </summary>
internal static class FeatureServicesSetup
{
    public static WebApplicationBuilder AddApiFeatures(this WebApplicationBuilder builder)
    {
{{ if multi_tenancy }}        // Settings values and the navigation overrides are stored in the tenant store database (ModulusSettingValues),
        // so they survive a restart and every node sees them. Registered before the settings system, which keeps this store.
        Modulus.MultiTenancy.EntityFrameworkCore.EfSettingStoreExtensions.AddEfCoreSettingStore(builder.Services);
{{ end }}        // The application menu (GET api/navigation/menu) for signed-in people, and the company overrides to it. Modules declare
        // their items with AddNavigationContributor<T>(). Overrides are stored as settings: multi-tenant apps keep them in the tenant store,
        // single-tenant apps in memory (lost on restart). Grant navigation:manage to administrators to change them.
{{ if example_permission }}        // Settings administration: the registered settings, written per scope. No role is granted settings:manage by default.
        Modulus.Settings.SettingsExtensions.AddModulusSettings(builder.Services);
        Modulus.Settings.SettingsAdministrationEndpoints.AddModulusSettingAdministration(builder.Services);
{{ end }}{{ if auth == "openiddict" }}        // The application menu (GET api/navigation/menu) is served to every signed-in caller; modules add items with AddNavigationContributor.
        builder.Services.AddModulusNavigation();
{{ end }}        return builder;
    }
}
