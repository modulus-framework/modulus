{{ if auth == "openiddict" }}using Modulus.Navigation;
{{ end }}namespace {{ root_namespace }}.Api.Configuration;

/// <summary>
/// The optional features of this API host: webhooks, realtime, GraphQL, gRPC, the AI connector, the audit store and the
/// permission wiring a generated CRUD set needs. The modulus CLI adds a feature here (`modulus add-webhooks`,
/// `add-realtime`, `add-ai`, `add-audit-store`, `generate-grpc`, `generate-graphql`), and its endpoints to
/// Endpoints/FeatureEndpoints.cs, so Program.cs and the core setup stay as they are.
/// </summary>
internal static class FeatureServicesSetup
{
    public static WebApplicationBuilder AddApiFeatures(this WebApplicationBuilder builder)
    {
{{ if auth == "openiddict" }}        // The application menu (GET api/navigation/menu) for signed-in people, and the company overrides to it. Modules declare
        // their items with AddNavigationContributor<T>(). Overrides are stored as settings: until AddEfCoreSettingStore is added
        // (with the tenant store) they live in memory and are lost on restart. Grant navigation:manage to administrators to change them.
        builder.Services.AddModulusNavigation();
{{ end }}        return builder;
    }
}
