{{ if auth == "openiddict" }}using Modulus.Navigation;
{{ end }}namespace {{ root_namespace }}.Api.Configuration;

/// <summary>
/// The optional features of this API host: webhooks, realtime, GraphQL, gRPC, the AI connector, the audit store and the
/// permission wiring a generated CRUD set needs. The modulus CLI adds a feature here (`modulus add-webhooks`,
/// `add-realtime`, `add-ai`, `add-audit-store`, `generate-grpc`, `generate-graphql`), and its endpoints to
/// Endpoints/FeatureEndpoints.cs, so Program.cs and the core setup stay as they are.
/// </summary>
internal static class FeatureServicesSetup
{
    public static WebApplicationBuilder AddApiFeatures(this WebApplicationBuilder builder)
    {
{{ if auth == "openiddict" }}        // The application menu (GET api/navigation/menu) for signed-in people, and the company overrides to it. Modules declare
        // their items with AddNavigationContributor<T>(). Overrides are stored as settings: until AddEfCoreSettingStore is added
        // (with the tenant store) they live in memory and are lost on restart. Grant navigation:manage to administrators to change them.
        // The Users entry is shown only to people who hold identity:accounts:manage (the server filters the menu by permission).
        builder.Services.AddModulusNavigation(navigation => navigation.Add(new NavigationItem("identity.users", "Users")
        {
            Url = "/Admin/Users",
            Icon = "team",
            Permission = "identity:accounts:manage",
            Order = 10,
        }));
{{ if example_permission }}        // Settings administration (the Settings page): the registered settings, written per scope. Values are in memory until the
        // EF settings store is added (with the tenant store); no role is granted settings:manage by default.
        Modulus.Settings.SettingsExtensions.AddModulusSettings(builder.Services);
        Modulus.Settings.SettingsAdministrationEndpoints.AddModulusSettingAdministration(builder.Services);
{{ if multi_tenancy }}        // Company administration (the Companies page): list, create, status, seats and members of the companies (tenants:manage).
        Modulus.MultiTenancy.EntityFrameworkCore.TenantAdminEndpoints.AddModulusTenantAdmin(builder.Services);
        builder.Services.AddModulusNavigation(navigation => navigation.Add(new NavigationItem("identity.companies", "Companies")
        {
            Url = "/Admin/Companies",
            Icon = "bank",
            Permission = "tenants:manage",
            Order = 14,
        }));
{{ end }}        builder.Services.AddModulusNavigation(navigation => navigation.Add(new NavigationItem("identity.settings", "Settings")
        {
            Url = "/Admin/Settings",
            Icon = "setting",
            Permission = "settings:manage",
            Order = 13,
        }));
{{ end }}{{ if use_security_guard }}        builder.Services.AddModulusNavigation(navigation => navigation.Add(new NavigationItem("identity.audit", "Security audit")
        {
            Url = "/Admin/Audit",
            Icon = "audit",
            Permission = "audit:security:view",
            Order = 12,
        }));
{{ end }}        builder.Services.AddModulusNavigation(navigation => navigation.Add(new NavigationItem("identity.roles", "Roles")
        {
            Url = "/Admin/Roles",
            Icon = "safety",
            Permission = "identity:accounts:manage",
            Order = 11,
        }));
{{ end }}        return builder;
    }
}
