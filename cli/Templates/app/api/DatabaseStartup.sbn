using Modulus.EntityFrameworkCore.Extensions;
{{ if example_permission }}using Modulus.Authorization.EntityFrameworkCore;
{{ end }}{{ if auth == "openiddict" }}using {{ identity_namespace }}.Infrastructure;
{{ end }}{{ if multi_tenancy }}using Modulus.Core.Abstractions;
using Modulus.Core.Abstractions.Tenancy;
using Modulus.MultiTenancy;
using Modulus.MultiTenancy.EntityFrameworkCore;
using {{ tenancy_namespace }}.Infrastructure;
{{ end }}{{ if multi_tenancy }}{{ if example_permission }}using Microsoft.Extensions.Configuration;
using Microsoft.Extensions.DependencyInjection;
using Modulus.Authorization.Grants;
{{ end }}{{ end }}
namespace {{ root_namespace }}.Api.Hosting;

/// <summary>
/// Brings the API's databases up to date before the first request: the tenant store, then every module's schema, then the
/// seed data. Runs after the host is built, so migrations and seeders can resolve the application's services.
/// </summary>
internal static class DatabaseStartup
{
    /// <remarks>
    /// Each module owns its own DbContext (registered via AddModuleDatabase in its composition root). In Production, Migrate
    /// applies authored migrations and fails fast if a module has none: every schema change goes through a migration. Outside
    /// Production (Development / Testing / Staging) MigrateOrCreate lets a freshly generated app, and the integration-test
    /// harness, run before the first migration is authored. Modules whose schema is managed externally (dbsh, registered via
    /// .ExternallyManaged&lt;TContext&gt;()) are skipped here; apply theirs with `modulus migrate update`.
    /// Author the first migration with:  modulus migrate add &lt;Name&gt; --module &lt;Module&gt;
    /// </remarks>
    public static async Task InitializeApiAsync(this WebApplication app)
    {
{{ if example_permission }}        // The permission grants have their own database (the Authorization connection), shared with the provisioning host.
        await app.Services.MigrateAuthorizationStoreAsync(ensureCreatedIfNoMigrations: !app.Environment.IsProduction());
{{ end }}{{ if multi_tenancy }}        // The tenant store (companies, memberships) is not a module context: it is migrated on its own, first.
        await app.Services.MigrateTenantStoreAsync(ensureCreatedIfNoMigrations: !app.Environment.IsProduction());
{{ end }}        await app.Services.MigrateModulusDatabasesAsync(
            app.Environment.IsProduction()
                ? DatabaseInitializationMode.Migrate
                : DatabaseInitializationMode.MigrateOrCreate);
{{ if example_permission }}
        // The first-boot grants (AddPermissionGrants), written once into the empty grant store.
        await app.Services.SeedPermissionGrantsAsync();
{{ end }}{{ if auth == "openiddict" }}
        // Roles, and the first administrator where that is safe (see IdentitySeeding).
        await app.Services.SeedIdentityAsync(app.Environment);
{{ end }}{{ if multi_tenancy }}
        // The default company and the administrators' memberships in it (see TenancySeeding).
        await app.Services.SeedTenancyAsync(app.Environment);
{{ if multi_tenancy }}        await app.Services.SeedCompanyGrantsAsync(app.Configuration);
{{ end }}{{ end }}    }

{{ if multi_tenancy }}    /// <summary>
    /// Gives the default company its configured starting grants (CompanyProvisioning:Grants, the same baseline a new company gets through the
    /// company API). Grants are per company, so a company sees only its own: the first-boot grant is written in the host context and would be
    /// invisible to the company. A role that already holds grants in the company is left alone, so a later change by an administrator survives
    /// a restart; a role whose every grant was revoked is granted its baseline again on the next start.
    /// </summary>
    private static async Task SeedCompanyGrantsAsync(this IServiceProvider services, IConfiguration configuration)
    {
        var slug = configuration["Tenancy:Seed:DefaultTenant"] is { Length: > 0 } configured ? configured : "default";
        await using var scope = services.CreateAsyncScope();
        var provider = scope.ServiceProvider;
        var tenant = await provider.GetRequiredService<ITenantStore>().FindBySlugAsync(slug, CancellationToken.None);
        if (tenant is null)
            return;

        // Without the authorization stores there are no grants to give; the company then has none, as before.
        if (provider.GetService<ICompanyProvisioner>() is { } provisioner)
            await provisioner.ProvisionAsync(tenant, CancellationToken.None);
    }
{{ end }}}
