{
  "ConnectionStrings": {
{{ if auth == "openiddict" }}    "Identity": "{{ identity_connection_string }}"{{ if multi_tenancy || !no_example }},{{ end }}
{{ end }}{{ if multi_tenancy }}    "Tenancy": "{{ tenancy_connection_string }}"{{ if !no_example }},{{ end }}
{{ end }}{{ if !no_example }}    "{{ example_module }}": "{{ connection_string }}"
{{ end }}  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Caching": {
    "Fusion": {
      "CacheName": "{{ app_name_lower }}",
      "DefaultDuration": "00:05:00",
      "FailSafeEnabled": true,
      "FailSafeMaxDuration": "02:00:00",
      "FactorySoftTimeout": "00:00:00.500",
      "EagerRefreshThreshold": 0.9
    }{{ if use_redis_cache }},
    "Redis": {
      "ConnectionString": "localhost:6379"
    }{{ end }}
  },
{{ if enable_correlation }}  "Correlation": {
    "HeaderName": "X-Correlation-ID",
    "IncludeInResponse": true,
    "UseTraceIdWhenMissing": true
  },
{{ end }}{{ if enable_idempotency }}  "Idempotency": {
    "HeaderName": "Idempotency-Key",
    "Methods": [ "POST", "PATCH" ],
    "RequireKey": false,
    "ValidateRequestMatch": true,
    "RetentionSeconds": 86400,
    "InProgressLeaseSeconds": 300
  },
{{ end }}  "OpenApi": {
    "Title": "{{ app_name }} API",
    "Version": "v1",
    "IncludeBearerSecurity": true
  },
{{ if enable_api_versioning }}  "ApiVersioning": {
    "DefaultVersion": "1.0",
    "AssumeDefaultVersionWhenUnspecified": true,
    "ReportApiVersions": true
  },
{{ end }}{{ if enable_rate_limiting }}  "RateLimiting": {
    "Enabled": true,
    "PermitLimit": 100,
    "WindowSeconds": 60,
    "QueueLimit": 0,
    "Partition": "User"
  },
{{ end }}{{ if enable_cors }}  "Cors": {
    "AllowedOrigins": [],
    "AllowedMethods": [],
    "AllowedHeaders": [],
    "AllowCredentials": false
  },
{{ end }}{{ if enable_security_headers }}  "SecurityHeaders": {
    "ContentTypeOptions": true,
    "FrameOptions": "DENY",
    "ReferrerPolicy": "strict-origin-when-cross-origin",
    "EnableHsts": true
  },
{{ end }}{{ if multi_tenancy }}  "Tenancy": {
    "Seed": {
      "DefaultTenant": "default"
    }
  },
  "Storage": {
    "IsolateTenants": true
  },
{{ end }}  "FeatureManagement": {
    "SampleFeature": false
  },
{{ if enable_secrets_guard }}  "SecretsGuard": {
    "Enabled": true,
    "FailOnViolation": true
  },
{{ end }}  "Security": {
    "Redaction": {
      "Enabled": true
    }
  },
{{ if enable_personal_data_protection }}  "PersonalDataProtection": {
    "Enabled": true,
    "Purpose": "Modulus.PersonalData.Protector.v1"
  },
{{ end }}{{ if auth == "openiddict" }}  "Identity": {
    "UseDevelopmentCertificates": false,
    "AllowPasswordFlow": false,
{{ if has_bearer_bff }}    "EncryptAccessTokens": false,
{{ end }}{{ if has_partner_bff }}    "AllowClientCredentialsFlow": true,
{{ end }}{{ if has_bff }}    "Seed": {
      "Clients": {
{{ for c in bff_client_models }}        "{{ c.name }}": { "ClientId": "{{ c.client_id }}", "ClientSecret": "" }{{ if !for.last }},{{ end }}
{{ end }}      }
    },
{{ end }}    "AccessTokenLifetimeMin": 15,
    "RefreshTokenLifetimeDays": 7
  },
{{ else if auth == "auth0" }}  "Identity": {
    "ExternalProviders": {
      "Auth0": {
        "Authority": "https://your-tenant.auth0.com/",
        "ClientId": "your-client-id",
        "ClientSecret": "",
        "Scope": "openid profile email"
      }
    }
  },
{{ else if auth == "authentik" }}  "Identity": {
    "ExternalProviders": {
      "Authentik": {
        "Authority": "https://authentik.example.com/",
        "ClientId": "your-client-id",
        "ClientSecret": "",
        "Scope": "openid profile email"
      }
    }
  },
{{ else if auth == "azuread" }}  "Identity": {
    "ExternalProviders": {
      "AzureAd": {
        "Instance": "https://login.microsoftonline.com/",
        "TenantId": "your-tenant-id",
        "ClientId": "your-client-id",
        "ClientSecret": "",
        "Scope": "openid profile email User.Read"
      }
    }
  },
{{ else if auth == "duende" }}  "Identity": {
    "ExternalProviders": {
      "Duende": {
        "Authority": "https://localhost:5001",
        "ClientId": "your-client-id",
        "ClientSecret": "",
        "ApiName": "modulus",
        "Scope": "openid profile email roles"
      }
    }
  },
{{ else if auth == "keycloak" }}  "Identity": {
    "ExternalProviders": {
      "Keycloak": {
        "Authority": "https://localhost:8443",
        "Realm": "master",
        "ClientId": "your-client-id",
        "ClientSecret": "",
        "Scope": "openid profile email roles"
      }
    }
  },
{{ else if auth == "okta" }}  "Identity": {
    "ExternalProviders": {
      "Okta": {
        "Authority": "https://your-tenant.okta.com/",
        "ClientId": "your-client-id",
        "ClientSecret": "",
        "Scope": "openid profile email"
      }
    }
  },
{{ end }}  "AllowedHosts": "*"
}
