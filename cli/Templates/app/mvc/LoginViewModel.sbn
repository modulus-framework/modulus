namespace {{ root_namespace }}.Web.Areas.Account.Models;

/// <summary>What the sign-in page shows and posts.</summary>
public sealed class LoginViewModel
{
    public string UserName { get; set; } = "";

    public string Password { get; set; } = "";

    /// <summary>A local address to return to after sign-in (checked before it is used).</summary>
    public string? ReturnUrl { get; set; }

    /// <summary>The reason the sign-in failed, shown above the form.</summary>
    public string? Error { get; set; }

    /// <summary>True when the visitor has just set a new password, so the page says to sign in with it.</summary>
    public bool PasswordReset { get; set; }
}

/// <summary>The browser's answer to the passkey options: the challenge id and the assertion (its JSON text).</summary>
public sealed record PasskeyCompleteInput(string ChallengeId, string Assertion, string? ReturnUrl);
