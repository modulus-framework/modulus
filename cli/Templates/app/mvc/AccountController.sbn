using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Http;
using Microsoft.AspNetCore.Mvc;
using Microsoft.AspNetCore.RateLimiting;
using Modulus.Core.Abstractions.Security;
using {{ root_namespace }}.Web.Areas.Account.Models;
using {{ root_namespace }}.Web.Configuration;
using {{ root_namespace }}.Web.Security;
{{ if auth == "openiddict" }}using {{ root_namespace }}.Web.Services.ApiClients;
{{ end }}
namespace {{ root_namespace }}.Web.Areas.Account.Controllers;

/// <summary>
/// Sign-in, sign-out and access denied. The controller only translates HTTP to the BFF session client and back: the credentials go
/// to the BFF, which owns the session and the tokens; the browser keeps only the BFF cookie. Open to every visitor (it is the way in),
/// with a reviewed reason for the security guard.
/// </summary>
[Area("Account")]
[Route("Account")]
[AllowAnonymous]
[Loosened("Sign-in pages under /Account are open", Framework = true)]
[AutoValidateAntiforgeryToken]
public sealed class AccountController(BffSessionClient session{{ if auth == "openiddict" && web_login_mode != "Oidc" }}, PasskeyLoginClient passkeys{{ end }}) : Controller
{
{{ if web_login_mode == "Oidc" }}    /// <summary>Sends the browser to the BFF's OIDC login, which runs the code flow (with PKCE) at the provider's own page.</summary>
    [HttpGet("Login")]
    [EnableRateLimiting(RateLimitingSetup.SignInPolicy)]
    public IActionResult Login(string? returnUrl = null)
    {
        var target = SafeReturnUrl(returnUrl) ?? "/";
        return Redirect(session.SignInUrl($"{Request.Scheme}://{Request.Host}{target}"));
    }
{{ else }}    [HttpGet("Login")]
    public IActionResult Login(string? returnUrl = null, bool reset = false)
        => View(new LoginViewModel { ReturnUrl = SafeReturnUrl(returnUrl), PasswordReset = reset });

    [HttpPost("Login")]
    [EnableRateLimiting(RateLimitingSetup.SignInPolicy)]
    public async Task<IActionResult> Login(LoginViewModel model, CancellationToken ct)
    {
        model.ReturnUrl = SafeReturnUrl(model.ReturnUrl);
        model.PasswordReset = false;

        var result = await session.SignInAsync(model.UserName, model.Password, rememberMe: true, ct);
        if (result.Succeeded)
            return LocalRedirect(model.ReturnUrl ?? "/");

        model.Password = "";
        model.Error = result.Error == "temporarily_unavailable"
            ? "The sign-in service is not available right now. Try again in a moment."
            : "Invalid user name or password.";
        return View(model);
    }
{{ if auth == "openiddict" }}
    /// <summary>Asks the API for passkey sign-in options. The browser runs the ceremony and posts the assertion to <see cref="PasskeyComplete"/>.</summary>
    [HttpPost("PasskeyBegin")]
    [EnableRateLimiting(RateLimitingSetup.SignInPolicy)]
    public async Task<IActionResult> PasskeyBegin(CancellationToken ct)
    {
        using var response = await passkeys.BeginAsync(ct);
        var body = await response.Content.ReadAsStringAsync(ct);
        return new ContentResult
        {
            StatusCode = (int)response.StatusCode,
            ContentType = "application/json",
            Content = string.IsNullOrEmpty(body) ? "null" : body,
        };
    }

    /// <summary>Exchanges the browser's passkey assertion at the BFF, which starts the session. Answers where the browser goes next.</summary>
    [HttpPost("PasskeyComplete")]
    [EnableRateLimiting(RateLimitingSetup.SignInPolicy)]
    public async Task<IActionResult> PasskeyComplete([FromBody] PasskeyCompleteInput input, CancellationToken ct)
    {
        var result = await session.SignInWithPasskeyAsync(input.ChallengeId, input.Assertion, rememberMe: true, ct);
        if (!result.Succeeded)
        {
            return new JsonResult(new { error = result.Error ?? "invalid_request", error_description = "Sign-in with the passkey failed." })
            {
                StatusCode = StatusCodes.Status400BadRequest,
            };
        }

        return new JsonResult(new { returnUrl = SafeReturnUrl(input.ReturnUrl) ?? "/" });
    }
{{ end }}{{ end }}
    /// <summary>The confirmation step. A GET only asks, so a link or an image on another site cannot end the session.</summary>
    [HttpGet("Logout")]
    public IActionResult Logout() => View();

    /// <summary>Ends the BFF session (it revokes the tokens it holds); an OIDC provider's end-session URL is visited too.</summary>
    [HttpPost("Logout")]
    public async Task<IActionResult> LogoutConfirmed(CancellationToken ct)
    {
        var loginPage = $"{Request.Scheme}://{Request.Host}/Account/Login";
        var endSessionUrl = await session.SignOutAsync(loginPage, ct);
        return endSessionUrl is null ? LocalRedirect("/Account/Login") : Redirect(endSessionUrl);
    }

    /// <summary>Shown when a signed-in user opens a page their role or permissions do not cover (the session's access-denied path).</summary>
    [HttpGet("AccessDenied")]
    public IActionResult AccessDenied() => View();

    private string? SafeReturnUrl(string? returnUrl) => Url.IsLocalUrl(returnUrl) ? returnUrl : null;
}
