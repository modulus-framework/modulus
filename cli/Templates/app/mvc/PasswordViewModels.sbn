using System.ComponentModel.DataAnnotations;

namespace {{ root_namespace }}.Web.Areas.Account.Models;

/// <summary>The forgot-password form and its outcome.</summary>
public sealed class ForgotPasswordViewModel
{
    [Required(ErrorMessage = "Enter the email address of your account.")]
    [EmailAddress(ErrorMessage = "Enter a valid email address.")]
    public string Email { get; set; } = "";

    /// <summary>The message when the request could not be made (the rate limit, or the sign-in service is down).</summary>
    public string? Error { get; set; }

    /// <summary>True once the request was accepted: the page then confirms, without saying whether an account exists.</summary>
    public bool Sent { get; set; }
}

/// <summary>The reset-password form: the link carries the token; the account's email is asked for on the page.</summary>
public sealed class ResetPasswordViewModel
{
    [Required(ErrorMessage = "Enter the email address of your account.")]
    [EmailAddress(ErrorMessage = "Enter a valid email address.")]
    public string Email { get; set; } = "";

    public string Token { get; set; } = "";

    [Required(ErrorMessage = "Enter a new password.")]
    [StringLength(128, MinimumLength = 8, ErrorMessage = "Use at least 8 characters.")]
    public string NewPassword { get; set; } = "";

    [Compare(nameof(NewPassword), ErrorMessage = "The two passwords do not match.")]
    public string ConfirmPassword { get; set; } = "";

    /// <summary>The message when the password could not be set (the link expired or was used, or the password is refused).</summary>
    public string? Error { get; set; }

    /// <summary>False when the page was opened without a token (an incomplete link).</summary>
    public bool HasToken => !string.IsNullOrEmpty(Token);
}
