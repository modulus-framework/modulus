using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;
using Microsoft.AspNetCore.RateLimiting;
using Modulus.Core.Abstractions.Security;
using {{ root_namespace }}.Web.Areas.Account.Models;
using {{ root_namespace }}.Web.Configuration;
using {{ root_namespace }}.Web.Services.ApiClients;

namespace {{ root_namespace }}.Web.Areas.Account.Controllers;

/// <summary>
/// Password recovery: ask for a reset link, then set a new password with the token from the email. Both call the API anonymously. The same
/// confirmation is shown whether or not the address has an account, so the page cannot be used to find out who has one.
/// </summary>
[Area("Account")]
[AllowAnonymous]
[Loosened("Password recovery pages are open", Framework = true)]
[AutoValidateAntiforgeryToken]
[EnableRateLimiting(RateLimitingSetup.SignInPolicy)]
public sealed class PasswordController(AccountApiClient accounts) : Controller
{
    [HttpGet("Account/ForgotPassword")]
    public IActionResult ForgotPassword() => View(new ForgotPasswordViewModel());

    [HttpPost("Account/ForgotPassword")]
    public async Task<IActionResult> ForgotPassword(ForgotPasswordViewModel model, CancellationToken ct)
    {
        if (!ModelState.IsValid)
            return View(model);

        model.Error = await accounts.RequestResetAsync(model.Email.Trim(), ct);
        model.Sent = model.Error is null;
        return View(model);
    }

    /// <summary>Served at /ResetPassword, the path the email's link uses (the API builds it).</summary>
    [HttpGet("ResetPassword")]
    public IActionResult ResetPassword(string? token = null, string? email = null)
        => View(new ResetPasswordViewModel { Token = token ?? "", Email = email ?? "" });

    [HttpPost("ResetPassword")]
    public async Task<IActionResult> ResetPassword(ResetPasswordViewModel model, CancellationToken ct)
    {
        if (!ModelState.IsValid)
            return View(model);

        model.Error = await accounts.ResetPasswordAsync(model.Email.Trim(), model.Token, model.NewPassword, ct);
        if (model.Error is not null)
            return View(model);

        return RedirectToAction("Login", "Account", new { area = "Account", reset = true });
    }
}
