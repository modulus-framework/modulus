using System.ComponentModel.DataAnnotations;
using Microsoft.AspNetCore.Mvc;
using Microsoft.AspNetCore.Mvc.RazorPages;
using Microsoft.AspNetCore.RateLimiting;
using {{ root_namespace }}.Web.Configuration;
using {{ root_namespace }}.Web.Services.ApiClients;

namespace {{ root_namespace }}.Web.Pages.Account;

/// <summary>
/// Sets a new password with the token from the reset email. The page is served at /ResetPassword, the path the email's link uses (the API builds
/// it). The link carries the token; the account's email is asked for on the page, so the page works with the link as the email sends it.
/// </summary>
[EnableRateLimiting(RateLimitingSetup.SignInPolicy)]
public sealed class ResetPasswordModel(AccountApiClient accounts) : PageModel
{
    [BindProperty]
    [Required(ErrorMessage = "Enter the email address of your account.")]
    [EmailAddress(ErrorMessage = "Enter a valid email address.")]
    public string Email { get; set; } = "";

    [BindProperty]
    public string Token { get; set; } = "";

    [BindProperty]
    [Required(ErrorMessage = "Enter a new password.")]
    [StringLength(128, MinimumLength = 8, ErrorMessage = "Use at least 8 characters.")]
    public string NewPassword { get; set; } = "";

    [BindProperty]
    [Compare(nameof(NewPassword), ErrorMessage = "The two passwords do not match.")]
    public string ConfirmPassword { get; set; } = "";

    /// <summary>The message when the password could not be set (the link expired or was used, or the password is refused).</summary>
    public string? Error { get; private set; }

    /// <summary>False when the page was opened without a token (an incomplete link).</summary>
    public bool HasToken => !string.IsNullOrEmpty(Token);

    public void OnGet(string? token = null, string? email = null)
    {
        Token = token ?? "";
        Email = email ?? "";
    }

    public async Task<IActionResult> OnPostAsync(CancellationToken ct)
    {
        if (!ModelState.IsValid)
            return Page();

        Error = await accounts.ResetPasswordAsync(Email.Trim(), Token, NewPassword, ct);
        if (Error is not null)
            return Page();

        return RedirectToPage("/Account/Login", new { reset = true });
    }
}
