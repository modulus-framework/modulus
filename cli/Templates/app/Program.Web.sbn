using {{ root_namespace }}.Web.Composition;
using {{ root_namespace }}.Web.Configuration;
using {{ root_namespace }}.Web.Endpoints;
using {{ root_namespace }}.Web.Middleware;
using {{ root_namespace }}.Web.Observability;
using {{ root_namespace }}.Web.Services;
{{ if use_auth }}using {{ root_namespace }}.Web.Security;
{{ end }}
var builder = WebApplication.CreateBuilder(args);

// The presentation host: {{ if ui_engine == "mvc" }}MVC and Razor Pages{{ else }}Razor Pages{{ end }} over the API host. No DbContext and no modules here. Each concern has its own
// setup file (Configuration, Security, Services, Composition, Observability, Middleware, Endpoints); this file only
// composes them, in the order the pipeline depends on.
builder.Services.AddWebCore(builder.Configuration);
builder.Services.AddWebUi(builder.Configuration);
{{ if use_auth }}builder.Services.AddWebAuthentication(builder.Configuration);
{{ end }}
// Typed API clients, one per module (resilience and correlation are wired in AddModulusHttpClient). {{ if use_auth }}Every call carries the
// signed-in user's access token from the BFF web session.{{ else }}Without auth the clients call the API anonymously.{{ end }}
builder.Services.AddModuleApiClients();

// Menu contributors under Components/Navigation/Menu are registered by scan: a new entity's menu entry is its file there.
builder.Services.AddMenuContributors();

builder.Services.AddWebHealthChecks();

var app = builder.Build();

app.UseWebPipeline();
app.MapWebEndpoints();

app.Run();

// The entry point stays in the global namespace (top-level statements). This namespaced marker gives the integration
// tests an unambiguous generic argument for booting this host: ModulusWebAppFactory<{{ root_namespace }}.Web.WebEntryPoint>.
namespace {{ root_namespace }}.Web
{
    public sealed class WebEntryPoint;
}
