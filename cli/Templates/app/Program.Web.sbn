using Modulus.AspNetCore.Configuration;
using Modulus.AspNetCore.Correlation;
using Modulus.AspNetCore.Extensions;
using Modulus.AspNetCore.FeatureFlags;
using Modulus.AspNetCore.Security;
{{ if use_tabler_theme }}using Modulus.UI.Theming.Tabler;
{{ end }}using Modulus.UI;
using Modulus.Core.Abstractions;
using {{ root_namespace }}.Web;
{{ if use_auth }}using {{ root_namespace }}.Web.Security;
{{ end }}using Microsoft.AspNetCore.HttpOverrides;

var builder = WebApplication.CreateBuilder(args);

// ── Razor Pages UI ─────────────────────────────────────────────
// This project is only the presentation shell: pages call the API project over
// HTTP (typed clients, see ApiClientExtensions.cs) — no DbContext, no modules.
builder.Services.AddRazorPages();

// ── Modulus UI framework ───────────────────────────────────────
// Core theme support and component library (m-card, m-form, m-datatable, …).
builder.Services.AddModulusUi();
{{ if use_tabler_theme }}// Use the Tabler theme (responsive, light/dark mode, vendored assets).
builder.Services.AddTablerTheme(builder.Configuration);
{{ end }}// ── Typed API clients ──────────────────────────────────────────
// One typed HttpClient per module (resilience + correlation wired in
// AddModulusHttpClient). With auth on, every call relays the signed-in
// user's bearer token and refreshes it on 401 (TokenRelayHandler); without
// auth the clients still work, they just call the API anonymously.
builder.Services.AddModuleApiClients();
{{ if use_auth }}
// ── Authentication ─────────────────────────────────────────────
// The token server lives in the API project. The sign-in page POSTs the user's
// credentials to the API's /connect/token (password grant), stores the tokens
// in an auth cookie, and TokenRelayHandler relays the access token on every
// API call (refreshing it from the refresh token when it nears expiry).
builder.Services
    .AddAuthentication(Microsoft.AspNetCore.Authentication.Cookies.CookieAuthenticationDefaults.AuthenticationScheme)
    .AddCookie(options =>
    {
        options.LoginPath = "/Account/Login";
        options.LogoutPath = "/Account/Logout";
        options.AccessDeniedPath = "/Account/AccessDenied";
    });

// ICurrentUser for menus, contributed entity fields and page guards: read from
// the signed-in principal, with permissions resolved from the same Admin-role
// grants the API host seeds (in-memory; point both hosts at the EF grant store
// to edit grants at run time).
builder.Services.AddScoped<ICurrentUser, PrincipalCurrentUser>();

// Pages require a signed-in user (only /Account is open). Add a folder to the
// call to make it public, and set a feature UI's RequirePermission to also
// gate it by permission.
builder.Services.AddModulusPageAuthorization();
{{ else }}
// No authentication configured. Pages are public; add auth manually
// (AddAuthentication().AddCookie(...)) and a sign-in flow when you need one.
{{ end }}
{{ if enable_correlation }}// ── Correlation ────────────────────────────────────────────────
// Every log line carries the X-Correlation-ID (adopted from the API's response
// header or derived here), so a request can be traced across both hosts.
builder.Services.AddModulusCorrelation(builder.Configuration);
{{ end }}
// ── Health checks ──────────────────────────────────────────────
builder.Services.AddHealthChecks();

{{ if enable_feature_flags }}// Runtime feature flags (see "FeatureManagement" in appsettings.json).
builder.Services.AddModulusFeatureFlags(builder.Configuration);
{{ end }}{{ if enable_secrets_guard }}// Guard rail: fails startup if secrets are committed to appsettings*.json.
builder.Services.AddModulusSecretsGuard(builder.Configuration);
{{ end }}
// ── Forwarded headers ──────────────────────────────────────────
// Required when behind a reverse proxy so the app sees real client IPs.
builder.Services.Configure<ForwardedHeadersOptions>(options =>
{
    options.ForwardedHeaders = ForwardedHeaders.XForwardedFor | ForwardedHeaders.XForwardedProto;
    options.KnownIPNetworks.Clear();
    options.KnownProxies.Clear();
});

// ── Exception handling ─────────────────────────────────────────
builder.Services.AddModulusExceptionHandling();

var app = builder.Build();

// ── Pipeline ───────────────────────────────────────────────────
app.UseForwardedHeaders();
{{ if enable_security_headers }}app.UseModulusSecurityHeaders();
{{ end }}app.UseExceptionHandler();
{{ if enable_correlation }}app.UseModulusCorrelation();
{{ end }}app.UseStaticFiles();
// 403/404 render the theme's error pages (no /Error page to maintain).
app.UseModulusErrorPages();
app.UseRouting();
{{ if use_auth }}app.UseAuthentication();
app.UseAuthorization();
{{ end }}app.MapRazorPages();
app.MapModulusErrorPages();
{{ if enable_health_checks }}app.MapHealthChecks("/health/live");
{{ end }}
app.Run();

// The entry point stays in the global namespace (top-level statements); this
// namespaced marker gives the integration tests an unambiguous generic
// argument for booting this host: ModulusWebAppFactory<{{ root_namespace }}.Web.WebEntryPoint>
// (the API host's Program is also global — two global Programs cannot be
// named together in one test project).
namespace {{ root_namespace }}.Web
{
    public sealed class WebEntryPoint;
}
