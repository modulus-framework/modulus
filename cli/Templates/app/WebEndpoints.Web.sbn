using {{ root_namespace }}.Web.Observability;

namespace {{ root_namespace }}.Web.Endpoints;

/// <summary>Maps the {{ if ui_engine == "mvc" }}MVC controllers (areas, landing and error pages){{ else }}Razor Pages{{ end }} and the health probes.</summary>
internal static class WebEndpoints
{
    public static WebApplication MapWebEndpoints(this WebApplication app)
    {
{{ if ui_engine != "mvc" }}        app.MapRazorPages().WithStaticAssets();
{{ end }}{{ if ui_engine == "mvc" }}        // Attribute-routed controllers (the CRUD pages written by `modulus ui create-crud`) are reached only through MapControllers.
        app.MapControllers();
        // Signed in by default (the Account area and the error page opt out with a reviewed reason): the security guard refuses an endpoint with no policy.
        app.MapControllerRoute(name: "default", pattern: "{controller=Home}/{action=Index}/{id?}").WithStaticAssets().RequireAuthorization();
{{ end }}        app.MapWebHealthChecks();
        return app;
    }
}
