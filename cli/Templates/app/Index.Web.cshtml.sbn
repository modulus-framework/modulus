@page
@model {{ root_namespace }}.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Home";
}

<app-page-header pretitle="Welcome" title="{{ if use_auth }}Hello, @User.Identity?.Name{{ else }}Welcome to {{ app_name }}{{ end }}" />

<div style="display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));">
    <app-card title="Get started">
        <p>Your app is running. Build it up one step at a time with the CLI:</p>
        <ol style="padding-left: 20px; line-height: 1.8;">
            <li>Add a module: <code>modulus add-module Orders</code></li>
            <li>Generate a CRUD set: <code>modulus generate-crud Product --module Catalog</code></li>
            <li>Add a screen for it: <code>modulus ui create-form-from-entity Product</code></li>
        </ol>
        <p style="margin-top: 12px;">Run <code>modulus describe</code> to see the modules, entities and pages of this app.</p>
    </app-card>

    <app-card title="Your application">
        <p>Open a part of the application:</p>
        <div style="display: flex; gap: 8px; flex-wrap: wrap; margin-top: 12px;">
            <a class="ant-btn ant-btn-primary" href="/{{ example_route }}">{{ example_route | string.capitalize }}</a>
{{ if use_auth }}            <a class="ant-btn ant-btn-default" href="/Profile">Your profile</a>
            <a class="ant-btn ant-btn-default" href="/Admin/Users">Users</a>
            <a class="ant-btn ant-btn-default" href="/Admin/Roles">Roles</a>
{{ end }}        </div>
    </app-card>
</div>
