using System.Text.Json;
using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Http;
using Microsoft.AspNetCore.Mvc;
using Microsoft.AspNetCore.Mvc.RazorPages;
using {{ root_namespace }}.Web.Security;
using {{ root_namespace }}.Web.Services.ApiClients;

namespace {{ root_namespace }}.Web.Pages;

/// <summary>
/// The company switcher (decision 29): lists the companies the person belongs to and chooses the one the next calls act in. The choice is a
/// cookie that the gateway turns into the company header; the API checks membership on every request, so a company the person does not
/// belong to is refused whatever the cookie says. Only a listed company can be chosen here.
/// </summary>
[Authorize]
public sealed class CompanyModel(CompanyApiClient companies) : PageModel
{
    private static readonly JsonSerializerOptions s_json = new(JsonSerializerDefaults.Web);

    public IReadOnlyList<CompanyChoice> Companies { get; private set; } = [];

    public string? Message { get; private set; }

    public async Task OnGetAsync(CancellationToken ct)
    {
        Message = TempData["Message"] as string;
        using var response = await companies.ListAsync(ct);
        if (response.IsSuccessStatusCode)
            Companies = await response.Content.ReadFromJsonAsync<List<CompanyChoice>>(s_json, ct) ?? [];
        else
            Message = await ProfileApiClient.RefusalAsync(response, ct);
    }

    public async Task<IActionResult> OnPostSwitchAsync(Guid companyId, CancellationToken ct)
    {
        using var response = await companies.ListAsync(ct);
        var listed = response.IsSuccessStatusCode
            && (await response.Content.ReadFromJsonAsync<List<CompanyChoice>>(s_json, ct) ?? []).Any(c => c.TenantId == companyId);
        if (!listed)
        {
            TempData["Message"] = "You are not a member of that company.";
            return RedirectToPage();
        }

        Response.Cookies.Append(BffGatewayHandler.CompanyCookie, companyId.ToString("D"), new CookieOptions
        {
            HttpOnly = true,
            SameSite = SameSiteMode.Lax,
            Secure = Request.IsHttps,
            IsEssential = true,
        });
        TempData["Message"] = "Company selected.";
        return RedirectToPage();
    }

    public IActionResult OnPostClear()
    {
        Response.Cookies.Delete(BffGatewayHandler.CompanyCookie);
        TempData["Message"] = "The company choice was cleared.";
        return RedirectToPage();
    }
}
