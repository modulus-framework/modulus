@page
@model {{ root_namespace }}.Web.Pages.BranchModel
@{
    ViewData["Title"] = "Branches";
}

<app-page-header pretitle="Account" title="Branches" />

@if (Model.Message is not null)
{
    <app-alert type="info" show-icon message="@Model.Message" class="m-mb-16" />
}

<div class="m-card m-table-card m-mb-16">
    <div class="m-card-body m-card-body-flush">
        @if (Model.Branches.Count == 0)
        {
            <div class="m-empty">
                <h3 class="m-empty-title">No branch is available to you</h3>
                <p class="m-empty-subtitle">Ask an administrator to give you an organizational unit in your scope.</p>
            </div>
        }
        else
        {
            <div class="ant-table-wrapper m-table-flush"><div class="ant-table"><div class="ant-table-container"><div class="ant-table-content">
                <table style="table-layout: auto;">
                    <thead class="ant-table-thead">
                        <tr><th class="ant-table-cell">Branch</th><th class="ant-table-cell">Kind</th><th class="ant-table-cell">Acting in</th><th class="ant-table-cell"></th></tr>
                    </thead>
                    <tbody class="ant-table-tbody">
                    @foreach (var branch in Model.Branches)
                    {
                        var current = Model.Current == branch.Id;
                        <tr class="ant-table-row">
                            <td class="ant-table-cell"><strong>@branch.Name</strong> <code>@branch.Code</code></td>
                            <td class="ant-table-cell">@branch.Kind</td>
                            <td class="ant-table-cell">@(current ? "Yes" : "")</td>
                            <td class="ant-table-cell">
                                <form method="post" asp-page-handler="Switch">
                                    <input type="hidden" name="branchId" value="@branch.Id" />
                                    <button class="ant-btn ant-btn-primary ant-btn-sm" type="submit" disabled="@current"><span>Use this branch</span></button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div></div></div></div>
        }
    </div>
</div>

<form method="post" asp-page-handler="Clear">
    <button class="ant-btn ant-btn-default" type="submit">Stop choosing a branch</button>
</form>
