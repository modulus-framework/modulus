using System.Net;
using System.Net.Http.Headers;
using System.Net.Http.Json;
using System.Text.Json;
using FluentAssertions;
using Modulus.Testing;
using Xunit;
using ApiEntryPoint = {{ root_namespace }}.Api.ApiEntryPoint;

namespace {{ root_namespace }}.Tests;

/// <summary>
/// The AI connector (modulus add-ai) on the in-memory test host. appsettings.Testing.json configures the hash of a test
/// platform key and one app instance; real keys are never in settings files (only their SHA-256 hashes are).
/// </summary>
public sealed class AiConnectorTests(ModulusWebAppFactory<ApiEntryPoint> factory)
    : IClassFixture<ModulusWebAppFactory<ApiEntryPoint>>
{
    internal const string PlatformKey = "{{ test_api_key }}";
    private static readonly Uri Manifest = new("/_ai/connector/manifest", UriKind.Relative);

    [Fact]
    public async Task The_manifest_needs_the_platform_key()
    {
        var response = await factory.CreateClient().GetAsync(Manifest);

        response.StatusCode.Should().Be(HttpStatusCode.Unauthorized);
    }

    [Fact]
    public async Task A_signed_in_user_is_not_the_platform()
    {
        var response = await factory.CreateAuthenticatedClient({{ if has_admin_role }}roles: ["{{ admin_role }}"]{{ end }}).GetAsync(Manifest);

        response.StatusCode.Should().Be(HttpStatusCode.Unauthorized);
    }

    [Fact]
    public async Task A_key_sent_from_a_browser_is_refused()
    {
        using var client = Platform(factory);
        client.DefaultRequestHeaders.Add("Origin", "https://evil.example.com");

        (await client.GetAsync(Manifest)).StatusCode.Should().Be(HttpStatusCode.Unauthorized);
    }

    [Fact]
    public async Task The_platform_reads_the_manifest()
    {
        using var client = Platform(factory);

        var manifest = await client.GetFromJsonAsync<JsonElement>(Manifest);

        manifest.GetProperty("contractVersion").GetString().Should().Be("1");
        manifest.GetProperty("capabilities").ValueKind.Should().Be(JsonValueKind.Array);
    }

    /// <summary>A client that authenticates as the AI platform (API key only, no user envelope).</summary>
    internal static HttpClient Platform<T>(ModulusWebAppFactory<T> factory)
        where T : class
    {
        var client = factory.CreateClient();
        client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("ApiKey", PlatformKey);
        return client;
    }
}
