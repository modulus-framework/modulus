using {{ project_name }}.ApiClients;
using {{ project_name }}.Configuration;
using {{ project_name }}.Endpoints;
using {{ project_name }}.Middleware;
using {{ project_name }}.Observability;
using {{ project_name }}.Security;

// {{ client_pascal }} BFF: the backend for the {{ client_name }} client. It authenticates {{ if is_web }}browser sessions
// (cookie; the browser never sees a token){{ else if is_mobile }}the app's bearer tokens{{ else }}partners' client-credentials tokens{{ end }}
// against the auth server, applies the client's edge rules, proxies /api/** to the API with YARP and hosts
// client-shaped aggregate endpoints. Settings: the "Bff" section of appsettings.json.
var builder = WebApplication.CreateBuilder(args);

// The BFF composes one setup file per concern, in the order the pipeline depends on. This file only composes them.
builder.Services.Add{{ client_pascal }}BffCore(builder.Configuration, builder.Environment);
builder.Services.Add{{ client_pascal }}BffSession(builder.Configuration);
builder.Services.Add{{ client_pascal }}BffHealthChecks();

// One typed client per module (ApiClients/), each on its upstream service.
builder.Services.AddModuleApiClients();

var app = builder.Build();

app.Use{{ client_pascal }}BffPipeline();
app.Map{{ client_pascal }}BffEndpoints();

app.Run();

public partial class Program;

// Namespaced entry-point marker for the integration tests, as in the API and Web hosts: each host's Program is global, so a
// test project that references several hosts names this one through its marker.
namespace {{ project_name }}
{
    public sealed class BffEntryPoint;
}
