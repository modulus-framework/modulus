<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Cobytelabs.Modulus.Core" Version="{{ framework_version }}" />
    <PackageReference Include="Cobytelabs.Modulus.Mediator" Version="{{ framework_version }}" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../{{ root_namespace }}.Shared.Domain/{{ root_namespace }}.Shared.Domain.csproj" />
  </ItemGroup>

</Project>
