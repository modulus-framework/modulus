<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>{{ target_framework }}</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Synvro.Modulus.Core" Version="{{ framework_version }}" />
    <PackageReference Include="Synvro.Modulus.AspNetCore" Version="{{ framework_version }}" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../{{ root_namespace }}.Shared.Application/{{ root_namespace }}.Shared.Application.csproj" />
  </ItemGroup>

</Project>
