<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Modulus.Core" Version="1.0.0" />
    <PackageReference Include="Modulus.EntityFrameworkCore" Version="1.0.0" />
    <PackageReference Include="Modulus.Data.Abstractions" Version="1.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../{{ root_namespace }}.Shared.Application/{{ root_namespace }}.Shared.Application.csproj" />
  </ItemGroup>

</Project>
