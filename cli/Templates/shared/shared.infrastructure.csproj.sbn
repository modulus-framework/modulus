<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>{{ target_framework }}</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Synvro.Modulus.Core" Version="{{ framework_version }}" />
    <PackageReference Include="Synvro.Modulus.EntityFrameworkCore" Version="{{ framework_version }}" />
    <PackageReference Include="Synvro.Modulus.Data.Abstractions" Version="{{ framework_version }}" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="{{ ef_core_version }}" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../{{ root_namespace }}.Shared.Application/{{ root_namespace }}.Shared.Application.csproj" />
  </ItemGroup>

</Project>
