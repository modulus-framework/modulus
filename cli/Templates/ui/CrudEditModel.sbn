using System.ComponentModel.DataAnnotations;
using Microsoft.AspNetCore.Mvc;
using Microsoft.AspNetCore.Mvc.RazorPages;
using {{ ui_namespace }}.ApiClients;

namespace {{ ui_namespace }}.Pages.{{ entity_name_plural }};

/// <summary>Creates a {{ entity_name }} (no id) or edits one (<c>?id=</c>) through the {{ module_name }} API.</summary>
public class EditModel({{ entity_name }}ApiClient api) : PageModel
{
    [BindProperty]
    public InputModel Input { get; set; } = new();

    public bool IsNew => Input.Id == Guid.Empty;

    public async Task<IActionResult> OnGetAsync(Guid? id, CancellationToken ct)
    {
        if (id is null || id == Guid.Empty)
            return Page();

        var existing = await api.GetByIdAsync(id.Value, ct);
        if (existing is null)
            return NotFound();

        Input = new InputModel { Id = existing.Id, Name = existing.Name };
        return Page();
    }

    public async Task<IActionResult> OnPostAsync(CancellationToken ct)
    {
        if (!ModelState.IsValid)
            return Page();

        try
        {
            var saved = IsNew
                ? await api.CreateAsync(new Create{{ entity_name }}Dto { Name = Input.Name }, ct) != Guid.Empty
                : await api.UpdateAsync(Input.Id, new Update{{ entity_name }}Dto { Name = Input.Name }, ct);
            if (!saved)
            {
                ModelState.AddModelError(string.Empty, "The API refused the change.");
                return Page();
            }
        }
        catch (HttpRequestException)
        {
            ModelState.AddModelError(string.Empty, "The API could not be reached.");
            return Page();
        }

        TempData["Message"] = "Saved.";
        return RedirectToPage("Index");
    }

    public sealed class InputModel
    {
        public Guid Id { get; set; }

        [Required, StringLength(200)]
        public string Name { get; set; } = string.Empty;
    }
}
