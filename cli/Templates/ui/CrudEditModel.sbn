using Microsoft.AspNetCore.Mvc;
using {{ ui_namespace }}.Services.ApiClients;

namespace {{ ui_namespace }}.Pages.{{ module_name }}.{{ entity_name_plural }};

/// <summary>Edits a {{ entity_name | string.downcase }} (<c>?id=</c>) through the {{ module_name }} API. Creating one is the Create page.</summary>
public class EditModel({{ entity_name }}ApiClient api) : {{ entity_name }}FormModel
{
    public async Task<IActionResult> OnGetAsync(Guid? id, CancellationToken ct)
    {
        if (id is null || id == Guid.Empty)
            return RedirectToPage("Create");

        var existing = await api.GetByIdAsync(id.Value, ct);
        if (existing is null)
            return NotFound();

        Input = new {{ entity_name }}Input { Id = existing.Id, Name = existing.Name };
        return Page();
    }

    public async Task<IActionResult> OnPostAsync(CancellationToken ct)
    {
        if (!ModelState.IsValid)
            return Page();

        try
        {
            if (!await api.UpdateAsync(Input.Id, new Update{{ entity_name }}Dto { Name = Input.Name }, ct))
            {
                ModelState.AddModelError(string.Empty, "The API refused the change.");
                return Page();
            }
        }
        catch (HttpRequestException)
        {
            ModelState.AddModelError(string.Empty, "The API could not be reached.");
            return Page();
        }

        TempData["Message"] = "Saved.";
        return RedirectToPage("Index");
    }
}
