using Microsoft.AspNetCore.Antiforgery;
using Modulus.AspNetCore.Fluid;
using Modulus.AspNetCore.Security.Policy;
using {{ root_namespace }}.Web.Configuration;
using {{ root_namespace }}.Web.Services.ApiClients;

namespace {{ root_namespace }}.Web.Endpoints;

/// <summary>
/// Password recovery on the Fluid host: asking for a reset link and setting the new password. Both calls go to the API's
/// <c>/account/*</c> endpoints through <see cref="AccountApiClient"/> without a token (nobody is signed in yet). The API answers the
/// same whether or not the address has an account, so the page does too. The pages are Templates/auth/forgot-password.liquid and
/// Templates/auth/reset-password.liquid.
/// </summary>
public static class AccountRecoveryEndpoints
{
    public static WebApplication MapAccountRecovery(this WebApplication app, string templates)
    {
        app.MapGet("/auth/forgot-password", (HttpContext context, IAntiforgery antiforgery, ModulusLiquid liquid) =>
                Render(liquid, templates, "auth/forgot-password", "Forgot password", context, antiforgery, new Dictionary<string, object?>()))
            .Loosen("Password recovery: anonymous by design");

        app.MapPost("/auth/forgot-password", async (HttpContext context, IAntiforgery antiforgery, AccountApiClient accounts, ModulusLiquid liquid) =>
            {
                if (!await ValidAntiforgery(context, antiforgery)) return Results.BadRequest();
                var form = await context.Request.ReadFormAsync();
                var email = form["email"].ToString().Trim();
                var values = new Dictionary<string, object?> { ["email"] = email };
                if (email.Length == 0)
                    values["error"] = "Enter your email address.";
                else if (await accounts.RequestResetAsync(email, context.RequestAborted) is { } error)
                    values["error"] = error;
                else
                    values["sent"] = true;
                return Render(liquid, templates, "auth/forgot-password", "Forgot password", context, antiforgery, values);
            }).RequireRateLimiting(RateLimitingSetup.SignInPolicy)
            .Loosen("Password recovery: the API answers the same for every address");

        // /ResetPassword is the path the API's reset email links to; /auth/reset-password is the same page.
        foreach (var route in new[] { "/auth/reset-password", "/ResetPassword" })
            app.MapGet(route, (HttpContext context, IAntiforgery antiforgery, ModulusLiquid liquid) =>
                    Render(liquid, templates, "auth/reset-password", "Reset password", context, antiforgery, new Dictionary<string, object?>
                    {
                        ["token"] = context.Request.Query["token"].ToString(),
                        ["email"] = context.Request.Query["email"].ToString(),
                    }))
                .Loosen("Password recovery: the link carries a one-time token");

        app.MapPost("/auth/reset-password", async (HttpContext context, IAntiforgery antiforgery, AccountApiClient accounts, ModulusLiquid liquid) =>
            {
                if (!await ValidAntiforgery(context, antiforgery)) return Results.BadRequest();
                var form = await context.Request.ReadFormAsync();
                var token = form["token"].ToString();
                var email = form["email"].ToString().Trim();
                var password = form["password"].ToString();
                string? error = null;
                if (token.Length == 0 || email.Length == 0)
                    error = "The link is invalid or has expired. Request a new one.";
                else if (password.Length < 8)
                    error = "The password must have at least 8 characters.";
                else if (password != form["confirm"].ToString())
                    error = "The two passwords are not the same.";
                else
                    error = await accounts.ResetPasswordAsync(email, token, password, context.RequestAborted);
                if (error is null)
                    return Results.LocalRedirect("/auth/login?reset=1");
                return Render(liquid, templates, "auth/reset-password", "Reset password", context, antiforgery, new Dictionary<string, object?>
                {
                    ["token"] = token,
                    ["email"] = email,
                    ["error"] = error,
                });
            }).RequireRateLimiting(RateLimitingSetup.SignInPolicy)
            .Loosen("Password recovery: the one-time token is checked by the API");

        return app;
    }

    private static IResult Render(ModulusLiquid liquid, string templates, string page, string title, HttpContext context, IAntiforgery antiforgery, Dictionary<string, object?> values)
    {
        values["title"] = title;
        values["app_name"] = "{{ root_namespace }}";
        values["antiforgery_token"] = antiforgery.GetAndStoreTokens(context).RequestToken;
        var html = liquid.RenderPage(
            liquid.Load(Path.Combine(templates, page + ".liquid")),
            liquid.Load(Path.Combine(templates, "_layout.liquid")),
            values);
        return Results.Content(html, "text/html; charset=utf-8");
    }

    private static async Task<bool> ValidAntiforgery(HttpContext context, IAntiforgery antiforgery)
    {
        try
        {
            await antiforgery.ValidateRequestAsync(context);
            return true;
        }
        catch (AntiforgeryValidationException)
        {
            return false;
        }
    }
}
