using System.Net.Http.Headers;
using System.Net.Http.Json;
using System.Security.Claims;
using Microsoft.AspNetCore.Authorization;
using Microsoft.Extensions.Options;

namespace {{ ui_namespace }}.Ai;

/// <summary>Settings under <c>Ai:Host</c>. The API key is a secret: keep it in user secrets or a vault, never in appsettings.json.</summary>
public sealed class AiAssistantOptions
{
    public const string Section = "Ai:Host";

    /// <summary>Feature flag: when false the endpoint is not mapped and the assistant renders nothing.</summary>
    public bool Enabled { get; set; }

    /// <summary>Base URL of the AI platform gateway (for example https://ai.example.com).</summary>
    public string BaseUrl { get; set; } = "";

    /// <summary>The host API key, held server-side only. Set it with <c>dotnet user-secrets set Ai:Host:ApiKey ...</c>.</summary>
    public string ApiKey { get; set; } = "";

    /// <summary>Path of the self-hosted SDK script that defines the &lt;ai-assistant&gt; element (kept local so the CSP stays clean).</summary>
    public string SdkScript { get; set; } = "/lib/ai-sdk/ai-assistant.js";

    /// <summary>Policy a user needs to use the assistant, when the app defines it (a user who is signed in but fails it gets a 403). Without the policy, sign-in alone gates it.</summary>
    public string Permission { get; set; } = "ai:use";
}

public static class AiAssistantExtensions
{
    public static IServiceCollection AddAiAssistant(this IServiceCollection services, IConfiguration configuration)
    {
        services.Configure<AiAssistantOptions>(configuration.GetSection(AiAssistantOptions.Section));
        services.AddHttpClient("ai-platform");
        return services;
    }

    /// <summary><c>POST /ai/session</c>: mints a short-lived platform session token for the signed-in user. The SDK then talks to the platform directly.</summary>
    public static IEndpointRouteBuilder MapAiAssistant(this IEndpointRouteBuilder app)
    {
        if (!app.ServiceProvider.GetRequiredService<IOptions<AiAssistantOptions>>().Value.Enabled)
            return app;

        app.MapPost("/ai/session", async (ClaimsPrincipal user, IHttpClientFactory http,
            IAuthorizationService authorization, IAuthorizationPolicyProvider policies, IOptions<AiAssistantOptions> opts, CancellationToken ct) =>
        {
            var o = opts.Value;
            if (string.IsNullOrWhiteSpace(o.BaseUrl) || string.IsNullOrWhiteSpace(o.ApiKey))
                return Results.Problem("The AI assistant is enabled but Ai:Host:BaseUrl or Ai:Host:ApiKey is not set.", statusCode: 503);

            // Signed in is the floor; when the app defines the permission's policy, the user must also satisfy it.
            if (await policies.GetPolicyAsync(o.Permission) is not null
                && !(await authorization.AuthorizeAsync(user, null, o.Permission)).Succeeded)
                return Results.Forbid();

            var request = new HttpRequestMessage(HttpMethod.Post, new Uri(new Uri(o.BaseUrl), "/v1/session-tokens"))
            {
                Content = JsonContent.Create(new
                {
                    subject = user.FindFirstValue(ClaimTypes.NameIdentifier),
                    tenantId = user.FindFirstValue("tenant_id"),
                }),
            };
            request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", o.ApiKey);

            using var response = await http.CreateClient("ai-platform").SendAsync(request, ct);
            if (!response.IsSuccessStatusCode)
                return Results.Problem("The AI platform refused the session request.", statusCode: 502);

            return Results.Content(await response.Content.ReadAsStringAsync(ct), "application/json");
        }).RequireAuthorization();
        return app;
    }
}
