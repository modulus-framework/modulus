using System.Globalization;
using System.Net;
using Microsoft.AspNetCore.Antiforgery;
using Modulus.AspNetCore.Fluid;
using {{ module_namespace }}.Application.Dtos;
using {{ ui_namespace }}.Services.ApiClients;

namespace {{ ui_namespace }}.Endpoints;

/// <summary>
/// The {{ entity_name | string.downcase }} pages on the Fluid host: a list with paging, a create form, an edit form and delete. The pages
/// are the Liquid files in Templates/Shared/Crud/{{ route_name }}, rendered here with the values from {{ entity_name }}ApiClient. Every
/// form post checks the antiforgery token{{ if use_auth }}, and every route needs a signed-in user{{ end }}.
/// </summary>
public static class {{ entity_name }}CrudEndpoints
{
    private const int PageSize = 20;
    private const string ListPath = "{{ list_path }}";
    private const string FormPath = "{{ form_path }}";

    // The messages after a save or delete, by the code the redirect carries (never free text from the URL).
    private static readonly Dictionary<string, string> Done = new(StringComparer.Ordinal)
    {
        ["created"] = "{{ entity_name }} created.",
        ["updated"] = "{{ entity_name }} saved.",
        ["deleted"] = "{{ entity_name }} deleted.",
    };

    public static WebApplication Map{{ entity_name_plural }}Crud(this WebApplication app, string templates)
    {
        app.MapGet("/{{ route_name }}", async (HttpContext context, {{ entity_name }}ApiClient api, ModulusLiquid liquid, IAntiforgery antiforgery, CancellationToken ct) =>
        {
            var page = int.TryParse(context.Request.Query["p"].ToString(), out var number) && number >= 1 ? number : 1;
            var rows = await api.GetAsync(page, PageSize, ct);
            return Render(liquid, templates, ListPath, "{{ entity_name_plural }}", context, antiforgery, new Dictionary<string, object?>
            {
                ["rows"] = rows.Select(Row).ToList(),
                ["page"] = page,
                ["has_prev"] = page > 1,
                ["prev_page"] = page - 1,
                ["has_next"] = rows.Count == PageSize,
                ["next_page"] = page + 1,
                ["message"] = Done.GetValueOrDefault(context.Request.Query["done"].ToString()) ?? string.Empty,
            });
        }){{ if use_auth }}.RequireAuthorization(){{ end }};

        app.MapGet("/{{ route_name }}/new", (HttpContext context, ModulusLiquid liquid, IAntiforgery antiforgery) =>
            Form(liquid, templates, context, antiforgery, "New {{ entity_name | string.downcase }}", "/{{ route_name }}/new", new Dictionary<string, object?>(), [])){{ if use_auth }}.RequireAuthorization(){{ end }};

        app.MapPost("/{{ route_name }}/new", async (HttpContext context, {{ entity_name }}ApiClient api, ModulusLiquid liquid, IAntiforgery antiforgery, CancellationToken ct) =>
        {
            if (!await ValidAntiforgery(context, antiforgery)) return Results.BadRequest();
            var form = await context.Request.ReadFormAsync(ct);
            var errors = new List<string>();
{{ for f in fields }}{{ if f.parser == 'text' }}            var {{ f.camel }} = Text(form, "{{ f.camel }}", "{{ f.label }}", {{ if f.required }}true{{ else }}false{{ end }}, errors);
{{ else if f.parser == 'flag' }}            var {{ f.camel }} = Flag(form, "{{ f.camel }}");
{{ else }}            var {{ f.camel }} = Number<{{ f.bare }}>(form, "{{ f.camel }}", "{{ f.label }}", errors);
{{ end }}{{ end }}
            if (errors.Count == 0)
            {
                try
                {
                    await api.CreateAsync(new Create{{ entity_name }}Dto
                    {
{{ for f in fields }}                        {{ f.name }} = {{ if f.parser == 'flag' }}{{ f.camel }}{{ else }}{{ f.camel }} ?? {{ f.fallback }}{{ end }},
{{ end }}                    }, ct);
                    return Results.LocalRedirect("/{{ route_name }}?done=created");
                }
                catch (HttpRequestException error)
                {
                    errors.Add(Describe(error));
                }
            }
            return Form(liquid, templates, context, antiforgery, "New {{ entity_name | string.downcase }}", "/{{ route_name }}/new", Submitted(form), errors);
        }){{ if use_auth }}.RequireAuthorization(){{ end }};

        app.MapGet("/{{ route_name }}/{id:guid}/edit", async (Guid id, HttpContext context, {{ entity_name }}ApiClient api, ModulusLiquid liquid, IAntiforgery antiforgery, CancellationToken ct) =>
        {
            var item = await api.GetByIdAsync(id, ct);
            return item is null
                ? Results.NotFound()
                : Form(liquid, templates, context, antiforgery, "Edit {{ entity_name | string.downcase }}", $"/{{ route_name }}/{id}/edit", Row(item), []);
        }){{ if use_auth }}.RequireAuthorization(){{ end }};

        app.MapPost("/{{ route_name }}/{id:guid}/edit", async (Guid id, HttpContext context, {{ entity_name }}ApiClient api, ModulusLiquid liquid, IAntiforgery antiforgery, CancellationToken ct) =>
        {
            if (!await ValidAntiforgery(context, antiforgery)) return Results.BadRequest();
            var form = await context.Request.ReadFormAsync(ct);
            var errors = new List<string>();
{{ for f in fields }}{{ if f.parser == 'text' }}            var {{ f.camel }} = Text(form, "{{ f.camel }}", "{{ f.label }}", {{ if f.required }}true{{ else }}false{{ end }}, errors);
{{ else if f.parser == 'flag' }}            var {{ f.camel }} = Flag(form, "{{ f.camel }}");
{{ else }}            var {{ f.camel }} = Number<{{ f.bare }}>(form, "{{ f.camel }}", "{{ f.label }}", errors);
{{ end }}{{ end }}
            if (errors.Count == 0)
            {
                try
                {
                    return await api.UpdateAsync(id, new Update{{ entity_name }}Dto
                    {
{{ for f in fields }}                        {{ f.name }} = {{ if f.parser == 'text' }}{{ f.camel }} ?? string.Empty{{ else }}{{ f.camel }}{{ end }},
{{ end }}                    }, ct)
                        ? Results.LocalRedirect("/{{ route_name }}?done=updated")
                        : Results.NotFound();
                }
                catch (HttpRequestException error)
                {
                    errors.Add(Describe(error));
                }
            }
            return Form(liquid, templates, context, antiforgery, "Edit {{ entity_name | string.downcase }}", $"/{{ route_name }}/{id}/edit", Submitted(form), errors);
        }){{ if use_auth }}.RequireAuthorization(){{ end }};

        app.MapPost("/{{ route_name }}/{id:guid}/delete", async (Guid id, HttpContext context, {{ entity_name }}ApiClient api, IAntiforgery antiforgery, CancellationToken ct) =>
        {
            if (!await ValidAntiforgery(context, antiforgery)) return Results.BadRequest();
            return await api.DeleteAsync(id, ct)
                ? Results.LocalRedirect("/{{ route_name }}?done=deleted")
                : Results.NotFound();
        }){{ if use_auth }}.RequireAuthorization(){{ end }};

        return app;
    }

    // The values of one row, as the pages show them. The id is the route key of the edit and delete links.
    private static Dictionary<string, object?> Row({{ entity_name }}Dto item) => new()
    {
        ["id"] = item.Id,
{{ for f in fields }}        ["{{ f.camel }}"] = Show(item.{{ f.name }}),
{{ end }}    };

    // The values of a form that came back with errors: what the visitor typed, so nothing is lost.
    private static Dictionary<string, object?> Submitted(IFormCollection form) => new()
    {
{{ for f in fields }}{{ if f.parser == 'flag' }}        ["{{ f.camel }}"] = Flag(form, "{{ f.camel }}") ? "true" : "false",
{{ else }}        ["{{ f.camel }}"] = form["{{ f.camel }}"].ToString(),
{{ end }}{{ end }}    };

    private static IResult Form(ModulusLiquid liquid, string templates, HttpContext context, IAntiforgery antiforgery, string title, string action, Dictionary<string, object?> fields, List<string> errors)
    {
        var page = new Dictionary<string, object?>
        {
            ["action"] = action,
            ["errors"] = errors,
            ["values"] = fields,
        };
        return Render(liquid, templates, FormPath, title, context, antiforgery, page);
    }

    private static IResult Render(ModulusLiquid liquid, string templates, string page, string title, HttpContext context, IAntiforgery antiforgery, Dictionary<string, object?> values)
    {
        values["title"] = title;
        values["antiforgery_token"] = antiforgery.GetAndStoreTokens(context).RequestToken;
        var html = liquid.RenderPage(
            liquid.Load(Path.Combine(templates, page)),
            liquid.Load(Path.Combine(templates, "_layout.liquid")),
            values);
        return Results.Content(html, "text/html; charset=utf-8");
    }

    // A value as a page shows it. Dates use the form of a date input, so an edit form can send them back unchanged.
    private static string Show(object? value) => value switch
    {
        null => string.Empty,
        bool flag => flag ? "true" : "false",
        DateTime time => time.ToString("yyyy-MM-ddTHH:mm", CultureInfo.InvariantCulture),
        DateTimeOffset offset => offset.ToString("yyyy-MM-ddTHH:mm", CultureInfo.InvariantCulture),
        DateOnly day => day.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
        IFormattable formattable => formattable.ToString(null, CultureInfo.InvariantCulture),
        _ => value.ToString() ?? string.Empty,
    };

    // A text field: trimmed, and null when empty (an error when the field is required).
    private static string? Text(IFormCollection form, string key, string label, bool required, List<string> errors)
    {
        var value = form[key].ToString().Trim();
        if (value.Length > 0)
            return value;
        if (required)
            errors.Add($"{label} is required.");
        return null;
    }

    // A checkbox: it sends its value only when ticked.
    private static bool Flag(IFormCollection form, string key) => form[key].Count > 0;

    // A typed field (number, date, time, Guid): null when empty, and an error when the text is not a value of the type.
    private static T? Number<T>(IFormCollection form, string key, string label, List<string> errors) where T : struct, IParsable<T>
    {
        var text = form[key].ToString().Trim();
        if (text.Length == 0)
            return null;
        if (T.TryParse(text, CultureInfo.InvariantCulture, out var value))
            return value;
        errors.Add($"{label} is not a valid value.");
        return null;
    }

    private static string Describe(HttpRequestException error) => error.StatusCode == HttpStatusCode.Forbidden
        ? "You do not have permission to make this change."
        : "The API could not be reached or refused the change.";

    private static async Task<bool> ValidAntiforgery(HttpContext context, IAntiforgery antiforgery)
    {
        try
        {
            await antiforgery.ValidateRequestAsync(context);
            return true;
        }
        catch (AntiforgeryValidationException)
        {
            return false;
        }
    }
}
