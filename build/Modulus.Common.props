<Project>

  <!-- ════════════════════════════════════════════════════════════════
       Modulus.Common.props

       Compilation, language, and global-analysis settings applied to
       EVERY project in the repository (src + tests + tools).
       Imported by the root Directory.Build.props.
       ════════════════════════════════════════════════════════════════ -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;NU1510;NU1902</NoWarn>
    <!-- NU1902: Microsoft.Build.Tasks.Git 8.0.0 (via Microsoft.SourceLink.GitHub,
         PrivateAssets=All build-time only) has a moderate advisory. Suppressed
         globally so restores stay green under TreatWarningsAsErrors; revisit on
         SourceLink bump. -->
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
    <AssemblyName>$(MSBuildProjectName)</AssemblyName>
  </PropertyGroup>

  <!-- Release-only optimisations -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <!-- ── Global usings (every project) ───────────────────────────── -->
  <ItemGroup>
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
    <Using Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <!-- ── Global package references (every project) ──────────────── -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <!-- ── Code-quality analyzers (every project) ─────────────────── -->
  <ItemGroup>
    <PackageReference Include="Roslynator.Analyzers" PrivateAssets="All" />
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" PrivateAssets="All" />
  </ItemGroup>



</Project>
