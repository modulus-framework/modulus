<Project>

  <!-- ════════════════════════════════════════════════════════════════
       Modulus.Test.props

       Settings shared by every test project.  Imported by
       tests/Directory.Build.props after the root Directory.Build.props
       so that it can override packaging-related defaults.
       ════════════════════════════════════════════════════════════════ -->

  <PropertyGroup>
    <!-- Every test project runs on both supported runtimes by default (net8.0 and net10.0). To run one target only:
         dotnet test -p:ModulusTestTfm=net8.0 (restore with it too). Projects that need a single runtime (the CLI, which
         ships for net10.0 only) set TargetFrameworks themselves. -->
    <TargetFramework />
    <TargetFrameworks Condition="'$(ModulusTestTfm)' == ''">net8.0;net10.0</TargetFrameworks>
    <TargetFramework Condition="'$(ModulusTestTfm)' != ''">$(ModulusTestTfm)</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

</Project>
