<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!--
      The Cobytelabs.Modulus.* framework packages are published to nuget.org
      (v1.2.0). Restore them from there like any other dependency. The local
      nupkg/ feed in the framework repo is only needed for unpublished/proto builds.
    -->
  </packageSources>
</configuration>
