<Project>
  <PropertyGroup>
    <!-- The generated csproj files declare explicit Versions on each
         PackageReference, so we disable Central Package Management.
         This also stops the SDK from inheriting Directory.Packages.props
         from any parent directory (e.g. when the generated app is
         placed inside another repo that uses CPM). -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>
</Project>
