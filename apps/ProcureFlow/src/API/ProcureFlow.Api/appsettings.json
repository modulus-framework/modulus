{
  "ConnectionStrings": {
    "Identity": "Host=localhost;Database=procureflow_identity;Username=pf;Password=Pf-dev-1234",
    "TenantManagement": "Host=localhost;Database=procureflow_tenant_management;Username=pf;Password=Pf-dev-1234",
    "Organization": "Host=localhost;Database=procureflow_organization;Username=pf;Password=Pf-dev-1234",
    "Catalog": "Host=localhost;Database=procureflow_catalog;Username=pf;Password=Pf-dev-1234",
    "SupplierManagement": "Host=localhost;Database=procureflow_supplier_management;Username=pf;Password=Pf-dev-1234",
    "Procurement": "Host=localhost;Database=procureflow_procurement;Username=pf;Password=Pf-dev-1234",
    "Approval": "Host=localhost;Database=procureflow_approval;Username=pf;Password=Pf-dev-1234",
    "Warehouse": "Host=localhost;Database=procureflow_warehouse;Username=pf;Password=Pf-dev-1234",
    "Inventory": "Host=localhost;Database=procureflow_inventory;Username=pf;Password=Pf-dev-1234",
    "Finance": "Host=localhost;Database=procureflow_finance;Username=pf;Password=Pf-dev-1234",
    "Payment": "Host=localhost;Database=procureflow_payment;Username=pf;Password=Pf-dev-1234",
    "Notification": "Host=localhost;Database=procureflow_notification;Username=pf;Password=Pf-dev-1234",
    "Audit": "Host=localhost;Database=procureflow_audit;Username=pf;Password=Pf-dev-1234",
    "Reporting": "Host=localhost;Database=procureflow_reporting;Username=pf;Password=Pf-dev-1234"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Correlation": {
    "HeaderName": "X-Correlation-ID",
    "IncludeInResponse": true,
    "UseTraceIdWhenMissing": true
  },
  "Idempotency": {
    "HeaderName": "Idempotency-Key",
    "Methods": [ "POST", "PATCH" ],
    "RequireKey": false,
    "ValidateRequestMatch": true,
    "RetentionSeconds": 86400
  },
  "OpenApi": {
    "Title": "ProcureFlow API",
    "Version": "v1",
    "IncludeBearerSecurity": true
  },
  "ApiVersioning": {
    "DefaultVersion": "1.0",
    "AssumeDefaultVersionWhenUnspecified": true,
    "ReportApiVersions": true
  },
  "RateLimiting": {
    "Enabled": true,
    "PermitLimit": 100,
    "WindowSeconds": 60,
    "QueueLimit": 0,
    "Partition": "User"
  },
  "Cors": {
    "AllowedOrigins": [],
    "AllowedMethods": [],
    "AllowedHeaders": [],
    "AllowCredentials": false
  },
  "SecurityHeaders": {
    "ContentTypeOptions": true,
    "FrameOptions": "DENY",
    "ReferrerPolicy": "strict-origin-when-cross-origin",
    "EnableHsts": true
  },
  "FeatureManagement": {
    "SampleFeature": false
  },
  "SecretsGuard": {
    "Enabled": true,
    "FailOnViolation": true
  },
  "PersonalDataProtection": {
    "Enabled": true,
    "Purpose": "Modulus.PersonalData.Protector.v1"
  },
  "Identity": {
    "UseDevelopmentCertificates": false,
    "AccessTokenLifetimeMin": 15,
    "RefreshTokenLifetimeDays": 7
  },
  "AllowedHosts": "*"
}
