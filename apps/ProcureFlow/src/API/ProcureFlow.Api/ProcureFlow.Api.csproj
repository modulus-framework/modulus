<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>355eedd2-09ad-402b-b56b-770bb71140c3</UserSecretsId>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.AspNetCore.OpenApi.Generated</InterceptorsNamespaces>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Cobytelabs.Modulus.Core" Version="1.2.0" />
    <PackageReference Include="Cobytelabs.Modulus.AspNetCore" Version="1.2.0" />
    <PackageReference Include="Cobytelabs.Modulus.Platform" Version="1.2.0" />
    <PackageReference Include="Cobytelabs.Modulus.MultiTenancy.EntityFrameworkCore" Version="1.2.0" />
    <PackageReference Include="Cobytelabs.Modulus.Caching.Redis" Version="1.2.0" />
    <PackageReference Include="Cobytelabs.Modulus.AspNetCore.Redis" Version="1.2.0" />
    <PackageReference Include="Cobytelabs.Modulus.Mediator" Version="1.2.0" />
    <PackageReference Include="Cobytelabs.Modulus.Events" Version="1.2.0" />
    <PackageReference Include="Cobytelabs.Modulus.Outbox" Version="1.2.0" />
    <PackageReference Include="Cobytelabs.Modulus.Outbox.Abstractions" Version="1.2.0" />
    <PackageReference Include="Cobytelabs.Modulus.Inbox" Version="1.2.0" />
    <PackageReference Include="Cobytelabs.Modulus.EventBus.RabbitMQ" Version="1.2.0" />
    <PackageReference Include="Cobytelabs.Modulus.EntityFrameworkCore" Version="1.2.0" />
    <PackageReference Include="Cobytelabs.Modulus.Identity" Version="1.2.0" />
    <PackageReference Include="Cobytelabs.Modulus.Observability" Version="1.2.0" />
    <ProjectReference Include="../../Shared/ProcureFlow.Shared.Infrastructure/ProcureFlow.Shared.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Transitive pin: AspNetCore.OpenApi floats to Microsoft.OpenApi 2.0.0,
         which has a high-severity advisory (GHSA-v5pm-xwqc-g5wc). Pin to latest 2.x. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.9.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />
    <!-- Version unification pins (mirror the ModulusSampleErp app): the OpenIddict
         transitive graph floats Microsoft.IdentityModel.* to 8.0.1 while OpenIddict 7.5.0
         requires JsonWebTokens >= 8.16.0; align the whole IdentityModel family so the
         MSB3277 assembly conflict and NU1605 downgrade are resolved. -->
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.16.0" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.16.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.16.0" />
  </ItemGroup>

