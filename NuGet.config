<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- Local verification feed (framework build itself restores from nuget.org only).
         To test packed Cobytelabs.Modulus.* 1.3.0 locally (see build/Modulus.Packaging.props
         VersionPrefix), run: dotnet pack modulus.slnx -c Release -o ./nupkg
         then restore consumers with an added ./nupkg source or a modulus-local source.
         Generated apps wire this via the modulus app package-source option. -->
  </packageSources>
</configuration>
