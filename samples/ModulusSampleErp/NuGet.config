<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!--
      The Cobytelabs.Modulus.* packages are not on nuget.org yet. This sample
      restores them from the framework repo's local nupkg/ feed (populated by
      'dotnet pack modulus.slnx -c Release').
    -->
    <add key="modulus-local" value="..\..\nupkg" />
  </packageSources>
</configuration>
