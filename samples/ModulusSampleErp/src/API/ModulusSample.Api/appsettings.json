{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Database": "",
    "Tenants": "",
    "Features": "",
    "VirtualFileExplorer": "",
    "Notifications": "",
    "Cache": "localhost:6379",
    "RabbitMq": "amqp://guest:guest@localhost:5672/%2f"
  },
  "Identity": {
    "Oidc": {
      "IssuerUrl": "",
      "InternalIssuerUrl": "",
      "AppSlug": "",
      "ClientId": "",
      "Audience": "",
      "RequireHttpsMetadata": true,
      "ClockSkewSeconds": 60
    },
    "Authentication": {
      "SessionTimeoutMinutes": 60
    }
  },
  "MessageBus": {
    "UseKafka": false,
    "RabbitMq": {
      "ConnectionString": "amqp://guest:guest@localhost:5672/%2f",
      "QueueName": "modulussample-events",
      "MaxRetries": 3,
      "PrefetchCount": 10
    },
    "Kafka": {
      "BootstrapServers": "localhost:9092",
      "GroupId": "modulussample-group",
      "TopicPrefix": "modulussample-",
      "MaxRetries": 3
    }
  },
  "Caching": {
    "Redis": {
      "ConnectionString": "localhost:6379"
    },
    "InMemory": {
      "SizeLimit": 1024,
      "ExpirationScanFrequency": "00:02:00"
    }
  },
  "Storage": {
    "Provider": "Local",
    "Local": {
      "BasePath": "uploads",
      "MaxFileSize": 10485760,
      "AllowedExtensions": ["jpg", "jpeg", "png", "webp", "gif", "pdf", "doc", "docx", "xls", "xlsx"]
    },
    "AzureBlobs": {
      "ConnectionString": "",
      "ContainerName": "modulussample-uploads"
    },
    "S3": {
      "BucketName": "modulussample-uploads",
      "Endpoint": "http://localhost:9000",
      "AccessKey": "minioadmin",
      "SecretKey": "minioadmin",
      "UseSSL": false,
      "Region": "us-east-1"
    }
  },
  "RateLimiting": {
    "Default": {
      "PermitLimit": 100,
      "QueueLimit": 10,
      "QueueProcessingOrder": "OldestFirst",
      "Window": "00:01:00"
    },
    "Anonymous": {
      "PermitLimit": 20,
      "QueueLimit": 5,
      "Window": "00:01:00"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:8000"
    ],
    "AllowedMethods": ["GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS"],
    "AllowedHeaders": ["Authorization", "Content-Type", "X-Requested-With", "X-Correlation-ID", "Idempotency-Key"],
    "AllowCredentials": true,
    "PreflightMaxAgeSeconds": 3600
  },
  "SecurityHeaders": {
    "ContentSecurityPolicy": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' https:; frame-ancestors 'none'; base-uri 'self'; form-action 'self';",
    "PermissionsPolicy": "geolocation=(), microphone=(), camera=()",
    "ReferrerPolicy": "strict-origin-when-cross-origin",
    "XContentTypeOptions": "nosniff",
    "XFrameOptions": "DENY",
    "XXSSProtection": "0",
    "StrictTransportSecurity": {
      "MaxAge": 31536000,
      "IncludeSubDomains": true,
      "Preload": false
    }
  },
  "Correlation": {
    "HeaderName": "X-Correlation-ID",
    "IncludeInResponse": true,
    "UseTraceIdWhenMissing": true
  },
  "Idempotency": {
    "HeaderName": "Idempotency-Key",
    "Methods": ["POST", "PATCH"],
    "RequireKey": false,
    "ValidateRequestMatch": true,
    "MaxKeyLength": 128,
    "RetentionSeconds": 86400
  },
  "ApiVersioning": {
    "DefaultVersion": "1.0",
    "AssumeDefaultVersionWhenUnspecified": true,
    "ReportApiVersions": true,
    "ReadFromQueryString": true,
    "ReadFromHeader": true,
    "ReadFromUrlSegment": true
  },
  "OpenApi": {
    "Title": "Modulus Sample ERP API",
    "Version": "v1",
    "Description": "Enterprise Resource Planning API built on Modulus framework",
    "Contact": {
      "Name": "Modulus Support",
      "Email": "support@modulussample.com",
      "Url": "https://modulussample.com/support"
    },
    "License": {
      "Name": "MIT",
      "Url": "https://opensource.org/licenses/MIT"
    }
  },
  "SecretsGuard": {
    "Enabled": true,
    "FailOnViolation": true,
    "Environments": ["Development", "Staging"],
    "SensitiveKeyPatterns": [
      "*Password*",
      "*Secret*",
      "*ApiKey*",
      "*ConnectionString*",
      "*Token*",
      "Sentry:Dsn",
      "*:ApiKey",
      "*:SecretKey"
    ]
  },
  "PersonalDataProtection": {
    "Enabled": false,
    "Purpose": "ModulusSamplePersonalData",
    "SearchHashKey": ""
  },
  "Identity": {
    "AllowPasswordFlow": true,
    "UseDevelopmentCertificates": true,
    "AccessTokenLifetimeMin": 30,
    "RefreshTokenLifetimeDays": 14,
    "RequireConfirmedEmail": false,
    "Clients": {
      "Clients": [
        {
          "ClientId": "modulussample-spa",
          "DisplayName": "Modulus Sample ERP SPA",
          "ConsentType": "explicit",
          "AllowAuthorizationCode": true,
          "AllowPasswordFlow": false,
          "AllowRefreshToken": true,
          "RequireClientSecret": false,
          "RedirectUris": [
            "http://localhost:3000/callback",
            "http://localhost:8000/callback"
          ],
          "PostLogoutRedirectUris": [
            "http://localhost:3000",
            "http://localhost:8000"
          ]
        },
        {
          "ClientId": "modulussample-swagger",
          "DisplayName": "Swagger UI",
          "ConsentType": "implicit",
          "AllowAuthorizationCode": true,
          "AllowPasswordFlow": false,
          "AllowRefreshToken": true,
          "RequireClientSecret": false,
          "RedirectUris": [
            "http://localhost:5000/swagger/oauth2-redirect.html",
            "https://localhost:5001/swagger/oauth2-redirect.html"
          ]
        }
      ]
    }
  },
  "FeatureManagement": {
    "SampleFeature": false
  },
  "SignalR": {
    "ClientTimeoutInterval": "00:00:30",
    "HandshakeTimeout": "00:00:15",
    "MaximumReceiveMessageSize": 32768,
    "KeepAliveInterval": "00:00:15",
    "EnableDetailedErrors": false
  },
  "HealthChecks": {
    "Liveness": {
      "Name": "liveness",
      "Tags": ["liveness"],
      "TimeoutSeconds": 5
    },
    "Readiness": {
      "Name": "readiness",
      "Tags": ["readiness"],
      "TimeoutSeconds": 10
    }
  },
  "MultiTenancy": {
    "HeaderName": "X-Tenant-ID",
    "QueryStringKey": "tenant",
    "IgnorePaths": ["/health", "/swagger"]
  },
  "OpenTelemetry": {
    "ServiceName": "ModulusSampleErp.Api",
    "ServiceVersion": "1.0.0",
    "Otlp": {
      "Endpoint": "",
      "Protocol": "Grpc"
    },
    "AspNetCore": {
      "RecordException": true
    }
  },
  "Sentry": {
    "Dsn": "",
    "SendDefaultPii": false,
    "TracesSampleRate": 0.0,
    "MaxBreadcrumbs": 200
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Modulus": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Modulus": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "WithOpenTelemetryTraceId",
      "WithOpenTelemetrySpanId"
    ],
    "Properties": {
      "Application": "ModulusSampleErp"
    }
  }
}
