<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!--
      The Cobytelabs.Modulus.* packages are not on nuget.org yet. This sample
      restores them from a sample-local feed folder (populated by
      'dotnet pack modulus.slnx -c Release -o samples/ProcureFlow/nupkg'
      from the framework repo root). Being inside the sample root keeps the
      folder within the Docker build context so the container image builds.
    -->
    <add key="modulus-local" value="nupkg" />
  </packageSources>
</configuration>
