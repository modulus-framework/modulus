<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!--
      The Cobytelabs.Modulus.* packages are resolved from a sample-local feed folder
      (populated by 'dotnet pack modulus.slnx -c Release -o samples/TradeFlow/nupkg'
      from the framework repo root). Being inside the sample root keeps the
      folder within the Docker build context so the container image builds.
      After the framework is published to nuget.org, this source can be removed
      and the mapping below deleted.
    -->
    <add key="modulus-local" value="nupkg" />
  </packageSources>
  <!-- Source mapping makes the local feed authoritative for framework
       packages: identical versions otherwise resolve non-deterministically. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" exclude="Cobytelabs.*" />
    </packageSource>
    <packageSource key="modulus-local">
      <package pattern="Cobytelabs.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
