<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Generate XML documentation for Swagger -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Suppress CS1591 warning about missing XML comments -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Shared\ProcureFlow.Shared.Presentation\ProcureFlow.Shared.Presentation.csproj"/>
    <ProjectReference Include="..\..\..\Shared\ProcureFlow.Shared.Infrastructure\ProcureFlow.Shared.Infrastructure.csproj"/>
    <ProjectReference Include="..\ProcureFlow.Modules.Identity.Application\ProcureFlow.Modules.Identity.Application.csproj" />
  </ItemGroup>

</Project>
