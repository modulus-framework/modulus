<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UserSecretsId>3b84b6cf-9038-4c95-a541-5f348d9c2511</UserSecretsId>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <DockerfileContext>..\..</DockerfileContext>
        <DockerComposeProjectPath>..\..\docker-compose.dcproj</DockerComposeProjectPath>
        <!-- Generate XML documentation for Swagger API documentation -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- Suppress CS1591 warning about missing XML comments -->
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="AspNetCore.HealthChecks.NpgSql" Version="8.0.1" />
        <PackageReference Include="AspNetCore.HealthChecks.Redis" Version="8.0.1" />
        <PackageReference Include="AspNetCore.HealthChecks.UI.Client" Version="8.0.1" />
        <PackageReference Include="AspNetCore.HealthChecks.Uris" Version="8.0.1" />
        <PackageReference Include="Cobytelabs.Modulus.AspNetCore" Version="1.2.0" />
        <PackageReference Include="Cobytelabs.Modulus.AspNetCore.Redis" Version="1.2.0" />
        <PackageReference Include="Cobytelabs.Modulus.Authorization.Management" Version="1.2.0" />
        <PackageReference Include="Cobytelabs.Modulus.Core" Version="1.2.0" />
        <PackageReference Include="Cobytelabs.Modulus.MultiTenancy.EntityFrameworkCore" Version="1.2.0" />
        <PackageReference Include="Cobytelabs.Modulus.EventBus.Kafka" Version="1.2.0" />
        <PackageReference Include="Cobytelabs.Modulus.EventBus.RabbitMQ" Version="1.2.0" />
        <PackageReference Include="Cobytelabs.Modulus.Observability" Version="1.2.0" />
        <PackageReference Include="Cobytelabs.Modulus.Platform" Version="1.2.0" />
        <PackageReference Include="Cobytelabs.Modulus.Sagas" Version="1.2.0" />
        <!-- Optional add-ons, disabled by default in this sample  see Program.cs for how to enable:
             Cobytelabs.Modulus.SignalR.Backplane   (Redis backplane for multi-node SignalR)
             Cobytelabs.Modulus.Storage.AzureBlobs  (Azure Blob file storage)
             Cobytelabs.Modulus.Storage.S3          (S3-compatible file storage, e.g. MinIO) -->
        <PackageReference Include="Cobytelabs.Modulus.Testing" Version="1.2.3" />
        <PackageReference Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" Version="10.0.3" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.9">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />
        <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.20.1" />
        <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.16.0" />
        <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.16.0" />
        <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.16.0" />
        <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.16.0" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.16.0" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.15.1" />
        <PackageReference Include="OpenTelemetry.Instrumentation.StackExchangeRedis" Version="1.16.0-beta.1" />
        <PackageReference Include="Sentry.AspNetCore" Version="6.6.0" />
        <PackageReference Include="Sentry.Serilog" Version="6.6.0" />
        <!-- Serilog with Seq -->
        <PackageReference Include="Serilog.AspNetCore" Version="8.0.1" />
        <PackageReference Include="Serilog.Enrichers.OpenTelemetry" Version="1.0.1" />
        <PackageReference Include="Serilog.Sinks.Seq" Version="7.0.0" />
        <!-- Swashbuckle for Swagger/OpenAPI documentation -->
        <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
        <!-- Pinned explicitly: Swashbuckle 10.2.3 brings Microsoft.OpenApi 2.7.5
             transitively while Modulus.AspNetCore brings 2.9.0 � pin to the
             newer one directly so the build doesn't rely on assembly unification. -->
        <PackageReference Include="Microsoft.OpenApi" Version="2.9.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Modules\Identity\ProcureFlow.Modules.Identity.Infrastructure\ProcureFlow.Modules.Identity.Infrastructure.csproj" />
        <ProjectReference Include="..\..\Modules\Configuration\ProcureFlow.Modules.Configuration.Infrastructure\ProcureFlow.Modules.Configuration.Infrastructure.csproj" />
        <ProjectReference Include="..\..\Modules\Tenants\ProcureFlow.Modules.Tenants.Infrastructure\ProcureFlow.Modules.Tenants.Infrastructure.csproj" />
        <ProjectReference Include="..\..\Modules\Notifications\ProcureFlow.Modules.Notifications.Infrastructure\ProcureFlow.Modules.Notifications.Infrastructure.csproj" />
        <ProjectReference Include="..\..\Modules\Vendors\ProcureFlow.Modules.Vendors.Infrastructure\ProcureFlow.Modules.Vendors.Infrastructure.csproj" />
        <ProjectReference Include="..\..\Modules\Budgeting\ProcureFlow.Modules.Budgeting.Infrastructure\ProcureFlow.Modules.Budgeting.Infrastructure.csproj" />
        <ProjectReference Include="..\..\Modules\Customs\ProcureFlow.Modules.Customs.Infrastructure\ProcureFlow.Modules.Customs.Infrastructure.csproj" />
        <ProjectReference Include="..\..\Modules\Procurement\ProcureFlow.Modules.Procurement.Infrastructure\ProcureFlow.Modules.Procurement.Infrastructure.csproj" />
        <ProjectReference Include="..\..\Modules\TradeFinance\ProcureFlow.Modules.TradeFinance.Infrastructure\ProcureFlow.Modules.TradeFinance.Infrastructure.csproj" />
        <ProjectReference Include="..\..\Modules\Import\ProcureFlow.Modules.Import.Infrastructure\ProcureFlow.Modules.Import.Infrastructure.csproj" />
        <ProjectReference Include="..\..\Modules\Inventory\ProcureFlow.Modules.Inventory.Infrastructure\ProcureFlow.Modules.Inventory.Infrastructure.csproj" />
        <ProjectReference Include="..\..\Modules\Costing\ProcureFlow.Modules.Costing.Infrastructure\ProcureFlow.Modules.Costing.Infrastructure.csproj" />
        <ProjectReference Include="..\..\Modules\Finance\ProcureFlow.Modules.Finance.Infrastructure\ProcureFlow.Modules.Finance.Infrastructure.csproj" />
        <ProjectReference Include="..\..\Modules\OrgStructure\ProcureFlow.Modules.OrgStructure.Infrastructure\ProcureFlow.Modules.OrgStructure.Infrastructure.csproj" />
        <ProjectReference Include="..\..\Modules\VirtualFileExplorer\ProcureFlow.Modules.VirtualFileExplorer.Infrastructure\ProcureFlow.Modules.VirtualFileExplorer.Infrastructure.csproj" />
        <ProjectReference Include="..\..\Modules\WorkflowEngine\ProcureFlow.Modules.WorkflowEngine.Infrastructure\ProcureFlow.Modules.WorkflowEngine.Infrastructure.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Content Update="modules.*.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ProcureFlow.Modules.Identity.UnitTests" />
    <InternalsVisibleTo Include="ProcureFlow.E2ETests" />
  </ItemGroup>

</Project>