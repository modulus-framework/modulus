{
  "AllowedHosts": "*",
  "Swagger": {
    "Enabled": true
  },
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=ProcureFlow;Username=ProcureFlow;Password=ProcureFlow",
    "Authorization": "Host=localhost;Port=5432;Database=ProcureFlow_Authorization;Username=ProcureFlow;Password=ProcureFlow",
    "Configuration": "Host=localhost;Port=5432;Database=ProcureFlow;Username=ProcureFlow;Password=ProcureFlow",
    "Tenants": "Host=localhost;Port=5432;Database=ProcureFlow;Username=ProcureFlow;Password=ProcureFlow",
    "Notifications": "Host=localhost;Port=5432;Database=ProcureFlow;Username=ProcureFlow;Password=ProcureFlow",
    "Vendors": "Host=localhost;Port=5432;Database=ProcureFlow;Username=ProcureFlow;Password=ProcureFlow",
    "Budgeting": "Host=localhost;Port=5432;Database=ProcureFlow;Username=ProcureFlow;Password=ProcureFlow",
    "Customs": "Host=localhost;Port=5432;Database=ProcureFlow;Username=ProcureFlow;Password=ProcureFlow",
    "Procurement": "Host=localhost;Port=5432;Database=ProcureFlow;Username=ProcureFlow;Password=ProcureFlow",
    "TradeFinance": "Host=localhost;Port=5432;Database=ProcureFlow;Username=ProcureFlow;Password=ProcureFlow",
    "Import": "Host=localhost;Port=5432;Database=ProcureFlow;Username=ProcureFlow;Password=ProcureFlow",
    "Inventory": "Host=localhost;Port=5432;Database=ProcureFlow;Username=ProcureFlow;Password=ProcureFlow",
    "Costing": "Host=localhost;Port=5432;Database=ProcureFlow;Username=ProcureFlow;Password=ProcureFlow",
    "Finance": "Host=localhost;Port=5432;Database=ProcureFlow;Username=ProcureFlow;Password=ProcureFlow",
    "Cache": "localhost:6379"
  },
  "Identity": {
    "AllowPasswordFlow": true,
    "UseDevelopmentCertificates": true,
    "Oidc": {
      "IssuerUrl": "",
      "ClientId": "",
      "Audience": "",
      "AppSlug": "",
      "MetadataAddress": "",
      "RequireHttpsMetadata": false,
      "ClockSkewSeconds": 60
    }
  },
  "MessageBus": {
    "UseKafka": false,
    "RabbitMq": {
      "HostName": "localhost",
      "Port": 5672,
      "UserName": "guest",
      "Password": "guest",
      "VirtualHost": "/",
      "ExchangeName": "procureflow.events",
      "QueueName": "procureflow-events",
      "ExchangeType": "topic",
      "Durable": true,
      "AutoDelete": false,
      "PrefetchCount": 10,
      "AutoAck": false,
      "ReconnectDelayMs": 5000,
      "DeadLetterExchange": "procureflow.events.dead",
      "MessageTtlMs": 60000
    },
    "Kafka": {
      "BootstrapServers": "localhost:9092",
      "GroupId": "procureflow-group",
      "TopicPrefix": "procureflow-",
      "SaslMechanism": "Plain",
      "SecurityProtocol": "Plaintext",
      "SaslUsername": "",
      "SaslPassword": "",
      "SslCaLocation": "",
      "AutoOffsetReset": "Earliest",
      "EnableAutoCommit": true,
      "AutoCommitIntervalMs": 5000,
      "MessageSendMaxRetries": 3,
      "Acks": "all"
    }
  },
  "Outbox": {
    "IntervalInSeconds": 30,
    "BatchSize": 100,
    "MaxRetries": 5,
    "InitialDelayInSeconds": 5,
    "EnableDeadLetterQueue": true
  },
  "Inbox": {
    "IntervalInSeconds": 30,
    "BatchSize": 100,
    "MaxRetries": 5,
    "InitialDelayInSeconds": 5,
    "EnableDeadLetterQueue": true
  },
  "Storage": {
    "Provider": "S3",
    "BasePath": "media",
    "BucketName": "procureflow-uploads",
    "Endpoint": "http://localhost:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "Region": "us-east-1"
  },
  "RateLimiting": {
    "Enabled": true,
    "PermitLimit": 100,
    "WindowSeconds": 60,
    "QueueLimit": 10,
    "Partition": "User",
    "RejectionStatusCode": 429
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:8000"
    ],
    "AllowedMethods": ["GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS"],
    "AllowedHeaders": ["Authorization", "Content-Type", "X-Requested-With", "X-Correlation-ID", "Idempotency-Key"],
    "ExposedHeaders": ["X-Correlation-ID", "Idempotency-Replayed"],
    "AllowCredentials": true,
    "PreflightMaxAgeSeconds": 3600
  },
  "SecurityHeaders": {
    "ContentTypeOptions": true,
    "FrameOptions": "DENY",
    "ReferrerPolicy": "strict-origin-when-cross-origin",
    "ContentSecurityPolicy": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' https:; frame-ancestors 'none'; base-uri 'self'; form-action 'self';",
    "PermissionsPolicy": "geolocation=(), microphone=(), camera=()",
    "EnableHsts": true,
    "HstsMaxAgeSeconds": 31536000,
    "HstsIncludeSubDomains": true,
    "RemoveServerHeader": true
  },
  "Correlation": {
    "HeaderName": "X-Correlation-ID",
    "IncludeInResponse": true,
    "UseTraceIdWhenMissing": true
  },
  "Idempotency": {
    "HeaderName": "Idempotency-Key",
    "Methods": ["POST", "PATCH"],
    "RequireKey": false,
    "ValidateRequestMatch": true,
    "MaxKeyLength": 128,
    "RetentionSeconds": 86400
  },
  "ApiVersioning": {
    "DefaultVersion": "1.0",
    "AssumeDefaultVersionWhenUnspecified": true,
    "ReportApiVersions": true,
    "ReadFromQueryString": true,
    "ReadFromHeader": true,
    "HeaderName": "X-Api-Version",
    "QueryStringParameter": "api-version",
    "ReadFromUrlSegment": true
  },
  "OpenApi": {
    "Title": "ProcureFlow API",
    "Version": "1.0",
    "Description": "Modular ERP system built with Modulus framework",
    "Contact": {
      "Name": "ProcureFlow Team",
      "Email": "support@procureflow.com"
    },
    "License": {
      "Name": "MIT",
      "Url": "https://opensource.org/licenses/MIT"
    }
  },
  "FeatureManagement": {
    "SampleFeature": false
  },
  "SecretsGuard": {
    "Enabled": true,
    "FailOnViolation": true,
    "Environments": ["Development", "Staging"],
    "SensitiveKeyPatterns": [
      ".*ApiKey.*",
      ".*Secret.*",
      ".*Password.*",
      ".*Token.*",
      ".*ConnectionString.*"
    ]
  },
  "PersonalDataProtection": {
    "Enabled": false,
    "Purpose": "ProcureFlow.Protection",
    "SearchHashKey": ""
  },
  "OpenTelemetry": {
    "Enabled": true,
    "ServiceName": "ProcureFlow.Api",
    "ServiceVersion": "1.0.0",
    "EnableConsoleExporter": false,
    "Otlp": {
      "Endpoint": "",
      "ExportTraces": true,
      "ExportMetrics": true
    }
  },
  "Sentry": {
    "Dsn": "",
    "SendDefaultPii": false,
    "TracesSampleRate": 0.0,
    "MaxBreadcrumbs": 200
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Modulus": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Modulus": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "WithOpenTelemetryTraceId",
      "WithOpenTelemetrySpanId"
    ],
    "Properties": {
      "Application": "ProcureFlow"
    }
  }
}