{
  "ConnectionStrings": {
    "VirtualFileExplorer": "Host=localhost;Port=5432;Database=ProcureFlow;Username=ProcureFlow;Password=ProcureFlow"
  },
  "VirtualFileExplorer": {
    "MaxFileSizeMB": 100,
    "AllowedExtensions": [".pdf", ".doc", ".docx", ".xls", ".xlsx", ".txt", ".jpg", ".jpeg", ".png", ".gif"],
    "EnableVersioning": true,
    "MaxVersions": 10,
    "CacheTtlSeconds": 1800
  },
  "Outbox": {
    "IntervalInSeconds": 30,
    "BatchSize": 100,
    "MaxRetries": 5,
    "InitialDelayInSeconds": 5,
    "EnableDeadLetterQueue": true
  },
  "Inbox": {
    "IntervalInSeconds": 30,
    "BatchSize": 100,
    "MaxRetries": 5,
    "InitialDelayInSeconds": 5,
    "EnableDeadLetterQueue": true
  }
}