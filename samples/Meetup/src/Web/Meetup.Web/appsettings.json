{
  "ConnectionStrings": {
    "Registrations": "Host=localhost;Port=5432;Database=meetup_registrations;Username=meetup;Password=meetup",
    "UserAccess": "Host=localhost;Port=5432;Database=meetup_useraccess;Username=meetup;Password=meetup",
    "Administration": "Host=localhost;Port=5432;Database=meetup_administration;Username=meetup;Password=meetup",
    "Payments": "Host=localhost;Port=5432;Database=meetup_payments;Username=meetup;Password=meetup",
    "Meetings": "Host=localhost;Port=5432;Database=meetup_meetings;Username=meetup;Password=meetup"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Correlation": {
    "HeaderName": "X-Correlation-ID",
    "IncludeInResponse": true,
    "UseTraceIdWhenMissing": true
  },
  "Idempotency": {
    "HeaderName": "Idempotency-Key",
    "Methods": [ "POST", "PATCH" ],
    "RequireKey": false,
    "ValidateRequestMatch": true,
    "RetentionSeconds": 86400
  },
  "OpenApi": {
    "Title": "Meetup API",
    "Version": "v1",
    "IncludeBearerSecurity": true
  },
  "Identity": {
    "ExternalProviders": {
      "Authentik": {
        "Authority": "http://localhost:9010",
        "ClientId": "meetup",
        "Scope": "openid profile email",
        "Audience": "meetup"
      }
    }
  },
  "SecurityHeaders": {
    "ContentTypeOptions": true,
    "FrameOptions": "DENY",
    "ReferrerPolicy": "strict-origin-when-cross-origin",
    "EnableHsts": true
  },
  "AllowedHosts": "*"
}
