@using Meetup.Modules.UserAccess.Application.Dtos
@model IReadOnlyList<UserDto>
@if (Model.Count == 0)
{
    @await Html.PartialAsync("_Alert", UiAlert.Info("No users yet — register one in Registrations first."))
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-vcenter card-table">
                <thead>
                    <tr>
                        <th>Login</th>
                        <th>Email</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th class="w-1"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Login</td>
                            <td>@item.Email</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-green-lt">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-red-lt">Inactive</span>
                                }
                            </td>
                            <td>@item.CreatedAt.ToString("u")</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <form method="post" asp-page-handler="Deactivate" asp-route-id="@item.Id"
                                          hx-post="@Url.Page("./Index", "Deactivate", new { id = item.Id })"
                                          hx-target="#user-table" hx-swap="innerHTML"
                                          hx-confirm="Deactivate '@item.Login'?">
                                        <button class="btn btn-sm btn-outline-danger" type="submit">Deactivate</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
