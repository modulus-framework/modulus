@model Meetup.Modules.Registrations.Web.Pages.Registrations.IndexModel
<div class="card mb-3">
    <div class="card-header">
        <h3 class="card-title">New registration</h3>
    </div>
    <div class="card-body">
        <form method="post" asp-page-handler="Create"
              hx-post="@Url.Page("./Index", "Create")"
              hx-target="#registration-table" hx-swap="innerHTML"
              hx-on::after-request="this.reset()">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label" asp-for="Input.Login">Login</label>
                    <input class="form-control" asp-for="Input.Login" placeholder="jdoe" />
                    <span class="invalid-feedback d-block" asp-validation-for="Input.Login"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label" asp-for="Input.Email">Email</label>
                    <input class="form-control" asp-for="Input.Email" type="email" placeholder="jdoe@example.com" />
                    <span class="invalid-feedback d-block" asp-validation-for="Input.Email"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label" asp-for="Input.Password">Password</label>
                    <input class="form-control" asp-for="Input.Password" type="password" />
                    <span class="invalid-feedback d-block" asp-validation-for="Input.Password"></span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label" asp-for="Input.FirstName">First name</label>
                    <input class="form-control" asp-for="Input.FirstName" />
                    <span class="invalid-feedback d-block" asp-validation-for="Input.FirstName"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label" asp-for="Input.LastName">Last name</label>
                    <input class="form-control" asp-for="Input.LastName" />
                    <span class="invalid-feedback d-block" asp-validation-for="Input.LastName"></span>
                </div>
            </div>
            <button class="btn btn-primary" type="submit">Register user</button>
        </form>
    </div>
</div>
