@using Meetup.Modules.Registrations.Application.Dtos
@model IReadOnlyList<UserRegistrationDto>
@if (Model.Count == 0)
{
    @await Html.PartialAsync("_Alert", UiAlert.Info("No registrations yet — register the first user above."))
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-vcenter card-table">
                <thead>
                    <tr>
                        <th>Login</th>
                        <th>Email</th>
                        <th>Name</th>
                        <th>Status</th>
                        <th>Registered</th>
                        <th class="w-1"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Login</td>
                            <td>@item.Email</td>
                            <td>@item.FirstName @item.LastName</td>
                            <td>
                                @if (item.ConfirmedAt is null)
                                {
                                    <span class="badge bg-yellow-lt">Pending</span>
                                }
                                else
                                {
                                    <span class="badge bg-green-lt">Confirmed</span>
                                }
                            </td>
                            <td>@item.RegisteredAt.ToString("u")</td>
                            <td>
                                @if (item.ConfirmedAt is null)
                                {
                                    <form method="post" asp-page-handler="Confirm" asp-route-id="@item.Id"
                                          hx-post="@Url.Page("./Index", "Confirm", new { id = item.Id })"
                                          hx-target="#registration-table" hx-swap="innerHTML">
                                        <button class="btn btn-sm btn-outline-primary" type="submit">Confirm</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
