@model Meetup.Modules.Payments.Web.Pages.Payments.IndexModel
<div class="card mb-3">
    <div class="card-header">
        <h3 class="card-title">New subscription</h3>
    </div>
    <div class="card-body">
        <form method="post" asp-page-handler="Create"
              hx-post="@Url.Page("./Index", "Create")"
              hx-target="#subscription-table" hx-swap="innerHTML"
              hx-on::after-request="this.reset()">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label" asp-for="Input.PayerLogin">Payer login</label>
                    <input class="form-control" asp-for="Input.PayerLogin" placeholder="jdoe" />
                    <span class="invalid-feedback d-block" asp-validation-for="Input.PayerLogin"></span>
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label" asp-for="Input.Price">Price</label>
                    <input class="form-control" asp-for="Input.Price" type="number" min="0" step="0.01" />
                    <span class="invalid-feedback d-block" asp-validation-for="Input.Price"></span>
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label" asp-for="Input.Currency">Currency</label>
                    <input class="form-control" asp-for="Input.Currency" maxlength="3" />
                    <span class="invalid-feedback d-block" asp-validation-for="Input.Currency"></span>
                </div>
            </div>
            <button class="btn btn-primary" type="submit">Buy subscription</button>
        </form>
    </div>
</div>
