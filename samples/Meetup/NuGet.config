<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!--
      Cobytelabs.Modulus.* packages are resolved from a sample-local feed.
      Populate it from the framework repo root:
        dotnet pack modulus.slnx -c Release -o samples/Meetup/nupkg
      After the framework is published to nuget.org, remove this source.
    -->
    <add key="modulus-local" value="nupkg" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" exclude="Cobytelabs.*" />
    </packageSource>
    <packageSource key="modulus-local">
      <package pattern="Cobytelabs.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
