<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework />
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- New package: nothing of this ID is on nuget.org yet, so there is no baseline to validate against. Remove this line after its first release. -->
    <EnablePackageValidation>false</EnablePackageValidation>
    <Description>OpenMetadata publisher for the Modulus Analytics Integration Layer: registers each dataset version as a table, with its columns, types, nullability and classification, in the OpenMetadata catalog (Apache-2.0, Linux Foundation AI and Data). Catalogs search and lineage for the warehouse.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Modulus.Analytics/Modulus.Analytics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Modulus.Analytics.OpenMetadata.Tests" />
  </ItemGroup>

</Project>
