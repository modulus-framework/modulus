<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- New package: nothing of this ID is on nuget.org yet, so there is no baseline to validate against. Remove this line after its first release. -->
    <EnablePackageValidation>false</EnablePackageValidation>
    <Description>EF Core durable delivery and backfill for Modulus analytics.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Modulus.Analytics/Modulus.Analytics.csproj" />
    <ProjectReference Include="../../data/Modulus.Data.Abstractions/Modulus.Data.Abstractions.csproj" />
    <ProjectReference Include="../../platform/Modulus.Platform/Modulus.Platform.csproj" />
    <ProjectReference Include="../../platform/Modulus.Tenancy.Lifecycle/Modulus.Tenancy.Lifecycle.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Modulus.Analytics.EntityFrameworkCore.Tests" />
    <InternalsVisibleTo Include="Modulus.Analytics.EntityFrameworkCore.Integration.Tests" />
  </ItemGroup>

</Project>
