<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework />
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- New package: nothing of this ID is on nuget.org yet, so there is no baseline to validate against. Remove this line after its first release. -->
    <EnablePackageValidation>false</EnablePackageValidation>
    <Description>Apicurio Registry publisher for the Modulus Analytics Integration Layer: publishes each dataset version's JSON Schema as a versioned artifact (Apache-2.0 registry, Red Hat sponsored), so producers and consumers of the lake read the same contract.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Modulus.Analytics/Modulus.Analytics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Modulus.Analytics.Apicurio.Tests" />
  </ItemGroup>

</Project>
