<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>EF Core data access for the Modulus AI connector: the ai_changes journal written in the same transaction as the indexed entities, the change feed and entity source behind /extract, /changes and the generated Search and Calculate capabilities, and the entity change-history capability.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Modulus.AI.Connector/Modulus.AI.Connector.csproj" />
    <ProjectReference Include="../../data/Modulus.EntityFrameworkCore/Modulus.EntityFrameworkCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Modulus.AI.Connector.EntityFrameworkCore.Tests" />
    <InternalsVisibleTo Include="Modulus.EFCore.Integration.Tests" />
  </ItemGroup>

</Project>
