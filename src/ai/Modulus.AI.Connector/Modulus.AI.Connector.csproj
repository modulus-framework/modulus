<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Hosts an AI platform's read-only connector for a Modulus app.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../../core/Modulus.Core/Modulus.Core.csproj" />
    <ProjectReference Include="../../messaging/Modulus.Mediator/Modulus.Mediator.csproj" />
    <ProjectReference Include="../../platform/Modulus.Platform/Modulus.Platform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Modulus.AI.Connector.Tests" />
    <InternalsVisibleTo Include="Modulus.AI.Connector.EntityFrameworkCore" />
    <InternalsVisibleTo Include="Modulus.AI.Connector.Testing" />
  </ItemGroup>

</Project>
