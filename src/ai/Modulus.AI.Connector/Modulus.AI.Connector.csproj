<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Hosts an AI platform's connector wire contract (v1) inside a Modulus app: opt-in read-only capabilities from mediator queries, a manifest with classified fields, record lookups, authorization checks, API-key plus signed-envelope authentication that runs every call as the asserted user, and revocation signals when access changes. No LLM code and no dependency on the platform's packages.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../../core/Modulus.Core/Modulus.Core.csproj" />
    <ProjectReference Include="../../messaging/Modulus.Mediator/Modulus.Mediator.csproj" />
    <ProjectReference Include="../../platform/Modulus.Platform/Modulus.Platform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Modulus.AI.Connector.Tests" />
    <InternalsVisibleTo Include="Modulus.AI.Connector.EntityFrameworkCore" />
  </ItemGroup>

</Project>
