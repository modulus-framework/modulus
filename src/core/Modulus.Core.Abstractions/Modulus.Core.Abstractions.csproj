<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Modulus.Core.Abstractions</PackageId>
    <Version>0.1.0</Version>
    <Authors>Modulus Team</Authors>
    <Description>
      Contracts-only package for the Modulus framework.
      Contains IModule, AggregateRoot, entity interfaces, cross-cutting
      user/tenant/permission/health contracts, and base types.
      Only depends on Microsoft.Extensions.* abstractions.
    </Description>
    <PackageTags>modulus;modular-monolith;cqrs</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft.Extensions.* abstractions provided globally via Directory.Build.props -->
  </ItemGroup>
</Project>
