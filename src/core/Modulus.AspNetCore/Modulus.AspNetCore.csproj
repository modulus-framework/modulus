<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>ASP.NET Core integration for Modulus: middleware pipeline, API versioning, health checks, CORS, security headers, OpenAPI, idempotency, feature flags, and rate limiting.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Modulus.AspNetCore.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../Modulus.Core/Modulus.Core.csproj" />
    <PackageReference Include="ErrorOr" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Asp.Versioning.Mvc" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" />
    <PackageReference Include="Microsoft.FeatureManagement.AspNetCore" />
    <!-- .NET 10: built-in OpenApi with IOpenApiDocumentTransformer -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="Microsoft.OpenApi" Condition="'$(TargetFramework)' == 'net10.0'" />
    <!-- .NET 8: Swashbuckle (no built-in OpenApi transformer support) -->
    <PackageReference Include="Swashbuckle.AspNetCore" Condition="'$(TargetFramework)' == 'net8.0'" />
  </ItemGroup>

</Project>
