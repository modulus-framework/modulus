<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>ASP.NET Core integration for Modulus.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Modulus.AspNetCore.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../Modulus.Core/Modulus.Core.csproj" />
    <PackageReference Include="ErrorOr" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Asp.Versioning.Mvc" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <PackageReference Include="Microsoft.FeatureManagement.AspNetCore" />
    <PackageReference Include="Microsoft.Extensions.Compliance.Redaction" />
    <PackageReference Include="Microsoft.Extensions.Telemetry" />
    <!-- Built-in OpenApi with IOpenApiDocumentTransformer -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.OpenApi" />
  </ItemGroup>

  <!-- The analyzer's build output: bin/<Configuration>/netstandard2.0, or with ArtifactsPath bin/<project>/<configuration>. -->
  <PropertyGroup>
    <ModulusAnalyzerDll Condition="'$(ArtifactsPath)' == ''">$(MSBuildThisFileDirectory)../../analyzers/Modulus.Analyzers/bin/$(Configuration)/netstandard2.0/Modulus.Analyzers.dll</ModulusAnalyzerDll>
    <ModulusAnalyzerDll Condition="'$(ArtifactsPath)' != ''">$(ArtifactsPath)/bin/Modulus.Analyzers/$(Configuration.ToLowerInvariant())/Modulus.Analyzers.dll</ModulusAnalyzerDll>
  </PropertyGroup>

  <!-- MOD0001 ships inside this package: every app that maps Modulus endpoints gets it, no extra reference. -->
  <ItemGroup>
    <ProjectReference Include="../../analyzers/Modulus.Analyzers/Modulus.Analyzers.csproj"
                      ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="$(ModulusAnalyzerDll)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="build/Synvro.Modulus.AspNetCore.props" Pack="true" PackagePath="build/" Visible="false" />
  </ItemGroup>



</Project>
