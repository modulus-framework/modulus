<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework />
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Core abstractions and utilities for the Modulus framework: module system, domain events, multi-tenancy, storage and data protection abstractions.</Description>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <!-- The data-classification base type: the logging source generator recognises a classification only by it, and
         domain entities (which reference Core only) must be able to carry one. DI.Abstractions + ObjectPool only. -->
    <PackageReference Include="Microsoft.Extensions.Compliance.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Modulus.Core.Tests" />
  </ItemGroup>

</Project>
