<Project>

  <!-- ════════════════════════════════════════════════════════════════
       src/Directory.Build.props

       Chains to the root Directory.Build.props (which imports
       build/Modulus.Common.props and build/Modulus.Packaging.props),
       then marks every src/ project as a packable framework library and
       wires in build/Modulus.PublicApi.props (PublicAPI.Shipped/Unshipped
       tracking). Test projects override <IsPackable> via
       tests/Directory.Build.props and do not import PublicApi.props.
       ════════════════════════════════════════════════════════════════ -->

  <Import Project="$(MSBuildThisFileDirectory)..\Directory.Build.props" />
  <Import Project="$(MSBuildThisFileDirectory)..\build\Modulus.PublicApi.props" />

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <IsPackFrameworkLibrary>true</IsPackFrameworkLibrary>
    <!-- CS0436: a friend assembly (InternalsVisibleTo) carries its own internal copy of the build/Polyfills; the local one wins. -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>

</Project>
