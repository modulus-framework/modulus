<Project>

  <!-- Chain to the root Directory.Build.props.
       MSBuild stops searching when it finds the nearest file, so an
       explicit import is required to inherit the global settings. -->
  <Import Project="$(MSBuildThisFileDirectory)..\Directory.Build.props" />

  <!-- ──────────────────────────────
       NuGet packing — every src/ project is a framework package.
       Individual projects can override with <IsPackable>false</IsPackable>.
       ────────────────────────────── -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <IsPackFrameworkLibrary>true</IsPackFrameworkLibrary>
  </PropertyGroup>

  <!-- Source Link — enables source debugging from NuGet symbol packages -->
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

  <!-- Include the framework README and icon in every package -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)..\README.md"
          Pack="true"
          PackagePath="\"
          Condition="Exists('$(MSBuildThisFileDirectory)..\README.md')" />
  </ItemGroup>

</Project>
