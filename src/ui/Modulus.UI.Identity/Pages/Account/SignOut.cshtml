@page
@model Modulus.UI.Identity.Pages.Account.SignOutModel
@{
    ViewData["Title"] = await Model.TextAsync("SignOut.Title");
}
<div class="container-tight px-0 my-4">
    <div class="card">
        <div class="card-body text-center">
            <h2 class="card-title mb-4">@await Model.TextAsync("SignOut.Title")</h2>
            <p class="text-secondary">@await Model.TextAsync("SignOut.Prompt")</p>
            <form method="post">
                <button type="submit" class="btn btn-danger w-100 mb-2">@await Model.TextAsync("SignOut.Submit")</button>
                <a href="~/" class="btn btn-ghost-secondary w-100">@await Model.TextAsync("SignOut.Cancel")</a>
            </form>
        </div>
    </div>
</div>
