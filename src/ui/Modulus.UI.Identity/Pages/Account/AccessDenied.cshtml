@page
@model Modulus.UI.Identity.Pages.Account.AccessDeniedModel
@{
    ViewData["Title"] = await Model.TextAsync("AccessDenied.Title");
}
<div class="container-tight px-0 my-4">
    <div class="card card-body text-center">
        <h2 class="card-title mb-4">@await Model.TextAsync("AccessDenied.Title")</h2>
        <p class="text-secondary">@await Model.TextAsync("AccessDenied.Message")</p>
        <a href="~/" class="btn btn-primary w-100">Home</a>
    </div>
</div>
