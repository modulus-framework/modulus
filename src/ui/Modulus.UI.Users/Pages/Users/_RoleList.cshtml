@model Modulus.UI.Users.Pages.Users.DetailsModel
@* Roles region. Role mutations re-render this region in place; failures
   surface through the summary (ModelState rides the fragment). *@
@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger mb-3" role="alert">
        <div asp-validation-summary="All"></div>
    </div>
}
<div class="card">
    <div class="card-header">
        <h3 class="card-title">@await Model.TextAsync("Details.Roles")</h3>
    </div>
    <div class="card-body">
        @if (Model.AssignedRoles.Count == 0)
        {
            <div class="text-secondary">@await Model.TextAsync("Details.NoRoles")</div>
        }
        else
        {
            <ul class="list-group list-group-flush mb-3">
                @foreach (var role in Model.AssignedRoles)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <code>@role</code>
                        <form method="post"
                              asp-page-handler="RemoveRole" asp-route-roleName="@role"
                              hx-post="@Url.Page("./Details", "RemoveRole", new { id = Model.Account?.Id, roleName = role })"
                              hx-target="#role-list" hx-swap="innerHTML"
                              hx-confirm="@await Model.TextAsync("Details.ConfirmRemove")">
                            <button class="btn btn-sm btn-ghost-danger" type="submit">@await Model.TextAsync("Details.Remove")</button>
                        </form>
                    </li>
                }
            </ul>
        }
        <form method="post"
              asp-page-handler="AddRole"
              hx-post="@Url.Page("./Details", "AddRole", new { id = Model.Account?.Id })"
              hx-target="#role-list" hx-swap="innerHTML">
            <div class="row g-2">
                <div class="col">
                    <label class="form-label" for="roleName">@await Model.TextAsync("Details.RoleName")</label>
                    <input class="form-control" id="roleName" name="roleName" list="role-options" />
                    <datalist id="role-options">
                        @foreach (var available in Model.AvailableRoles)
                        {
                            <option value="@available"></option>
                        }
                    </datalist>
                </div>
                <div class="col-auto align-self-end">
                    <button class="btn btn-primary" type="submit">@await Model.TextAsync("Details.AddRole")</button>
                </div>
            </div>
        </form>
    </div>
</div>
