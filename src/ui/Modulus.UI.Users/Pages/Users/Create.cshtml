@page
@model Modulus.UI.Users.Pages.Users.CreateModel
@{
    ViewData["Title"] = await Model.TextAsync("Create.Title");
}
<m-page-header title="@ViewData["Title"]">
    <a class="btn" asp-page="./Index">&larr;</a>
</m-page-header>
<div class="card">
    <div class="card-body">
        <form method="post">
            <div class="mb-3">
                <label class="form-label" asp-for="Input.UserName">@await Model.TextAsync("Create.UserName")</label>
                <input class="form-control" asp-for="Input.UserName" />
                <span class="invalid-feedback d-block" asp-validation-for="Input.UserName"></span>
            </div>
            <div class="mb-3">
                <label class="form-label" asp-for="Input.Email">@await Model.TextAsync("Create.Email")</label>
                <input class="form-control" asp-for="Input.Email" type="email" />
                <span class="invalid-feedback d-block" asp-validation-for="Input.Email"></span>
            </div>
            <div class="mb-3">
                <label class="form-label" asp-for="Input.Password">@await Model.TextAsync("Create.Password")</label>
                <input class="form-control" asp-for="Input.Password" type="password" />
                <span class="invalid-feedback d-block" asp-validation-for="Input.Password"></span>
            </div>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <button class="btn btn-primary" type="submit">@await Model.TextAsync("Create.Submit")</button>
        </form>
    </div>
</div>
