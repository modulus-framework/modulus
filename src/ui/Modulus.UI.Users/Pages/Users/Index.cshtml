@page
@model Modulus.UI.Users.Pages.Users.IndexModel
@{
    ViewData["Title"] = await Model.TextAsync("Users.Title");
    ViewData.SetPageId("Users.Directory");
}
<m-page-header title="@ViewData["Title"]" page-id="Users.Directory">
    <a class="btn btn-primary" asp-page="./Create">@await Model.TextAsync("Users.Create")</a>
</m-page-header>
<m-datatable empty="@(Model.Rows.Count == 0)" empty-message="@await Model.TextAsync("Users.Empty")">
    <m-column>@await Model.TextAsync("Users.UserName")</m-column>
    <m-column>@await Model.TextAsync("Users.Email")</m-column>
    <m-column>@await Model.TextAsync("Users.Active")</m-column>
    <m-column>@await Model.TextAsync("Users.LockedOut")</m-column>
    @foreach (var row in Model.Rows)
    {
        <tr>
            <td><a asp-page="./Details" asp-route-id="@row.User.Id">@(row.User.UserName ?? row.User.Email ?? row.User.Id.ToString())</a></td>
            <td class="text-secondary">@(row.User.Email ?? "—")</td>
            <td><span class="badge bg-@(row.User.IsActive ? "green" : "red")">@row.User.IsActive</span></td>
            <td><span class="badge bg-@(row.LockedOut ? "red" : "green")">@row.LockedOut</span></td>
        </tr>
    }
</m-datatable>
