@page
@model Modulus.UI.Files.Pages.Files.IndexModel
@{
    ViewData["Title"] = await Model.TextAsync("Index.Title");
}
<m-page-header title="@ViewData["Title"]" />
<div class="card mb-3">
    <div class="card-body">
        <form method="get">
            <div class="mb-3">
                <label class="form-label" asp-for="Path">@await Model.TextAsync("Index.Path")</label>
                <input class="form-control" asp-for="Path" placeholder="invoices/2026/001.pdf" />
                <div class="form-hint">@await Model.TextAsync("Index.PathHint")</div>
                <span class="invalid-feedback d-block" asp-validation-for="Path"></span>
            </div>
            <button class="btn" type="submit">@await Model.TextAsync("Index.Lookup")</button>
        </form>
    </div>
</div>
<div id="file-result">
    @if (!string.IsNullOrWhiteSpace(Model.Path) && Model.ModelState.IsValid)
    {
        @await Html.PartialAsync("_FileResult", Model.ResultView())
    }
</div>
<div class="card">
    <div class="card-header">
        <h3 class="card-title">@await Model.TextAsync("Index.Upload")</h3>
    </div>
    <div class="card-body">
        <m-form handler="Upload" target="#file-result" multipart="true" summary="false">
            <input type="hidden" asp-for="Path" />
            <m-file name="file" label="@await Model.TextAsync("Index.UploadFile")" hint="@await Model.TextAsync("Index.UploadHint")" />
            <button class="btn btn-primary" type="submit">@await Model.TextAsync("Index.Upload")</button>
        </m-form>
    </div>
</div>
