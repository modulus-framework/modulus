@page
@model Modulus.UI.AuditLogging.Pages.AuditLogs.IndexModel
@{
    ViewData["Title"] = await Model.TextAsync("Index.Title");
    ViewData.SetPageId("AuditLogging.Browser");
}
<m-page-header title="@ViewData["Title"]" page-id="AuditLogging.Browser" />
<div class="card mb-3">
    <div class="card-body">
        <form method="get">
            <div class="row g-2">
                <div class="col-md-3">
                    <label class="form-label" asp-for="Action">@await Model.TextAsync("Index.Action")</label>
                    <input class="form-control" asp-for="Action" />
                </div>
                <div class="col-md-3">
                    <label class="form-label" asp-for="Resource">@await Model.TextAsync("Index.Resource")</label>
                    <input class="form-control" asp-for="Resource" />
                </div>
                <div class="col-md-2">
                    <label class="form-label" asp-for="UserId">@await Model.TextAsync("Index.UserId")</label>
                    <input class="form-control" asp-for="UserId" />
                </div>
                <div class="col-md-2">
                    <label class="form-label" asp-for="From">@await Model.TextAsync("Index.From")</label>
                    <input class="form-control" asp-for="From" type="datetime-local" />
                </div>
                <div class="col-md-2">
                    <label class="form-label" asp-for="To">@await Model.TextAsync("Index.To")</label>
                    <input class="form-control" asp-for="To" type="datetime-local" />
                </div>
            </div>
            <span class="invalid-feedback d-block" asp-validation-for="UserId"></span>
            <button class="btn btn-primary mt-2" type="submit">@await Model.TextAsync("Index.Filter")</button>
        </form>
    </div>
</div>
@* The pager rebuilds its links from the current query string, so the filters above survive paging. *@
<m-datatable empty="@(Model.Result.Items.Count == 0)" empty-message="@await Model.TextAsync("Index.Empty")"
             page="@Model.Result.Page" has-previous="@Model.Result.HasPreviousPage" has-next="@Model.Result.HasNextPage">
    <m-column>@await Model.TextAsync("Index.When")</m-column>
    <m-column>@await Model.TextAsync("Index.Action")</m-column>
    <m-column>@await Model.TextAsync("Index.Resource")</m-column>
    <m-column>@await Model.TextAsync("Index.User")</m-column>
    <m-column>@await Model.TextAsync("Index.Detail")</m-column>
    @foreach (var entry in Model.Result.Items)
    {
        <tr>
            <td class="text-secondary">@entry.OccurredAt.ToString("u")</td>
            <td><a asp-page="./Details" asp-route-id="@entry.Id"><code>@entry.Action</code></a></td>
            <td>@(entry.Resource ?? "—")</td>
            <td><code>@(entry.UserId?.ToString() ?? "—")</code></td>
            <td class="text-secondary">@(entry.Detail ?? "—")</td>
        </tr>
    }
</m-datatable>
