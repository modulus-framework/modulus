@page
@model Modulus.UI.Permissions.Pages.Permissions.IndexModel
@{
    ViewData["Title"] = await Model.TextAsync("Catalog.Title");
}
<m-page-header title="@ViewData["Title"]" />
@if (Model.Groups.Count == 0)
{
    @await Html.PartialAsync("_Alert", UiAlert.Info(await Model.TextAsync("Catalog.Empty")))
}
else
{
    @foreach (var group in Model.Groups)
    {
        <div class="card mb-3">
            <div class="card-header">
                <h3 class="card-title">@group.Module</h3>
            </div>
            <div class="table-responsive">
                <table class="table table-vcenter card-table">
                    <thead>
                        <tr>
                            <th>Permission</th>
                            <th>@await Model.TextAsync("Catalog.Description")</th>
                            <th>@await Model.TextAsync("Catalog.Requires")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var permission in group.Permissions)
                        {
                            <tr>
                                <td><code>@permission.Permission</code></td>
                                <td>@permission.Description</td>
                                <td>
                                    @foreach (var required in permission.Requires)
                                    {
                                        <span class="badge bg-secondary-lt me-1">@required</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}
