    <Description>Entity Framework Core repository for Modulus.Messaging sagas: instances are stored with optimistic concurrency on a version column.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Modulus.Messaging.Sagas/Modulus.Messaging.Sagas.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>

</Project>
