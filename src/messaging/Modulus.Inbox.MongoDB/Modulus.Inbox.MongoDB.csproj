<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>MongoDB inbox store for Modulus idempotent integration-event consumption, sharing the decorator pipeline with the EF Core inbox.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Modulus.Inbox/Modulus.Inbox.csproj" />
    <ProjectReference Include="../../data/Modulus.Data.MongoDB/Modulus.Data.MongoDB.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- MongoInboxStore and InboxIndexInitializer are internal; the test
         project constructs both directly against a real Testcontainers
         Mongo, mirroring Modulus.Inbox's InternalsVisibleTo for EfInboxStore. -->
    <InternalsVisibleTo Include="Modulus.Inbox.MongoDB.Tests" />
  </ItemGroup>

</Project>
