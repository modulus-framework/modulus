<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework />
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- New package: nothing of this ID is on nuget.org yet, so there is no baseline to validate against. Remove this line after its first release. -->
    <EnablePackageValidation>false</EnablePackageValidation>
    <Description>Idempotent inbox for Modulus.Messaging on Entity Framework Core: each consume attempt runs in one transaction with its inbox record, so a message is applied at most once per consumer within the detection window (RULE-04, RULE-06).</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Modulus.Messaging/Modulus.Messaging.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Modulus.Messaging.Inbox.EntityFrameworkCore.Tests" />
  </ItemGroup>

</Project>
