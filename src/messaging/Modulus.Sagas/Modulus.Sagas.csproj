<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Rebus-based saga/process-manager orchestration for Modulus: Polly resilience, ambient context propagation, IIntegrationEventHandler bridging, and module-bus routing.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Rebus" />
    <PackageReference Include="Rebus.ServiceProvider" />
    <PackageReference Include="Rebus.Microsoft.Extensions.Logging" />
    <PackageReference Include="Polly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Modulus.Events/Modulus.Events.csproj" />
    <ProjectReference Include="../Modulus.Outbox.Abstractions/Modulus.Outbox.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Modulus.Sagas.Tests" />
  </ItemGroup>

</Project>
