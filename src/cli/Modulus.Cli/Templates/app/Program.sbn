using {{ root_namespace }}.Host.Infrastructure;
using {{ root_namespace }}.Host.Modules;
{{ if !no_example }}using {{ root_namespace }}.Modules.Products;
{{ end }}using Modulus.AspNetCore.Extensions;
using Modulus.Mediator.Extensions;
using Microsoft.EntityFrameworkCore;
using Microsoft.Extensions.DependencyInjection;

var builder = WebApplication.CreateBuilder(args);

// ── Modulus Framework ──────────────────────────────────────────
builder.Services.AddModulus<{{ app_name }}HostModule>(builder.Configuration);
builder.Services.AddModulusExceptionHandling();

// ── CQRS / Mediator ────────────────────────────────────────────
builder.Services.AddMediator(opts =>
{
{{ if !no_example }}    opts.RegisterServicesFromAssembly(typeof(ProductsModule).Assembly);
{{ end }}});

// ── Database ───────────────────────────────────────────────────
builder.Services.AddDbContext<AppDbContext>(options =>
    options.{{ use_db_method }}(builder.Configuration.GetConnectionString("Default")
        ?? throw new InvalidOperationException("Connection string 'Default' not found.")));
builder.Services.AddScoped<DbContext>(sp => sp.GetRequiredService<AppDbContext>());

// ── OpenAPI ────────────────────────────────────────────────────
builder.Services.AddOpenApi();

var app = builder.Build();

// ── Middleware ─────────────────────────────────────────────────
app.UseExceptionHandler();
app.UseModulus();

if (app.Environment.IsDevelopment())
{
    app.MapOpenApi();
}

app.Run();
