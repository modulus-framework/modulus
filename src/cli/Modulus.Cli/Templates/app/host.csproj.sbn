<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Modulus.AspNetCore" Version="1.0.0" />
    <PackageReference Include="Modulus.Core" Version="1.0.0" />
    <PackageReference Include="Modulus.Mediator" Version="1.0.0" />
    <PackageReference Include="Modulus.EntityFrameworkCore" Version="1.0.0" />
    <PackageReference Include="{{ ef_provider_package }}" Version="{{ ef_provider_version }}" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  {{ if !no_example }}
  <ItemGroup>
    <ProjectReference Include="../{{ root_namespace }}.Modules.Products/{{ root_namespace }}.Modules.Products.csproj" />
  </ItemGroup>
  {{ end }}

</Project>
