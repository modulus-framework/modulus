<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Integration-test harness for Modulus applications: a WebApplicationFactory that boots the fully composed host and swaps every module DbContext to an isolated in-memory SQLite database, plus authenticated test clients.</Description>
    <!-- Local override of the repo-wide 1.2.0: the SQLite swap silently dropped
         IDbContextFactory registrations (factory-only contexts such as
         AddEfCoreAuthorizationStores became unresolvable in tests), and the
         keep-alive/EnsureCreated pass ran after hosted services started
         (startup seeders saw empty databases). Both properties must be set:
         build/Modulus.Packaging.props assigns PackageVersion before this
         project body is evaluated. -->
    <Version>1.2.3</Version>
    <PackageVersion>1.2.3</PackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- The DbContext-swap reflection is internal; its unit tests reach it here. -->
    <InternalsVisibleTo Include="Modulus.Testing.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\core\Modulus.Core\Modulus.Core.csproj" />
    <ProjectReference Include="..\..\core\Modulus.AspNetCore\Modulus.AspNetCore.csproj" />
    <ProjectReference Include="..\..\messaging\Modulus.Events\Modulus.Events.csproj" />
    <ProjectReference Include="..\..\data\Modulus.Data.Abstractions\Modulus.Data.Abstractions.csproj" />
    <ProjectReference Include="..\..\data\Modulus.EntityFrameworkCore\Modulus.EntityFrameworkCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
  </ItemGroup>

</Project>
