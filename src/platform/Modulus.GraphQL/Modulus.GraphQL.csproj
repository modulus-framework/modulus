<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>GraphQL for Modulus (GraphQL.NET, MIT): one schema that every module contributes fields to, resolvers through the mediator, permission policies per field, domain exceptions mapped to GraphQL error codes, depth and complexity limits, DataLoader batching, and introspection off unless enabled.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../../core/Modulus.Core/Modulus.Core.csproj" />
    <ProjectReference Include="../../messaging/Modulus.Mediator/Modulus.Mediator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="GraphQL" />
    <PackageReference Include="GraphQL.SystemTextJson" />
    <PackageReference Include="GraphQL.DataLoader" />
    <PackageReference Include="GraphQL.MicrosoftDI" />
    <PackageReference Include="GraphQL.Server.Transports.AspNetCore" />
    <PackageReference Include="GraphQL.Server.Ui.GraphiQL" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Modulus.GraphQL.Tests" />
  </ItemGroup>

</Project>
