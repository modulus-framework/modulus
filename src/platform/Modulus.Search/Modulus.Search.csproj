<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- First release: there is no published baseline to compare with yet (see build/Modulus.Packaging.props). Remove this line
         once the package is on nuget.org, so later breaking changes are caught. -->
    <EnablePackageValidation>false</EnablePackageValidation>
    <Description>Full-text search for Modulus (OpenSearch and Solr).</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Modulus.Search.Tests" />
  </ItemGroup>

</Project>
