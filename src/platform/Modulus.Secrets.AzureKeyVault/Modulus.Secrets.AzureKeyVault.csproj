<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework />
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- First release: there is no published baseline to compare with yet (see build/Modulus.Packaging.props). Remove this line
         once the package is on nuget.org, so later breaking changes are caught. -->
    <EnablePackageValidation>false</EnablePackageValidation>
    <Description>Azure Key Vault secret provider for Modulus: reads secrets through the Azure SDK with DefaultAzureCredential (managed identity, workload identity, developer login), cached and stale-bounded like every other provider. Read path only; opt-in.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Modulus.Platform/Modulus.Platform.csproj" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" />
    <PackageReference Include="Azure.Identity" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Modulus.Secrets.AzureKeyVault.Tests" />
  </ItemGroup>

</Project>
