<Project>

  <!-- ════════════════════════════════════════════════════════════════
       tests/Directory.Build.props

       Chains to the root Directory.Build.props, then applies
       test-specific overrides (non-packable, test SDK, xUnit, …).
       ════════════════════════════════════════════════════════════════ -->

  <Import Project="$(MSBuildThisFileDirectory)..\Directory.Build.props" />
  <Import Project="$(MSBuildThisFileDirectory)..\build\Modulus.Test.props" />

</Project>
